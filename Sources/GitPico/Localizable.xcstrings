          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un URL per riga. Senza URL di push, Git usa l'URL di fetch. Le mappature di fetch esistenti e le altre impostazioni del remoto vengono mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 行に 1 つの URL を入力します。プッシュ URL がない場合、Git はフェッチ URL を使用します。既存のフェッチのマッピングとその他のリモート設定は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
