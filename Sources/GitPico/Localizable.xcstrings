    "A recovery backup is saved before writing. New external edits block restoration." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ نسخة استرداد قبل الكتابة. تمنع التعديلات الخارجية الجديدة الاستعادة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es desa una còpia de seguretat de recuperació abans d'escriure. Els nous canvis externs impedeixen la restauració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před zápisem se uloží záloha pro obnovení. Nové externí úpravy zabrání obnově."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gemmes en sikkerhedskopi til gendannelse før skrivning. Nye eksterne ændringer blokerer gendannelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor dem Schreiben wird ein Wiederherstellungs-Backup gesichert. Neue externe Änderungen blockieren die Wiederherstellung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πριν από την εγγραφή αποθηκεύεται ένα αντίγραφο ασφαλείας ανάκτησης. Νέες εξωτερικές αλλαγές εμποδίζουν την επαναφορά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda una copia de seguridad de recuperación antes de escribir. Las nuevas ediciones externas impiden la restauración."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda un respaldo de recuperación antes de escribir. Las nuevas ediciones externas impiden la restauración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautusvarmuuskopio tallennetaan ennen kirjoittamista. Uudet ulkoiset muokkaukset estävät palautuksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sauvegarde de récupération est enregistrée avant l’écriture. Toute nouvelle modification externe bloque la restauration."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sauvegarde de récupération est enregistrée avant l’écriture. Toute nouvelle modification externe bloque la restauration."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גיבוי לשחזור נשמר לפני הכתיבה. עריכות חיצוניות חדשות חוסמות שחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिखने से पहले रिकवरी बैकअप सहेजा जाता है। नए बाहरी संपादन होने पर बहाली रोक दी जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prije pisanja sprema se sigurnosna kopija za oporavak. Nove vanjske izmjene blokiraju obnovu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írás előtt helyreállítási biztonsági mentés készül. Az új külső módosítások megakadályozzák a visszaállítást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
