            "value" : "أودع كل الملفات المحلية وغير المتتبعة والمتجاهلة أو انقلها جانبًا قبل تغيير شجرة العمل هذه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
