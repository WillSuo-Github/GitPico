    "Stored in .git/info/exclude; affects only this working directory and is never committed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزن في .git/info/exclude؛ وتؤثر على مجلد العمل هذا فقط ولا تُودع أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es desa a .git/info/exclude; només afecta aquest directori de treball i mai no s'inclou en un commit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloženo v .git/info/exclude; ovlivňuje pouze tento pracovní adresář a nikdy se nezahrne do commitu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemmes i .git/info/exclude; påvirker kun denne arbejdsmappe og medtages aldrig i et commit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In .git/info/exclude gespeichert; betrifft nur dieses Arbeitsverzeichnis und wird nie committet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύεται στο .git/info/exclude· επηρεάζει μόνο αυτόν τον κατάλογο εργασίας και δεν υποβάλλεται ποτέ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda en .git/info/exclude; solo afecta a este directorio de trabajo y nunca se incluye en un commit."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda en .git/info/exclude; solo afecta a este directorio de trabajo y nunca se incluye en un commit."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennetaan tiedostoon .git/info/exclude; vaikuttaa vain tähän työhakemistoon eikä sisälly koskaan tallennukseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocké dans .git/info/exclude ; s’applique uniquement à ce dossier de travail et n’est jamais validé."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocké dans .git/info/exclude; s’applique uniquement à ce dossier de travail et n’est jamais validé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נשמר ב־.git/info/exclude; משפיע רק על תיקיית עבודה זו ולעולם אינו נכלל בקומיט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".git/info/exclude में सहेजा जाता है; केवल इस वर्किंग डायरेक्टरी पर असर डालता है और कभी कमिट नहीं किया जाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohranjeno u .git/info/exclude; utječe samo na ovaj radni direktorij i nikada se ne predaje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A .git/info/exclude fájlban tárolódik; csak erre a munkakönyvtárra érvényes, és soha nem lesz véglegesítve."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disimpan di .git/info/exclude; hanya memengaruhi direktori kerja ini dan tidak pernah dikomit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memorizzato in .git/info/exclude; riguarda solo questa directory di lavoro e non viene mai incluso nei commit."
