    },
    "Restores saved local configuration or attributes only while HEAD and the recorded files still match. Later changes are preserved. Saved conversion records restore the earlier index; working file contents are preserved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستعيد الإعدادات أو السمات المحلية المحفوظة فقط ما دام HEAD والملفات المسجلة متطابقة. يُحتفظ بالتغييرات اللاحقة. تستعيد سجلات التحويل المحفوظة الفهرس السابق؛ ويُحتفظ بمحتوى ملفات العمل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura només la configuració local o els atributs desats mentre HEAD i els fitxers registrats encara coincideixin. Es conserven els canvis posteriors. Els registres de conversió desats restauren l'índex anterior; es conserva el contingut dels fitxers de treball."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnoví uloženou místní konfiguraci nebo atributy pouze tehdy, pokud HEAD a zaznamenané soubory stále odpovídají. Pozdější změny se zachovají. Uložené záznamy převodu obnoví dřívější index; obsah pracovních souborů se zachová."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gendanner kun gemt lokal konfiguration eller attributter, så længe HEAD og de registrerede filer stadig stemmer overens. Senere ændringer bevares. Gemte konverteringsposter gendanner det tidligere indeks; indholdet af filerne i arbejdskopien bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt gesicherte lokale Konfiguration oder Attribute nur wieder her, solange HEAD und die erfassten Dateien noch übereinstimmen. Spätere Änderungen bleiben erhalten. Gesicherte Konvertierungseinträge stellen den früheren Index wieder her; Inhalte der Arbeitsdateien bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαναφέρει αποθηκευμένη τοπική διαμόρφωση ή γνωρίσματα μόνο όσο το HEAD και τα καταγεγραμμένα αρχεία εξακολουθούν να αντιστοιχούν. Μεταγενέστερες αλλαγές διατηρούνται. Οι αποθηκευμένες εγγραφές μετατροπής επαναφέρουν το προηγούμενο ευρετήριο· τα περιεχόμενα αρχείων εργασίας διατηρούνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura la configuración local o los atributos guardados solo mientras HEAD y los archivos registrados coincidan. Los cambios posteriores se conservan. Los registros de conversión guardados restauran el índice anterior; se conserva el contenido de los archivos de trabajo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura la configuración local o los atributos guardados solo mientras HEAD y los archivos registrados coincidan. Los cambios posteriores se conservan. Los registros de conversión guardados restauran el índice anterior; se conserva el contenido de los archivos de trabajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palauttaa tallennetut paikalliset asetukset tai attribuutit vain, jos HEAD ja kirjatut tiedostot vastaavat yhä tallennettua tilaa. Myöhemmät muutokset säilytetään. Tallennetut muunnostietueet palauttavat aiemman indeksin. Työtiedostojen sisältö säilytetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaure la configuration locale ou les attributs enregistrés uniquement tant que HEAD et les fichiers enregistrés correspondent encore. Les modifications ultérieures sont conservées. Les enregistrements de conversion sauvegardés restaurent l’index antérieur ; le contenu des fichiers de travail est conservé."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaure la configuration locale ou les attributs enregistrés uniquement tant que HEAD et les fichiers enregistrés correspondent encore. Les modifications ultérieures sont conservées. Les enregistrements de conversion sauvegardés restaurent l’index antérieur; le contenu des fichiers de travail est conservé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משחזר הגדרות מקומיות או מאפיינים שמורים רק כל עוד HEAD והקבצים המתועדים עדיין תואמים. שינויים מאוחרים יותר נשמרים. רשומות המרה שמורות משחזרות את האינדקס הקודם; תוכן קובצי העבודה נשמר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजा गया स्थानीय कॉन्फ़िगरेशन या एट्रिब्यूट तभी बहाल करता है जब HEAD और दर्ज फ़ाइलें अब भी मेल खाते हों। बाद के बदलाव सुरक्षित रहते हैं। सहेजे गए रूपांतरण रिकॉर्ड पुराने इंडेक्स को बहाल करते हैं; वर्किंग फ़ाइलों की सामग्री सुरक्षित रहती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnavlja spremljenu lokalnu konfiguraciju ili atribute samo dok HEAD i zabilježene datoteke još odgovaraju. Kasnije promjene su sačuvane. Spremljeni zapisi pretvorbe obnavljaju raniji indeks; sadržaj radnih datoteka je sačuvan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak akkor állítja vissza a mentett helyi konfigurációt vagy attribútumokat, ha a HEAD és a rögzített fájlok még egyeznek. A későbbi módosítások megmaradnak. A mentett átalakítási rekordok visszaállítják a korábbi indexet; a munkafájlok tartalma megmarad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memulihkan konfigurasi lokal atau atribut tersimpan hanya selama HEAD dan file yang dicatat masih cocok. Perubahan setelahnya dipertahankan. Catatan konversi tersimpan memulihkan indeks sebelumnya; konten file kerja dipertahankan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina la configurazione locale o gli attributi salvati solo finché HEAD e i file registrati corrispondono ancora. Le modifiche successive vengono mantenute. I record di conversione salvati ripristinano l'indice precedente; il contenuto dei file di lavoro viene mantenuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたローカルの構成または属性を、HEAD と記録されたファイルが一致している場合にのみ復元します。それ以降の変更は保持されます。保存された変換記録は以前のインデックスを復元し、作業ファイルの内容は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD와 기록된 파일이 여전히 일치하는 경우에만 저장된 로컬 구성 또는 속성을 복원합니다. 이후 변경 사항은 보존됩니다. 저장된 변환 기록은 이전 인덱스를 복원하며 작업 파일 내용은 보존됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memulihkan konfigurasi setempat atau atribut tersimpan hanya selagi HEAD dan fail yang direkodkan masih sepadan. Perubahan kemudian dikekalkan. Rekod penukaran tersimpan memulihkan indeks terdahulu; kandungan fail kerja dikekalkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet opgeslagen lokale configuratie of attributen alleen terug zolang HEAD en de vastgelegde bestanden nog overeenkomen. Latere wijzigingen blijven behouden. Opgeslagen conversierecords herstellen de eerdere index; de inhoud van werkbestanden blijft behouden."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenoppretter lagret lokal konfigurasjon eller attributter bare så lenge HEAD og de registrerte filene fortsatt samsvarer. Senere endringer beholdes. Lagrede konverteringsoppføringer gjenoppretter den tidligere indeksen. Innholdet i arbeidsfilene beholdes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywraca zapisaną lokalną konfigurację lub atrybuty tylko wtedy, gdy HEAD i zapisane pliki nadal się zgadzają. Późniejsze zmiany zostają zachowane. Zapisane rekordy konwersji przywracają wcześniejszy indeks; zawartość plików roboczych zostaje zachowana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura a configuração local ou os atributos salvos somente enquanto o HEAD e os arquivos registrados ainda corresponderem. Alterações posteriores são preservadas. Os registros de conversão salvos restauram o índice anterior; o conteúdo dos arquivos de trabalho é preservado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura a configuração local ou os atributos guardados apenas enquanto o HEAD e os ficheiros registados ainda corresponderem. Alterações posteriores são preservadas. Os registos de conversão guardados restauram o índice anterior; o conteúdo dos ficheiros de trabalho é preservado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurează configurarea locală sau atributele salvate doar cât timp HEAD și fișierele înregistrate încă se potrivesc. Modificările ulterioare sunt păstrate. Înregistrările de conversie salvate restaurează indexul anterior; conținutul fișierelor de lucru este păstrat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстанавливает сохранённую локальную конфигурацию или атрибуты, только пока HEAD и записанные файлы совпадают. Последующие изменения сохраняются. Сохранённые записи преобразования восстанавливают прежний индекс; содержимое рабочих файлов сохраняется."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnoví uloženú lokálnu konfiguráciu alebo atribúty, len ak HEAD a zaznamenané súbory stále zodpovedajú pôvodnému stavu. Neskoršie zmeny sa zachovajú. Uložené záznamy konverzie obnovia skorší index; obsah pracovných súborov sa zachová."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnovi shranjene lokalne nastavitve ali atribute samo, dokler se HEAD in zabeležene datoteke še ujemajo. Poznejše spremembe so ohranjene. Shranjeni zapisi pretvorb obnovijo prejšnji indeks; vsebina delovnih datotek je ohranjena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återställer sparad lokal konfiguration eller sparade attribut endast så länge HEAD och de registrerade filerna fortfarande stämmer överens. Senare ändringar behålls. Sparade konverteringsposter återställer det tidigare indexet. Arbetsfilernas innehåll behålls."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กู้คืนการกำหนดค่าในเครื่องหรือแอตทริบิวต์ที่บันทึกไว้เฉพาะเมื่อ HEAD และไฟล์ที่บันทึกไว้ยังตรงกัน การเปลี่ยนแปลงภายหลังจะยังคงอยู่ บันทึกการแปลงที่เก็บไว้จะกู้คืนดัชนีก่อนหน้า โดยคงเนื้อหาไฟล์ทำงานไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlı yerel yapılandırmayı veya öznitelikleri yalnızca HEAD ve kayıtlı dosyalar hâlâ eşleşiyorsa geri yükler. Sonraki değişiklikler korunur. Kayıtlı dönüşüm kayıtları önceki indeksi geri yükler; çalışma dosyalarının içerikleri korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відновлює збережену локальну конфігурацію або атрибути, лише поки HEAD і записані файли ще збігаються. Пізніші зміни зберігаються. Збережені записи перетворення відновлюють попередній індекс; вміст робочих файлів зберігається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ khôi phục cấu hình cục bộ hoặc thuộc tính đã lưu khi HEAD và các tệp được ghi nhận vẫn khớp. Giữ nguyên thay đổi về sau. Bản ghi chuyển đổi đã lưu khôi phục chỉ mục trước đó; giữ nguyên nội dung tệp làm việc."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在 HEAD 與記錄的檔案仍相符時，才會回復已儲存的本機設定或屬性。之後的變更會保留。已儲存的轉換記錄會回復先前的索引；工作檔案內容會保留。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在 HEAD 和记录的文件仍然匹配时，恢复已保存的本地配置或属性。之后的更改会被保留。已保存的转换记录会恢复较早的索引；工作文件内容会被保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在 HEAD 與記錄的檔案仍相符時，才會回復已儲存的本機設定或屬性。之後的變更會保留。已儲存的轉換記錄會回復先前的索引；工作檔案內容會保留。"
          }
        }
      }
    },
