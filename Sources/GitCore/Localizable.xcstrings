    "%@\nGit Flow progress was saved. Resolve the current operation, then use Continue Git Flow; the topic and completed history are retained." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nحُفظ تقدم Git Flow. أكمل العملية الحالية، ثم استخدم «متابعة Git Flow»؛ يُحتفظ بفرع الموضوع والسجل المكتمل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nS'ha desat el progrés de Git Flow. Resol l'operació actual i fes servir Continua Git Flow; es conserven la branca de treball i l'historial completat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nPrůběh Git Flow byl uložen. Vyřešte aktuální operaci a poté použijte Pokračovat v Git Flow; tematická větev a dokončená historie zůstanou zachovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nFremdriften i Git Flow blev gemt. Afslut den aktuelle handling, og brug derefter Fortsæt Git Flow. Arbejdsgrenen og den afsluttede historik bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nGit Flow-Fortschritt wurde gesichert. Schließe den aktuellen Vorgang ab und wähle dann „Git Flow fortsetzen“; Topic und abgeschlossener Verlauf bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nΗ πρόοδος του Git Flow αποθηκεύτηκε. Επιλύστε την τρέχουσα λειτουργία και επιλέξτε «Συνέχιση Git Flow»· το θέμα και το ολοκληρωμένο ιστορικό διατηρούνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nSe guardó el progreso de Git Flow. Resuelve la operación actual y usa Continuar Git Flow; se conservan el tema y el historial completado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nSe guardó el progreso de Git Flow. Resuelve la operación actual y usa Continuar Git Flow; se conservan el tema y el historial completado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nGit Flow -edistyminen tallennettiin. Ratkaise nykyinen toiminto ja valitse sitten Jatka Git Flow’ta. Aihehaara ja valmis historia säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nLa progression de Git Flow a été enregistrée. Résolvez l’opération en cours, puis utilisez Continuer Git Flow ; la branche de sujet et l’historique terminé sont conservés."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nLa progression de Git Flow a été enregistrée. Résolvez l’opération en cours, puis utilisez Continuer Git Flow; la branche de sujet et l’historique terminé sont conservés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nההתקדמות ב־Git Flow נשמרה. יש לפתור את הפעולה הנוכחית ואז לבחור בהמשך Git Flow; ענף הנושא וההיסטוריה שהושלמה נשמרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nGit Flow की प्रगति सहेज ली गई है। वर्तमान कार्य सुलझाएँ, फिर Git Flow जारी रखें का उपयोग करें; विषय ब्रांच और पूरा हुआ इतिहास सुरक्षित हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nNapredak za Git Flow je spremljen. Dovršite trenutačnu operaciju pa odaberite Nastavi Git Flow; tematska grana i dovršena povijest su sačuvane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nA Git Flow előrehaladása mentve. Rendezze az aktuális műveletet, majd válassza a Git Flow folytatása lehetőséget; a témaág és a befejezett előzmények megmaradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nProgres Git Flow telah disimpan. Selesaikan operasi saat ini, lalu gunakan Lanjutkan Git Flow; topik dan riwayat yang telah selesai dipertahankan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nL'avanzamento di Git Flow è stato salvato. Risolvi l'operazione in corso, poi usa Continua Git Flow; il topic e la cronologia completata vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nGit Flow の進行状況を保存しました。現在の操作を解決してから「Git Flow を続行」を使用してください。トピックと完了済みの履歴は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nGit Flow 진행 상황이 저장되었습니다. 현재 작업을 해결한 다음 Git Flow 계속을 사용하십시오. 토픽과 완료된 기록은 유지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKemajuan Git Flow disimpan. Selesaikan operasi semasa, kemudian gunakan Teruskan Git Flow; topik dan sejarah yang telah selesai dikekalkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nDe voortgang van Git Flow is opgeslagen. Rond de huidige bewerking af en kies daarna 'Ga door met Git Flow'; de topicbranch en de voltooide geschiedenis blijven behouden."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nFremdriften for Git Flow ble lagret. Fullfør den pågående operasjonen, og bruk deretter Fortsett Git Flow. Arbeidsgrenen og den fullførte historikken beholdes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nPostęp Git Flow został zapisany. Rozwiąż bieżącą operację, a następnie użyj opcji Kontynuuj Git Flow; temat i ukończona historia zostają zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nO progresso do Git Flow foi salvo. Resolva a operação atual e use Continuar Git Flow; o tópico e o histórico concluído são mantidos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nO progresso do Git Flow foi guardado. Resolva a operação atual e use Continuar Git Flow; o tópico e o histórico concluído são mantidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nProgresul Git Flow a fost salvat. Rezolvați operațiunea curentă, apoi folosiți Continuă Git Flow; ramura de lucru și istoricul finalizat sunt păstrate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nПрогресс Git Flow сохранён. Завершите текущую операцию, затем выберите «Продолжить Git Flow»; тематическая ветка и завершённая история сохранятся."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nPriebeh Git Flow sa uložil. Vyriešte aktuálnu operáciu a potom použite Pokračovať v Git Flow; tematická vetva a dokončená história sa zachovajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nNapredek Git Flow je shranjen. Razrešite trenutno opravilo, nato uporabite Nadaljuj Git Flow; tematska veja in zaključena zgodovina sta ohranjeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nFörloppet för Git Flow har sparats. Slutför den aktuella åtgärden och välj sedan Fortsätt Git Flow. Arbetsgrenen och den slutförda historiken behålls."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nบันทึกความคืบหน้า Git Flow แล้ว แก้ไขการดำเนินการปัจจุบัน จากนั้นใช้ดำเนินการ Git Flow ต่อ โดยยังเก็บแบรนช์หัวข้อและประวัติที่เสร็จแล้วไว้"
