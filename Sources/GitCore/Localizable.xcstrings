    "%@\nThe backup and quarantined data were kept. Reopen Management Backups to resume restoration." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nحُفظت النسخة الاحتياطية والبيانات المعزولة. أعد فتح النسخ الاحتياطية للإدارة لمتابعة الاستعادة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nS'han conservat la còpia de seguretat i les dades en quarantena. Torna a obrir Còpies de seguretat de gestió per reprendre la restauració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nZáloha a data v karanténě byly zachovány. Chcete-li pokračovat v obnově, znovu otevřete Zálohy správy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nSikkerhedskopien og dataene i karantæne blev bevaret. Åbn administrationssikkerhedskopier igen for at genoptage gendannelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nBackup und isolierte Daten wurden behalten. Öffne „Verwaltungs-Backups“ erneut, um die Wiederherstellung fortzusetzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nΤο αντίγραφο ασφαλείας και τα δεδομένα σε καραντίνα διατηρήθηκαν. Ανοίξτε ξανά τα Αντίγραφα ασφαλείας διαχείρισης για να συνεχίσετε την επαναφορά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nSe conservaron la copia de seguridad y los datos en cuarentena. Vuelve a abrir Copias de seguridad de gestión para reanudar la restauración."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nSe conservaron el respaldo y los datos en cuarentena. Vuelve a abrir Respaldos de administración para reanudar la restauración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nVarmuuskopio ja eristetyt tiedot säilytettiin. Jatka palautusta avaamalla hallinnan varmuuskopiot uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nLa sauvegarde et les données mises en quarantaine ont été conservées. Rouvrez Sauvegardes de gestion pour reprendre la restauration."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nLa sauvegarde et les données mises en quarantaine ont été conservées. Rouvrez Sauvegardes de gestion pour reprendre la restauration."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nהגיבוי והנתונים שבהסגר נשמרו. כדי להמשיך בשחזור, יש לפתוח מחדש את גיבויי הניהול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nबैकअप और अलग रखा गया डेटा सुरक्षित हैं। बहाली फिर शुरू करने के लिए प्रबंधन बैकअप दोबारा खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nSigurnosna kopija i podaci u karanteni su sačuvani. Ponovno otvorite Sigurnosne kopije upravljanja za nastavak obnove."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nA biztonsági mentés és a karanténba helyezett adatok megmaradtak. A visszaállítás folytatásához nyissa meg újra a Kezelési biztonsági mentések nézetet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nCadangan dan data yang dikarantina dipertahankan. Buka kembali Cadangan Pengelolaan untuk melanjutkan pemulihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nIl backup e i dati in quarantena sono stati mantenuti. Riapri Backup di gestione per riprendere il ripristino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nバックアップと隔離されたデータは保持されました。復元を再開するには「管理バックアップ」を再度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n백업 및 격리된 데이터가 보관되었습니다. 관리 백업을 다시 열어 복원을 재개하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nSandaran dan data yang dikuarantin dikekalkan. Buka semula Sandaran Pengurusan untuk menyambung pemulihan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nDe reservekopie en de gegevens in quarantaine zijn bewaard. Open 'Beheerreservekopieën' opnieuw om het herstel te hervatten."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nSikkerhetskopien og dataene i karantene ble beholdt. Åpne Administrasjonssikkerhetskopier igjen for å fortsette gjenopprettingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKopia zapasowa i dane poddane kwarantannie zostały zachowane. Otwórz ponownie kopie zapasowe zarządzania, aby wznowić przywracanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nO backup e os dados em quarentena foram mantidos. Reabra Backups de Gerenciamento para retomar a restauração."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nA cópia de segurança e os dados em quarentena foram mantidos. Reabra Cópias de segurança de gestão para retomar o restauro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nCopia de siguranță și datele din carantină au fost păstrate. Redeschideți Copii de siguranță administrative pentru a relua restaurarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nРезервная копия и данные в карантине сохранены. Снова откройте «Резервные копии управления», чтобы продолжить восстановление."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nZáloha a dáta v karanténe sa zachovali. Ak chcete pokračovať v obnove, znova otvorte Zálohy správy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nVarnostna kopija in podatki v karanteni so ohranjeni. Za nadaljevanje obnovitve znova odprite Varnostne kopije upravljanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nSäkerhetskopian och data i karantän har behållits. Öppna hanteringssäkerhetskopiorna igen för att återuppta återställningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nเก็บข้อมูลสำรองและข้อมูลที่กักแยกไว้แล้ว เปิดข้อมูลสำรองการจัดการอีกครั้งเพื่อกู้คืนต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nYedek ve karantinadaki veriler korundu. Geri yüklemeyi sürdürmek için Yönetim Yedekleri'ni yeniden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nРезервну копію та ізольовані дані збережено. Знову відкрийте «Резервні копії керування», щоб продовжити відновлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nĐã giữ bản sao lưu và dữ liệu cách ly. Mở lại Bản sao lưu quản lý để tiếp tục khôi phục."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n備份與隔離的資料皆已保留。請重新打開「管理備份」以繼續回復。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n备份和隔离数据已保留。请重新打开“管理备份”以继续恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n備份與隔離的資料皆已保留。請重新打開「管理備份」以繼續回復。"
          }
        }
      }
    },
    "%@\nThe destination may contain a partial clone; existing files were kept. Open it to retry submodule initialization." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nقد تحتوي الوجهة على استنساخ جزئي؛ حُفظت الملفات الموجودة. افتحها لإعادة تهيئة الوحدات الفرعية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nLa destinació pot contenir un clon parcial; s'han conservat els fitxers existents. Obre-la per tornar a provar la inicialització dels submòduls."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nCílové umístění může obsahovat neúplný klon; existující soubory byly zachovány. Otevřete je a zkuste znovu inicializovat podmoduly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nDestinationen kan indeholde en delvis kloning. Eksisterende filer blev bevaret. Åbn den for at prøve at initialisere undermodulerne igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nDas Ziel enthält möglicherweise einen unvollständigen Klon; vorhandene Dateien wurden behalten. Öffne es, um die Submodul-Initialisierung erneut zu versuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nΟ προορισμός ενδέχεται να περιέχει μερικό κλώνο· τα υπάρχοντα αρχεία διατηρήθηκαν. Ανοίξτε τον για να επαναλάβετε την αρχικοποίηση υπομονάδων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nEl destino puede contener un clon parcial; se conservaron los archivos existentes. Ábrelo para reintentar la inicialización del submódulo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nEl destino puede contener un clon parcial; se conservaron los archivos existentes. Ábrelo para reintentar la inicialización del submódulo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKohde saattaa sisältää keskeneräisen kloonin. Olemassa olevat tiedostot säilytettiin. Avaa kohde ja yritä alimoduulien alustusta uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nLa destination peut contenir un clone partiel ; les fichiers existants ont été conservés. Ouvrez-la pour réessayer l’initialisation du sous-module."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nLa destination peut contenir un clone partiel; les fichiers existants ont été conservés. Ouvrez-la pour réessayer l’initialisation du sous-module."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nייתכן שהיעד מכיל שיבוט חלקי; הקבצים הקיימים נשמרו. יש לפתוח אותו כדי לנסות שוב לאתחל את תת־המודולים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nगंतव्य में अधूरा क्लोन हो सकता है; मौजूदा फ़ाइलें सुरक्षित हैं। सबमॉड्यूल का आरंभीकरण फिर आज़माने के लिए इसे खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nOdredište možda sadrži djelomični klon; postojeće datoteke su sačuvane. Otvorite ga za ponovnu inicijalizaciju podmodula."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nA célhely részleges klónt tartalmazhat; a meglévő fájlok megmaradtak. Nyissa meg az almodulok inicializálásának újrapróbálásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nTujuan mungkin berisi klona parsial; file yang ada dipertahankan. Buka untuk mencoba inisialisasi submodul lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nLa destinazione potrebbe contenere un clone parziale; i file esistenti sono stati mantenuti. Aprila per riprovare l'inizializzazione dei sottomoduli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n保存先に一部のみのクローンが含まれている可能性があります。既存のファイルは保持されました。サブモジュールの初期化を再試行するには、保存先を開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n대상에 부분적으로 복제된 데이터가 있을 수 있습니다. 기존 파일은 보관되었습니다. 열어서 서브모듈 초기화를 다시 시도하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nDestinasi mungkin mengandungi klon separa; fail sedia ada dikekalkan. Bukanya untuk mencuba semula pengawalan submodul."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nDe doellocatie bevat mogelijk een gedeeltelijke kloon; bestaande bestanden zijn behouden. Open deze locatie om de submodules opnieuw te initialiseren."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nMålmappen kan inneholde en ufullstendig klone. Eksisterende filer ble beholdt. Åpne den for å prøve å initialisere undermodulene på nytt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nMiejsce docelowe może zawierać częściowy klon; istniejące pliki zostały zachowane. Otwórz je, aby ponowić inicjowanie modułu podrzędnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nO destino pode conter um clone parcial; os arquivos existentes foram mantidos. Abra-o para tentar inicializar o submódulo novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nO destino pode conter um clone parcial; os ficheiros existentes foram mantidos. Abra-o para tentar inicializar o submódulo novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nDestinația poate conține o clonă parțială; fișierele existente au fost păstrate. Deschideți-o pentru a reîncerca inițializarea submodulelor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nПапка назначения может содержать неполный клон; существующие файлы сохранены. Откройте её, чтобы повторить инициализацию подмодулей."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nCieľ môže obsahovať čiastočný klon; existujúce súbory sa zachovali. Otvorte ho a zopakujte inicializáciu podmodulov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nCilj lahko vsebuje delni klon; obstoječe datoteke so ohranjene. Odprite ga za ponovni poskus inicializacije podmodulov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nMålet kan innehålla en ofullständig klon. Befintliga filer har behållits. Öppna det för att försöka initiera undermodulerna igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nปลายทางอาจมีข้อมูลโคลนที่ไม่สมบูรณ์ โดยเก็บไฟล์เดิมไว้แล้ว เปิดปลายทางเพื่อลองเริ่มต้นโมดูลย่อยอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nHedefte kısmi bir klon olabilir; mevcut dosyalar korundu. Alt modül başlatmayı yeniden denemek için hedefi açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nПризначення може містити частковий клон; наявні файли збережено. Відкрийте його, щоб повторити ініціалізацію підмодулів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nĐích có thể chứa bản sao chưa hoàn tất; các tệp hiện có được giữ lại. Mở đích để thử khởi tạo lại mô-đun con."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n目的地可能含有部分完成的複製；現有檔案皆已保留。請打開它以重試子模組初始化。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n目标位置可能包含部分克隆；现有文件已保留。打开它以重试子模块初始化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n目的地可能含有部分完成的複製；現有檔案皆已保留。請打開它以重試子模組初始化。"
          }
        }
      }
    },
