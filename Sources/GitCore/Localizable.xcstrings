        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieșirea îmbinării trebuie să fie un fișier UTF-8 obișnuit mai mic de 1 MB."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Результат слияния должен быть обычным файлом UTF-8 размером менее 1 МБ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výstup zlúčenia musí byť bežný súbor UTF-8 menší ako 1 MB."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izhod združevanja mora biti običajna datoteka UTF-8, manjša od 1 MB."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammanslagningens resultat måste vara en vanlig UTF-8-fil som är mindre än 1 MB."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผลลัพธ์การผสานต้องเป็นไฟล์ UTF-8 ปกติที่มีขนาดต่ำกว่า 1 MB"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birleştirme çıktısı, 1 MB'tan küçük normal bir UTF-8 dosyası olmalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Результат злиття має бути звичайним файлом UTF-8 розміром менше 1 МБ."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đầu ra hợp nhất phải là tệp UTF-8 thông thường dưới 1 MB."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合併輸出必須是小於 1 MB 的一般 UTF-8 檔案。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合并输出必须是小于 1 MB 的常规 UTF-8 文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合併輸出必須是小於 1 MB 的一般 UTF-8 檔案。"
          }
        }
      }
    },
    "Merge-preserving plans retain topology and merge messages. Use Pick, Reword, Edit or Drop on ordinary commits without reordering; merge rows are retained." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ الخطط المحتفظة بالدمج بالبنية ورسائل الدمج. استخدم الانتقاء أو إعادة الصياغة أو التعديل أو الإسقاط للإيداعات العادية دون إعادة ترتيب؛ ويُحتفظ بصفوف الدمج."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els plans que conserven les fusions mantenen la topologia i els missatges de fusió. Fes servir Tria, Reformula, Edita o Omet en commits normals sense reordenar-los; les files de fusió es conserven."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plány se zachováním sloučení ponechají topologii i zprávy sloučení. U běžných commitů použijte Převzít, Upravit zprávu, Upravit nebo Vynechat bez změny pořadí; řádky sloučení zůstanou zachovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planer, der bevarer fletninger, bevarer topologi og flettebeskeder. Brug Medtag, Omskriv besked, Rediger eller Fjern på almindelige commits uden at ændre rækkefølgen; fletterækker bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merge-erhaltende Pläne behalten Topologie und Merge-Nachrichten. Verwende Pick, Reword, Edit oder Drop bei gewöhnlichen Commits ohne Neuanordnung; Merge-Zeilen bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα σχέδια διατήρησης συγχωνεύσεων διατηρούν την τοπολογία και τα μηνύματα συγχώνευσης. Χρησιμοποιήστε Επιλογή, Αλλαγή μηνύματος, Επεξεργασία ή Παράλειψη σε κανονικές υποβολές χωρίς αναδιάταξη· οι γραμμές συγχώνευσης διατηρούνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los planes que conservan fusiones mantienen la topología y los mensajes de fusión. Usa Usar, Reformular, Editar o Eliminar en commits normales sin reordenarlos; las filas de fusión se conservan."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los planes que conservan fusiones mantienen la topología y los mensajes de fusión. Usa Usar, Reformular, Editar o Eliminar en commits normales sin reordenarlos; las filas de fusión se conservan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistämiset säilyttävät suunnitelmat säilyttävät rakenteen ja yhdistämisviestit. Käytä tavallisiin tallennuksiin toimintoja Poimi, Muokkaa viestiä, Muokkaa tai Poista muuttamatta järjestystä. Yhdistämisrivit säilytetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plans préservant les fusions conservent la topologie et les messages de fusion. Utilisez Choisir, Reformuler, Modifier ou Supprimer sur les commits ordinaires sans les réordonner ; les lignes de fusion sont conservées."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plans préservant les fusions conservent la topologie et les messages de fusion. Utilisez Choisir, Reformuler, Modifier ou Supprimer sur les commits ordinaires sans les réordonner; les lignes de fusion sont conservées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תוכניות המשמרות מיזוגים שומרות על מבנה ההיסטוריה ועל הודעות המיזוג. ניתן לבחור בהחלה, בעריכת הודעה, בעריכה או בהשמטה עבור קומיטים רגילים בלי לשנות את סדרם; שורות המיזוג נשמרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मर्ज संरक्षित रखने वाली योजनाएँ संरचना और मर्ज संदेश बनाए रखती हैं। सामान्य कमिट का क्रम बदले बिना चुनें, संदेश बदलें, संपादित करें या हटाएँ का उपयोग करें; मर्ज पंक्तियाँ बनी रहती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planovi koji čuvaju spajanja zadržavaju topologiju i poruke spajanja. Na običnim predajama koristite Odaberi, Preoblikuj poruku, Uredi ili Izostavi bez promjene redoslijeda; redci spajanja se zadržavaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egyesítéseket megőrző tervek megtartják a topológiát és az egyesítési üzeneteket. A normál véglegesítéseken a Kiválasztás, Üzenet átírása, Szerkesztés vagy Elhagyás műveletet használja átrendezés nélkül; az egyesítési sorok megmaradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rencana yang mempertahankan penggabungan menjaga topologi dan pesan penggabungan. Gunakan Pilih, Ubah Pesan, Edit, atau Buang pada komit biasa tanpa mengubah urutannya; baris penggabungan dipertahankan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I piani che mantengono le unioni conservano la topologia e i messaggi di unione. Usa Scegli, Riformula, Modifica o Elimina sui commit ordinari senza riordinarli; le righe di unione vengono mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マージを保持するプランでは、トポロジーとマージメッセージが保持されます。通常のコミットでは並べ替えをせずに Pick、Reword、Edit、Drop を使用してください。マージの行は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "병합 보존 계획은 토폴로지와 병합 메시지를 유지합니다. 순서를 바꾸지 않고 일반 커밋에 선택, 메시지 수정, 편집 또는 드롭을 사용하십시오. 병합 행은 유지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelan yang mengekalkan penggabungan mengekalkan topologi dan mesej penggabungan. Gunakan Pilih, Ubah Mesej, Sunting atau Gugurkan pada komit biasa tanpa menyusun semula; baris penggabungan dikekalkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plannen die merges behouden, bewaren de topologie en mergeberichten. Gebruik 'Toepassen', 'Bericht wijzigen', 'Bewerken' of 'Weglaten' voor gewone commits zonder ze te herschikken; mergeregels blijven behouden."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planer som bevarer sammenslåinger, beholder topologien og sammenslåingsmeldingene. Bruk Velg, Endre melding, Rediger eller Utelat på vanlige innsjekkinger uten å endre rekkefølgen. Sammenslåingsradene beholdes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plany zachowujące scalenia zachowują topologię i komunikaty scaleń. Używaj Wybierz, Przeredaguj, Edytuj lub Pomiń dla zwykłych commitów bez zmiany kolejności; wiersze scaleń są zachowywane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planos que preservam merges mantêm a topologia e as mensagens de merge. Use Usar, Reformular, Editar ou Descartar em commits comuns sem reordenar; as linhas de merge são mantidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planos que preservam merges mantêm a topologia e as mensagens de merge. Use Usar, Reformular, Editar ou Descartar em commits comuns sem reordenar; as linhas de merge são mantidas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planurile care păstrează îmbinările mențin topologia și mesajele de îmbinare. Folosiți Preia, Reformulează, Editează sau Omite pentru commituri obișnuite fără reordonare; rândurile de îmbinare sunt păstrate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планы с сохранением слияний сохраняют топологию и сообщения слияний. Используйте «Выбрать», «Изменить сообщение», «Изменить» или «Удалить» для обычных коммитов без изменения порядка; строки слияний сохраняются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plány so zachovaním zlúčení zachovávajú topológiu aj správy zlúčení. Na bežné commity použite Prevziať, Upraviť správu, Upraviť alebo Vynechať bez zmeny poradia; riadky zlúčení sa zachovajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Načrti z ohranjanjem združitev ohranijo topologijo in sporočila združitev. Pri običajnih potrditvah brez spreminjanja vrstnega reda uporabite Izberi, Preoblikuj sporočilo, Uredi ali Izpusti; vrstice združitev so ohranjene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planer som bevarar sammanslagningar behåller topologin och sammanslagningsmeddelandena. Använd Välj, Ändra meddelande, Redigera eller Ta bort på vanliga incheckningar utan att ändra ordningen. Sammanslagningsraderna behålls."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แผนที่คงการผสานจะเก็บโครงสร้างและข้อความการผสานไว้ ใช้เลือก ใช้ข้อความใหม่ แก้ไข หรือทิ้งกับคอมมิตปกติโดยไม่เปลี่ยนลำดับ แถวการผสานจะถูกเก็บไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birleştirmeleri koruyan planlar, topolojiyi ve birleştirme mesajlarını korur. Normal işlemelerde sıralamayı değiştirmeden Seç, Yeniden Yaz, Düzenle veya Çıkar'ı kullanın; birleştirme satırları korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плани зі збереженням злиттів зберігають топологію й повідомлення злиттів. Використовуйте «Вибрати», «Переформулювати», «Редагувати» або «Відкинути» для звичайних комітів без зміни порядку; рядки злиттів зберігаються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kế hoạch giữ hợp nhất giữ lại cấu trúc lịch sử và thông điệp hợp nhất. Dùng Chọn, Sửa thông điệp, Chỉnh sửa hoặc Loại trên commit thông thường mà không sắp xếp lại; các hàng hợp nhất được giữ nguyên."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留合併的計畫會保留拓撲結構與合併訊息。請在一般提交上使用「挑選」、「改寫訊息」、「編輯」或「丟棄」，且不要重新排序；合併列會保留。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留合并的计划会保留拓扑结构和合并信息。可对普通提交使用“选取”、“改写”、“编辑”或“丢弃”，但不能重新排序；合并行会被保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留合併的計畫會保留拓撲結構與合併訊息。請在一般提交上使用「挑選」、「改寫訊息」、「編輯」或「丟棄」，且不要重新排序；合併列會保留。"
          }
        }
      }
    },
