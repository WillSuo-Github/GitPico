    "Backups keep full directory copies, up to 2 GB / 100,000 entries per directory. They are not automatically removed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ النسخ الاحتياطية بنسخ مجلدات كاملة، بحد أقصى 2 غيغابايت / 100,000 عنصر لكل مجلد. لا تُحذف تلقائيًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les còpies de seguretat conserven còpies completes dels directoris, fins a 2 GB / 100.000 entrades per directori. No s'eliminen automàticament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zálohy uchovávají úplné kopie adresářů, nejvýše 2 GB / 100 000 položek na adresář. Automaticky se neodstraňují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhedskopier indeholder fulde kopier af mapper, op til 2 GB / 100.000 elementer pr. mappe. De fjernes ikke automatisk."
          }
        },
        "de" : {
