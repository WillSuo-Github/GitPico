    "Could not reach the server. Check your network or proxy and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر الوصول إلى الخادم. تحقق من الشبكة أو الوكيل وأعد المحاولة."
