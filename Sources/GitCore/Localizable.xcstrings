          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô-đun con được xuất thành thư mục trống; không bao gồm các kho riêng của chúng."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
