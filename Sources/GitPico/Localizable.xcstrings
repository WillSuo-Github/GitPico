    "Inspect the repository and remote state before retrying. A cancelled or failed write can have partially completed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افحص حالة المستودع والمستودع البعيد قبل إعادة المحاولة. قد تكون الكتابة الملغاة أو الفاشلة اكتملت جزئيًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
