    "Drag commits within the current linear branch to reorder or combine them. Use the HEAD branch to cherry-pick other commits." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب الإيداعات ضمن الفرع الخطي الحالي لإعادة ترتيبها أو دمجها. استخدم فرع HEAD لانتقاء إيداعات أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrossega commits dins de la branca lineal actual per reordenar-los o combinar-los. Fes servir la branca de HEAD per aplicar altres commits."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přetažením commitů v aktuální lineární větvi změníte jejich pořadí nebo je spojíte. Pro převzetí jiných commitů použijte větev HEAD."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk commits inden for den aktuelle lineære gren for at ændre rækkefølgen eller kombinere dem. Brug HEAD-grenen til at udvælge og anvende andre commits."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe Commits innerhalb des aktuellen linearen Branches, um sie neu anzuordnen oder zusammenzufassen. Verwende den HEAD-Branch, um andere Commits zu cherry-picken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε υποβολές εντός του τρέχοντος γραμμικού κλάδου για αναδιάταξη ή συνδυασμό. Χρησιμοποιήστε τον κλάδο HEAD για επιλεκτική εφαρμογή άλλων υποβολών."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra commits dentro de la rama lineal actual para reordenarlos o combinarlos. Usa la rama HEAD para hacer cherry-pick de otros commits."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra commits dentro de la rama lineal actual para reordenarlos o combinarlos. Usa la rama HEAD para hacer cherry-pick de otros commits."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestä tai yhdistä tallennuksia vetämällä niitä nykyisessä lineaarisessa haarassa. Poimi muita tallennuksia HEAD-haaran avulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser des commits au sein de la branche linéaire actuelle pour les réordonner ou les combiner. Utilisez la branche HEAD pour faire un cherry-pick d’autres commits."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser des commits au sein de la branche linéaire actuelle pour les réordonner ou les combiner. Utilisez la branche HEAD pour faire un cherry-pick d’autres commits."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן לגרור קומיטים בתוך הענף הליניארי הנוכחי כדי לשנות את סדרם או לשלב ביניהם. יש להשתמש בענף HEAD להחלת קומיטים נבחרים אחרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्तमान रैखिक ब्रांच में कमिट का क्रम बदलने या उन्हें मिलाने के लिए खींचें। अन्य कमिट चेरी-पिक करने के लिए HEAD ब्रांच इस्तेमाल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povucite predaje unutar trenutačne linearne grane da biste ih prerasporedili ili spojili. Koristite granu HEAD za prijenos drugih predaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A véglegesítések átrendezéséhez vagy összevonásához húzza őket az aktuális lineáris ágon belül. Más véglegesítések átemeléséhez használja a HEAD ágát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret komit dalam cabang linear saat ini untuk mengurutkan ulang atau menggabungkannya. Gunakan cabang HEAD untuk melakukan cherry-pick pada komit lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina i commit all'interno del ramo lineare attuale per riordinarli o combinarli. Usa il ramo HEAD per eseguire il cherry-pick di altri commit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の直線的なブランチ内でコミットをドラッグすると、並べ替えや結合ができます。ほかのコミットをチェリーピックするには HEAD ブランチを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 선형 브랜치 내에서 커밋을 드래그하여 순서를 바꾸거나 결합하십시오. 다른 커밋을 체리픽하려면 HEAD 브랜치를 사용하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret komit dalam cabang linear semasa untuk menyusun semula atau menggabungkannya. Gunakan cabang HEAD untuk memilih komit lain secara terpilih."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep commits binnen de huidige lineaire branch om ze te herschikken of combineren. Gebruik de HEAD-branch om andere commits te cherry-picken."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra innsjekkinger innenfor den gjeldende lineære grenen for å endre rekkefølgen eller slå dem sammen. Bruk HEAD-grenen for å plukke inn andre innsjekkinger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągaj commity w bieżącej gałęzi liniowej, aby zmienić ich kolejność lub je połączyć. Użyj gałęzi HEAD, aby wykonać cherry-pick innych commitów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste commits dentro do branch linear atual para reordená-los ou combiná-los. Use o branch HEAD para fazer cherry-pick de outros commits."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste commits dentro do branch linear atual para reordená-los ou combiná-los. Use o branch HEAD para fazer cherry-pick de outros commits."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trageți commiturile în ramura liniară curentă pentru a le reordona sau combina. Folosiți ramura HEAD pentru a aplica selectiv alte commituri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте коммиты в текущей линейной ветке, чтобы изменить их порядок или объединить. Для cherry-pick других коммитов используйте ветку HEAD."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potiahnutím commitov v aktuálnej lineárnej vetve zmeníte ich poradie alebo ich spojíte. Na prevzatie iných commitov použite vetvu HEAD."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povlecite potrditve znotraj trenutne linearne veje, da jih prerazporedite ali združite. Za prenos drugih izbranih potrditev uporabite vejo HEAD."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra incheckningar inom den aktuella linjära grenen för att ändra ordningen eller kombinera dem. Använd HEAD-grenen för att plocka in andra incheckningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากคอมมิตภายในแบรนช์ปัจจุบันที่เป็นเส้นตรงเพื่อจัดลำดับใหม่หรือรวมเข้าด้วยกัน ใช้แบรนช์ HEAD เพื่อเชอร์รีพิกคอมมิตอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıralamak veya birleştirmek için işlemeleri geçerli doğrusal dal içinde sürükleyin. Diğer işlemeleri seçerek uygulamak için HEAD dalını kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягуйте коміти в поточній лінійній гілці, щоб змінити їх порядок або обʼєднати. Щоб зробити cherry-pick інших комітів, використовуйте гілку HEAD."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo commit trong nhánh tuyến tính hiện tại để sắp xếp lại hoặc gộp. Dùng nhánh HEAD để chọn áp dụng commit khác."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在目前的線性分支內拖移提交以重新排序或合併。使用 HEAD 分支來揀選其他提交。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在当前线性分支内拖移提交以重新排序或合并它们。使用 HEAD 分支拣选其他提交。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在目前的線性分支內拖移提交以重新排序或合併。使用 HEAD 分支來揀選其他提交。"
          }
        }
      }
    },
