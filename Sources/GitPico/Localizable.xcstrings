    "Open Authentication in an active GitPico window to sign in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح المصادقة في نافذة GitPico نشطة لتسجيل الدخول."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obre Autenticació en una finestra activa de GitPico per iniciar sessió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro přihlášení otevřete Ověřování v aktivním okně GitPico."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn Godkendelse i et aktivt GitPico-vindue for at logge ind."
