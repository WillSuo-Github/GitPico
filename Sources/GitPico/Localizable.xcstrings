    "Includes staged changes. Unstaged files remain in the working copy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتضمن التغييرات المجهزة. تبقى الملفات غير المجهزة في نسخة العمل."
          }
        },
        "ca" : {
