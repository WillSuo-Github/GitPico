    "These files match ignore rules. Force Add puts them into the index; review their paths before continuing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطابق هذه الملفات قواعد التجاهل. تضعها الإضافة القسرية في الفهرس؛ راجع مساراتها قبل المتابعة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquests fitxers coincideixen amb regles d'exclusió. Força l'addició els afegeix a l'índex; revisa'n els camins abans de continuar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto soubory odpovídají pravidlům ignorování. Vynutit přidání je vloží do indexu; před pokračováním zkontrolujte jejich cesty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse filer matcher ignoreringsregler. Gennemtving tilføjelse føjer dem til indekset. Gennemgå deres stier, før du fortsætter."
