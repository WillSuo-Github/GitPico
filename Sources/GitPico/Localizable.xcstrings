    "Manage HTTPS accounts in Settings → Authentication. SSH uses your existing agent and host verification." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدِر حسابات HTTPS في الإعدادات → المصادقة. يستخدم SSH وكيلك الحالي والتحقق من المضيف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona els comptes HTTPS a Configuració → Autenticació. SSH fa servir l'agent i la verificació d'amfitrions existents."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účty HTTPS spravujte v Nastavení → Ověřování. SSH používá stávajícího agenta a ověřování hostitele."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrer HTTPS-konti i Indstillinger → Godkendelse. SSH bruger din eksisterende agent og værtsbekræftelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS-Accounts verwaltest du unter „Einstellungen → Authentifizierung“. SSH nutzt deinen vorhandenen Agent und die Hostprüfung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαχειριστείτε τους λογαριασμούς HTTPS στις Ρυθμίσεις → Έλεγχος ταυτότητας. Το SSH χρησιμοποιεί τον υπάρχοντα πράκτορα και την επαλήθευση διακομιστών σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona las cuentas HTTPS en Ajustes → Autenticación. SSH usa tu agente y tu verificación de hosts existentes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administra las cuentas HTTPS en Configuración → Autenticación. SSH usa tu agente y tu verificación de hosts existentes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallitse HTTPS-tilejä kohdassa Asetukset → Todennus. SSH käyttää nykyistä agenttiasi ja palvelimen varmennusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gérez les comptes HTTPS dans Réglages → Authentification. SSH utilise votre agent et votre vérification d’hôte existants."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gérez les comptes HTTPS dans Réglages → Authentification. SSH utilise votre agent et votre vérification d’hôte existants."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניהול חשבונות HTTPS בהגדרות → אימות זהות. SSH משתמש בסוכן ובאימות המארחים הקיימים שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्ज़ → प्रमाणीकरण में HTTPS खाते प्रबंधित करें। SSH आपके मौजूदा एजेंट और होस्ट सत्यापन का उपयोग करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravljajte HTTPS računima u Postavke → Autentikacija. SSH koristi postojeći agent i provjeru poslužitelja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A HTTPS-fiókokat a Beállítások → Hitelesítés alatt kezelheti. Az SSH a meglévő ügynököt és a kiszolgáló-ellenőrzést használja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelola akun HTTPS di Pengaturan → Autentikasi. SSH menggunakan agen dan verifikasi host yang sudah ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestisci gli account HTTPS in Impostazioni → Autenticazione. SSH usa l'agente e la verifica degli host esistenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS アカウントは「設定」→「認証」で管理します。SSH は既存のエージェントとホスト検証を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → 인증에서 HTTPS 계정을 관리하십시오. SSH는 기존 에이전트와 호스트 확인을 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urus akaun HTTPS dalam Tetapan → Pengesahan. SSH menggunakan ejen dan pengesahan hos sedia ada anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beheer HTTPS-accounts in Instellingen → Authenticatie. SSH gebruikt je bestaande agent en hostverificatie."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrer HTTPS-kontoer i Innstillinger → Autentisering. SSH bruker den eksisterende agenten og vertsverifiseringen din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zarządzaj kontami HTTPS w Ustawienia → Uwierzytelnianie. SSH używa istniejącego agenta i weryfikacji hostów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerencie contas HTTPS em Ajustes → Autenticação. O SSH usa o agente e a verificação de hosts existentes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira as contas HTTPS em Definições → Autenticação. O SSH usa o agente e a verificação de hosts existentes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrați conturile HTTPS în Configurări → Autentificare. SSH folosește agentul și verificarea gazdelor existente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляйте учётными записями HTTPS в разделе «Настройки → Аутентификация». SSH использует ваш существующий агент и проверку хостов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účty HTTPS spravujte v Nastavenia → Overovanie. SSH používa váš existujúci agent a overovanie hostiteľa."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Račune HTTPS upravljajte v Nastavitve → Preverjanje pristnosti. SSH uporablja obstoječega posrednika in preverjanje gostiteljev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hantera HTTPS-konton i Inställningar → Autentisering. SSH använder din befintliga agent och verifiering av värdar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จัดการบัญชี HTTPS ในการตั้งค่า → การยืนยันตัวตน SSH ใช้เอเจนต์และการตรวจสอบโฮสต์ที่มีอยู่ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS hesaplarını Ayarlar → Kimlik Doğrulama'da yönetin. SSH, mevcut aracınızı ve sunucu doğrulamasını kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Керуйте обліковими записами HTTPS у розділі Параметри → Автентифікація. SSH використовує ваш наявний агент і перевірку хостів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quản lý tài khoản HTTPS trong Cài đặt → Xác thực. SSH dùng Agent và xác minh máy chủ hiện có."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定」→「認證」中管理 HTTPS 帳户。SSH 會使用你現有的代理程式與主機驗證。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”→“认证”中管理 HTTPS 账户。SSH 使用你现有的代理和主机验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定」→「認證」中管理 HTTPS 帳號。SSH 會使用你現有的代理程式與主機驗證。"
          }
        }
      }
