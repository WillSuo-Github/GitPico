    "Creates a new commit reversing these changes and preserves existing history. If conflicts occur, resolve them and use Continue or Abort." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ إيداعًا جديدًا يعكس هذه التغييرات ويحافظ على السجل الموجود. إذا حدثت تعارضات، فحلّها واستخدم «متابعة» أو «إجهاض»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un commit nou que reverteix aquests canvis i conserva l'historial existent. Si hi ha conflictes, resol-los i fes servir Continua o Avorta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvoří nový commit, který vrátí tyto změny, a zachová stávající historii. Pokud dojde ke konfliktům, vyřešte je a použijte Pokračovat nebo Přerušit."
          }
        },
        "da" : {
          "stringUnit" : {
