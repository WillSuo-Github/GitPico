    "Stash shelves local changes so you can switch tasks and bring them back later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ المخبأ التغييرات المحلية جانبًا لتبديل المهام وإعادتها لاحقًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reserva desa temporalment els canvis locals perquè puguis canviar de tasca i recuperar-los més endavant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odložení změn uschová místní změny, abyste mohli přepnout úlohu a později je vrátit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem lokale ændringer midlertidigt, så du kan skifte opgave og hente dem frem igen senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Stash legt lokale Änderungen beiseite, damit du die Aufgabe wechseln und sie später zurückholen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η προσωρινή αποθήκευση βάζει στην άκρη τοπικές αλλαγές ώστε να αλλάξετε εργασία και να τις επαναφέρετε αργότερα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El stash aparta los cambios locales para que puedas cambiar de tarea y recuperarlos más tarde."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El stash aparta los cambios locales para que puedas cambiar de tarea y recuperarlos más tarde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kätkö siirtää paikalliset muutokset talteen, jotta voit vaihtaa tehtävää ja palauttaa ne myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La remise met de côté les modifications locales pour vous permettre de changer de tâche et de les récupérer plus tard."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La remise met de côté les modifications locales pour vous permettre de changer de tâche et de les récupérer plus tard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אחסון זמני שומר בצד שינויים מקומיים כדי לאפשר מעבר למשימה אחרת והחזרתם בהמשך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्टैश स्थानीय बदलावों को अलग सहेज देता है, ताकि आप दूसरा काम कर सकें और बाद में उन्हें वापस ला सकें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privremeno spremanje odlaže lokalne promjene da biste mogli promijeniti zadatak i kasnije ih vratiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Félretétel elmenti a helyi változásokat, így más feladatra válthat, és később visszaállíthatja őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpanan menyimpan sementara perubahan lokal agar Anda dapat beralih tugas dan memulihkannya nanti."
          }
        },
        "it" : {
          "stringUnit" : {
