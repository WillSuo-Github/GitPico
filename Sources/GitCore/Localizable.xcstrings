    "Reuse preserves the existing branch and index. Choose its current branch or leave the branch field empty." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحافظ إعادة الاستخدام على الفرع والفهرس الموجودين. اختر فرعه الحالي أو اترك حقل الفرع فارغًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reutilització conserva la branca i l'índex existents. Tria la seva branca actual o deixa el camp de branca buit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opětovné použití zachová stávající větev a index. Vyberte aktuální větev nebo nechte pole větve prázdné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genbrug bevarer den eksisterende gren og indekset. Vælg den aktuelle gren, eller lad grenfeltet stå tomt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiederverwendung behält den vorhandenen Branch und Index. Wähle seinen aktuellen Branch oder lass das Branch-Feld leer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επαναχρησιμοποίηση διατηρεί τον υπάρχοντα κλάδο και το ευρετήριο. Επιλέξτε τον τρέχοντα κλάδο του ή αφήστε το πεδίο κλάδου κενό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reutilizar conserva la rama y el índice existentes. Elige su rama actual o deja vacío el campo de rama."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reutilizar conserva la rama y el índice existentes. Elige su rama actual o deja vacío el campo de rama."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudelleenkäyttö säilyttää nykyisen haaran ja indeksin. Valitse sen nykyinen haara tai jätä haarakenttä tyhjäksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réutilisation préserve la branche et l’index existants. Choisissez sa branche actuelle ou laissez le champ de branche vide."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réutilisation préserve la branche et l’index existants. Choisissez sa branche actuelle ou laissez le champ de branche vide."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שימוש חוזר שומר על הענף והאינדקס הקיימים. יש לבחור בענף הנוכחי שלו או להשאיר את שדה הענף ריק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फिर इस्तेमाल करने पर मौजूदा ब्रांच और इंडेक्स सुरक्षित रहते हैं। इसकी मौजूदा ब्रांच चुनें या ब्रांच फ़ील्ड खाली छोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponovna uporaba čuva postojeću granu i indeks. Odaberite trenutačnu granu ili ostavite polje grane prazno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az újrafelhasználás megőrzi a meglévő ágat és indexet. Válassza a jelenlegi ágát, vagy hagyja üresen az ág mezőjét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penggunaan ulang mempertahankan cabang dan indeks yang ada. Pilih cabangnya saat ini atau kosongkan kolom cabang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riutilizzo mantiene il ramo e l'indice esistenti. Scegli il suo ramo attuale o lascia vuoto il campo del ramo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再利用すると既存のブランチとインデックスが保持されます。現在のブランチを選択するか、ブランチのフィールドを空のままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재사용하면 기존 브랜치와 인덱스가 보존됩니다. 현재 브랜치를 선택하거나 브랜치 필드를 비워 두십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penggunaan semula mengekalkan cabang dan indeks sedia ada. Pilih cabang semasanya atau biarkan medan cabang kosong."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hergebruik behoudt de bestaande branch en index. Kies de huidige branch of laat het branchveld leeg."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenbruk bevarer den eksisterende grenen og indeksen. Velg gjeldende gren eller la grenfeltet stå tomt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponowne użycie zachowuje istniejącą gałąź i indeks. Wybierz jej bieżącą gałąź lub pozostaw pole gałęzi puste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reutilizar preserva o branch e o índice existentes. Escolha o branch atual dele ou deixe o campo de branch vazio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reutilizar preserva o branch e o índice existentes. Escolha o branch atual dele ou deixe o campo de branch vazio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reutilizarea păstrează ramura și indexul existente. Alegeți ramura sa curentă sau lăsați câmpul ramurii gol."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторное использование сохраняет существующую ветку и индекс. Выберите её текущую ветку или оставьте поле ветки пустым."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opätovné použitie zachová existujúcu vetvu a index. Vyberte jeho aktuálnu vetvu alebo nechajte pole vetvy prázdne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponovna uporaba ohrani obstoječo vejo in indeks. Izberite njeno trenutno vejo ali pustite polje veje prazno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vid återanvändning behålls den befintliga grenen och indexet. Välj den aktuella grenen eller lämna grenfältet tomt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การใช้ซ้ำจะคงแบรนช์และดัชนีเดิมไว้ เลือกแบรนช์ปัจจุบันหรือเว้นช่องแบรนช์ว่างไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden kullanım, mevcut dalı ve indeksi korur. Geçerli dalını seçin veya dal alanını boş bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторне використання зберігає наявну гілку й індекс. Виберіть її поточну гілку або залиште поле гілки порожнім."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng lại giữ nguyên nhánh và chỉ mục hiện có. Chọn nhánh hiện tại hoặc để trống trường nhánh."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重複使用會保留現有的分支與索引。請選擇其目前分支，或將分支欄位留空。"
