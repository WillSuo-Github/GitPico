          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לפתוח מחדש חלק מהמאגרים השמורים. הכרטיסיות שלהם נשמרו לצורך שחזור:\n%@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ सहेजी गई रिपॉज़िटरी दोबारा नहीं खोली जा सकीं। रिकवरी के लिए उनके टैब रखे गए हैं:\n%@"
          }
        },
        "hr" : {
          "stringUnit" : {
