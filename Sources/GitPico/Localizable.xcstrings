    "Git or the server may already have changed. Review the refreshed state before retrying. Push and Pull are never retried automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما تغير Git أو الخادم بالفعل. راجع الحالة المحدثة قبل إعادة المحاولة. لا يُعاد الدفع والسحب تلقائيًا أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git o el servidor ja poden haver canviat. Revisa l'estat actualitzat abans de tornar-ho a provar. La pujada i la baixada no es reintenten mai automàticament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stav Git nebo serveru se již mohl změnit. Před dalším pokusem zkontrolujte obnovený stav. Odesílání a stahování se nikdy automaticky neopakují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git eller serveren kan allerede være ændret. Gennemgå den opdaterede tilstand, før du prøver igen. Afsendelse samt hentning og integration forsøges aldrig igen automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git oder der Server hat sich möglicherweise bereits geändert. Prüfe den aktualisierten Zustand, bevor du es erneut versuchst. Push und Pull werden nie automatisch wiederholt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Git ή ο διακομιστής μπορεί να έχουν ήδη αλλάξει. Ελέγξτε την ανανεωμένη κατάσταση πριν δοκιμάσετε ξανά. Η ώθηση και η άντληση δεν επαναλαμβάνονται ποτέ αυτόματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que Git o el servidor ya hayan cambiado. Revisa el estado actualizado antes de reintentar. Push y Pull nunca se reintentan automáticamente."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que Git o el servidor ya hayan cambiado. Revisa el estado actualizado antes de reintentar. Push y Pull nunca se reintentan automáticamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git tai palvelin on saattanut jo muuttua. Tarkista päivitetty tila ennen uutta yritystä. Lähettämistä ja vetämistä ei koskaan yritetä uudelleen automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git ou le serveur a peut-être déjà changé. Examinez l’état actualisé avant de réessayer. Pousser et Tirer ne sont jamais relancés automatiquement."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git ou le serveur a peut-être déjà changé. Examinez l’état actualisé avant de réessayer. Pousser et Tirer ne sont jamais relancés automatiquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייתכן ש־Git או השרת כבר השתנו. יש לבדוק את המצב המרוענן לפני ניסיון חוזר. דחיפה ומשיכה לעולם אינן מבוצעות שוב אוטומטית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git या सर्वर पहले ही बदल चुका हो सकता है। दोबारा कोशिश करने से पहले रीफ़्रेश की गई स्थिति की समीक्षा करें। पुश और पुल अपने आप दोबारा नहीं किए जाते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git ili poslužitelj možda su se već promijenili. Pregledajte osvježeno stanje prije ponovnog pokušaja. Slanje i povlačenje nikada se ne ponavljaju automatski."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Git vagy a kiszolgáló állapota már megváltozhatott. Újrapróbálkozás előtt tekintse át a frissített állapotot. A Feltöltés és a Lehúzás soha nem indul újra automatikusan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git atau server mungkin sudah berubah. Tinjau keadaan yang telah disegarkan sebelum mencoba lagi. Dorong dan Tarik tidak pernah dicoba ulang secara otomatis."
