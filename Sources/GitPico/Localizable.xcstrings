    "Recovery records are stored in this repository. Restoring never replaces an existing branch, tag or remote name." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزن سجلات الاسترداد في هذا المستودع. لا تستبدل الاستعادة اسم فرع أو وسم أو مستودع بعيد موجود أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els registres de recuperació s'emmagatzemen en aquest repositori. La restauració no substitueix mai cap nom de branca, etiqueta o remot existent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záznamy obnovy jsou uloženy v tomto repozitáři. Obnova nikdy nenahradí existující název větve, značky nebo vzdáleného repozitáře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gendannelsesposter gemmes i dette kodelager. Gendannelse erstatter aldrig en eksisterende gren, et eksisterende tag eller et eksisterende fjernlagernavn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederherstellungseinträge werden in diesem Repository gespeichert. Die Wiederherstellung ersetzt nie einen vorhandenen Branch-, Tag- oder Remote-Namen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εγγραφές ανάκτησης αποθηκεύονται σε αυτό το αποθετήριο. Η επαναφορά δεν αντικαθιστά ποτέ υπάρχον όνομα κλάδου, ετικέτας ή απομακρυσμένου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros de recuperación se guardan en este repositorio. La restauración nunca sustituye un nombre de rama, etiqueta o remoto existente."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros de recuperación se guardan en este repositorio. La restauración nunca reemplaza un nombre de rama, etiqueta o remoto existente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautustietueet säilytetään tässä tietovarastossa. Palauttaminen ei koskaan korvaa olemassa olevaa haaran, tunnisteen tai etätietovaraston nimeä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements de récupération sont stockés dans ce dépôt. La restauration ne remplace jamais une branche, une étiquette ou un nom de dépôt distant existant."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
