    "For Add and Move, choose a new folder outside existing worktrees. Repair requires the relocated folder with its original .git file." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للإضافة والنقل، اختر مجلدًا جديدًا خارج أشجار العمل الموجودة. يتطلب الإصلاح المجلد المنقول مع ملف .git الأصلي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per afegir i moure, tria una carpeta nova fora dels arbres de treball existents. La reparació requereix la carpeta reubicada amb el seu fitxer .git original."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro přidání a přesun vyberte novou složku mimo stávající pracovní stromy. Oprava vyžaduje přesunutou složku s původním souborem .git."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en ny mappe uden for eksisterende arbejdstræer til Tilføj og Flyt. Reparation kræver den flyttede mappe med dens oprindelige .git-fil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle für „Hinzufügen“ und „Bewegen“ einen neuen Ordner außerhalb vorhandener Worktrees. „Reparieren“ erfordert den verschobenen Ordner mit seiner ursprünglichen .git-Datei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για Προσθήκη και Μετακίνηση, επιλέξτε νέο φάκελο εκτός υπαρχόντων δέντρων εργασίας. Η Επισκευή απαιτεί τον μεταφερμένο φάκελο με το αρχικό του αρχείο .git."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para Añadir y Mover, elige una carpeta nueva fuera de los worktrees existentes. Reparar requiere la carpeta reubicada con su archivo .git original."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para Agregar y Mover, elige una carpeta nueva fuera de los worktrees existentes. Reparar requiere la carpeta reubicada con su archivo .git original."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse lisäämistä ja siirtämistä varten uusi kansio nykyisten työpuiden ulkopuolelta. Korjaaminen edellyttää siirrettyä kansiota ja sen alkuperäistä .git-tiedostoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour Ajouter et Déplacer, choisissez un nouveau dossier en dehors des arbres de travail existants. Réparer nécessite le dossier déplacé avec son fichier .git d’origine."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour Ajouter et Déplacer, choisissez un nouveau dossier en dehors des arbres de travail existants. Réparer nécessite le dossier déplacé avec son fichier .git d’origine."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להוספה ולהעברה יש לבחור תיקייה חדשה מחוץ לעצי עבודה קיימים. תיקון דורש את התיקייה שהועברה עם קובץ ה־.git המקורי שלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जोड़ने और स्थानांतरित करने के लिए मौजूदा वर्कट्री के बाहर नया फ़ोल्डर चुनें। मरम्मत के लिए स्थानांतरित फ़ोल्डर में उसकी मूल .git फ़ाइल होनी चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za dodavanje i premještanje odaberite novu mapu izvan postojećih radnih stabala. Popravak zahtijeva premještenu mapu s izvornom datotekom .git."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Hozzáadás és az Áthelyezés művelethez válasszon új mappát a meglévő munkafákon kívül. A Javítás művelethez az áthelyezett mappa és annak eredeti .git fájlja szükséges."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk Tambah dan Pindahkan, pilih folder baru di luar pohon kerja yang ada. Perbaiki memerlukan folder yang telah dipindahkan beserta file .git aslinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per Aggiungi e Sposta, scegli una nuova cartella al di fuori dei worktree esistenti. La riparazione richiede la cartella spostata con il suo file .git originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「追加」と「移動」では、既存のワークツリーの外にある新しいフォルダを選択してください。修復には、元の .git ファイルを含む移動後のフォルダが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가 및 이동의 경우 기존 워크트리 밖의 새 폴더를 선택하십시오. 복구에는 원래 .git 파일이 있는 재배치된 폴더가 필요합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk Tambah dan Pindah, pilih folder baharu di luar pepohon kerja sedia ada. Baiki memerlukan folder yang telah dipindahkan bersama fail .git asalnya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies voor toevoegen en verplaatsen een nieuwe map buiten bestaande worktrees. Reparatie vereist de verplaatste map met het oorspronkelijke .git-bestand."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For Legg til og Flytt velger du en ny mappe utenfor eksisterende arbeidstrær. Reparasjon krever den flyttede mappen med den opprinnelige .git-filen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla Dodaj i Przenieś wybierz nowy folder poza istniejącymi drzewami roboczymi. Naprawa wymaga przeniesionego folderu z jego oryginalnym plikiem .git."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para Adicionar e Mover, escolha uma nova pasta fora das worktrees existentes. Reparar requer a pasta realocada com o arquivo .git original."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para Adicionar e Mover, escolha uma nova pasta fora das worktrees existentes. Reparar requer a pasta relocalizada com o ficheiro .git original."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru Adaugă și Mută, alegeți un dosar nou în afara arborilor de lucru existenți. Repararea necesită dosarul mutat cu fișierul .git original."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для добавления и перемещения выберите новую папку вне существующих рабочих деревьев. Для восстановления нужна перемещённая папка с исходным файлом .git."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre Pridať a Presunúť vyberte nový priečinok mimo existujúcich pracovných stromov. Oprava vyžaduje premiestnený priečinok s pôvodným súborom .git."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za dodajanje in premikanje izberite novo mapo zunaj obstoječih delovnih dreves. Popravilo zahteva premaknjeno mapo z izvirno datoteko .git."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För Lägg till och Flytta väljer du en ny mapp utanför befintliga arbetsträd. Reparation kräver den flyttade mappen med dess ursprungliga .git-fil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำหรับเพิ่มและย้าย ให้เลือกโฟลเดอร์ใหม่นอกเวิร์กทรีที่มีอยู่ การซ่อมแซมต้องใช้โฟลเดอร์ที่ย้ายไปพร้อมไฟล์ .git เดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekle ve Taşı için mevcut çalışma ağaçları dışında yeni bir klasör seçin. Onarım için özgün .git dosyasını içeren, yeri değiştirilmiş klasör gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для додавання й переміщення виберіть нову папку поза наявними робочими деревами. Для відновлення потрібна переміщена папка з її початковим файлом .git."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để Thêm và Di chuyển, chọn thư mục mới ngoài các cây làm việc hiện có. Sửa chữa yêu cầu thư mục đã di chuyển có tệp .git gốc."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「加入」與「移動」請選擇位於現有工作樹之外的新檔案夾。「修復」需要含有其原始 .git 檔案的已重新定位檔案夾。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于“添加”和“移动”，请在现有工作树之外选择新文件夹。“修复”需要包含原始 .git 文件的已重新定位文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「加入」與「移動」請選擇位於現有工作樹之外的新檔案夾。「修復」需要含有其原始 .git 檔案的已重新定位檔案夾。"
          }
        }
      }
    },
