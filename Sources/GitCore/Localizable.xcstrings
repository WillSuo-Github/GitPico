          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löytyi useita aiempia pääpolkuja. Anna alkuperäisen päätietovaraston polku erikseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs chemins principaux précédents ont été trouvés. Indiquez explicitement le chemin d’origine du dépôt principal."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs chemins principaux précédents ont été trouvés. Indiquez explicitement le chemin d’origine du dépôt principal."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נמצאו כמה נתיבים קודמים של המאגר הראשי. יש לציין במפורש את נתיב המאגר הראשי המקורי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कई पुराने मुख्य पथ मिले। मूल मुख्य रिपॉज़िटरी का पथ स्पष्ट रूप से दें।"
