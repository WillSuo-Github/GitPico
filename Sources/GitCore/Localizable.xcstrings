    "Remove embedded passwords from the remote URL before opening the hosting website." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أزل كلمات المرور المضمنة من عنوان URL للمستودع البعيد قبل فتح موقع الاستضافة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina les contrasenyes integrades de l'URL remot abans d'obrir el lloc web d'allotjament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před otevřením webu hostingu odstraňte vložená hesla z URL vzdáleného repozitáře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjern indlejrede adgangskoder fra fjernlagerets URL, før du åbner udbyderens websted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entferne eingebettete Passwörter aus der Remote-URL, bevor du die Hosting-Website öffnest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρέστε τους ενσωματωμένους κωδικούς πρόσβασης από το URL απομακρυσμένου πριν ανοίξετε τον ιστότοπο φιλοξενίας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina las contraseñas incrustadas de la URL del remoto antes de abrir el sitio web de alojamiento."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina las contraseñas incorporadas de la URL del remoto antes de abrir el sitio web de alojamiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista etätietovaraston URL-osoitteeseen sisältyvät salasanat ennen palveluntarjoajan verkkosivuston avaamista."
          }
        },
        "fr" : {
