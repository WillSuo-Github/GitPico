          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauration remplacerait un fichier non suivi ou ignoré dans %@. Choisissez un nouveau chemin ou déplacez-le d’abord."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauration remplacerait un fichier non suivi ou ignoré dans %@. Choisissez un nouveau chemin ou déplacez-le d’abord."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השחזור יחליף קובץ שאינו במעקב או שנמצא בכללי התעלמות ב־%@. יש לבחור נתיב חדש או להעביר אותו הצדה תחילה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहाल करने पर %@ पर मौजूद अनट्रैक या अनदेखी की गई फ़ाइल बदल जाएगी। नया पथ चुनें या पहले उसे कहीं और ले जाएँ।"
