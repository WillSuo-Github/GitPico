    "Selecting a profile applies it to the current repository's local Git configuration. Other repositories retain their identities." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطبّق تحديد ملف تعريف هويته على إعدادات Git المحلية للمستودع الحالي. تحتفظ المستودعات الأخرى بهوياتها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccionar un perfil l'aplica a la configuració local de Git del repositori actual. Els altres repositoris conserven les seves identitats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výběrem profilu jej použijete v místní konfiguraci Git aktuálního repozitáře. Ostatní repozitáře si své identity zachovají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du vælger en profil, anvendes den i det aktuelle kodelagers lokale Git-konfiguration. Andre kodelagre beholder deres identiteter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Auswählen eines Profils wendet es auf die lokale Git-Konfiguration des aktuellen Repositorys an. Andere Repositorys behalten ihre Identitäten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιλογή προφίλ το εφαρμόζει στην τοπική διαμόρφωση Git του τρέχοντος αποθετηρίου. Τα άλλα αποθετήρια διατηρούν τις ταυτότητές τους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al seleccionar un perfil se aplica a la configuración Git local del repositorio actual. Los demás repositorios conservan sus identidades."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al seleccionar un perfil se aplica a la configuración Git local del repositorio actual. Los demás repositorios conservan sus identidades."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiilin valinta ottaa sen käyttöön nykyisen tietovaraston paikallisissa Git-asetuksissa. Muiden tietovarastojen tekijätiedot säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sélection d’un profil l’applique à la configuration Git locale du dépôt actuel. Les autres dépôts conservent leurs identités."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sélection d’un profil l’applique à la configuration Git locale du dépôt actuel. Les autres dépôts conservent leurs identités."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחירת פרופיל מחילה אותו על הגדרות Git המקומיות של המאגר הנוכחי. מאגרים אחרים שומרים על הזהויות שלהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोफ़ाइल चुनने पर वह मौजूदा रिपॉज़िटरी के स्थानीय Git कॉन्फ़िगरेशन पर लागू होती है। अन्य रिपॉज़िटरी की पहचान बनी रहती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odabir profila primjenjuje ga na lokalnu Git konfiguraciju trenutačnog repozitorija. Ostali repozitoriji zadržavaju svoje identitete."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiválasztott profil az aktuális tároló helyi Git-beállításaira lesz alkalmazva. A többi tároló megőrzi az identitását."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memilih profil akan menerapkannya ke konfigurasi Git lokal repositori saat ini. Repositori lain tetap menggunakan identitasnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La selezione di un profilo lo applica alla configurazione Git locale del repository attuale. Gli altri repository mantengono le loro identità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルを選択すると、現在のリポジトリのローカルの Git 構成に適用されます。ほかのリポジトリでは元の ID が保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필을 선택하면 현재 저장소의 로컬 Git 구성에 적용됩니다. 다른 저장소는 각자의 신원 정보를 유지합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemilihan profil menerapkannya pada konfigurasi Git setempat repositori semasa. Repositori lain mengekalkan identiti masing-masing."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je een profiel selecteert, wordt het toegepast op de lokale Git-configuratie van de huidige repository. Andere repositories behouden hun identiteit."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du velger en profil, brukes den i den lokale Git-konfigurasjonen til gjeldende kodelager. Andre kodelagre beholder identitetene sine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybór profilu stosuje go do lokalnej konfiguracji Git bieżącego repozytorium. Inne repozytoria zachowują swoje tożsamości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecionar um perfil o aplica à configuração Git local do repositório atual. Outros repositórios mantêm suas identidades."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A seleção de um perfil aplica-o à configuração Git local do repositório atual. Os outros repositórios mantêm as suas identidades."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selectarea unui profil îl aplică în configurarea Git locală a depozitului curent. Celelalte depozite își păstrează identitățile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбор профиля применяет его к локальной конфигурации Git текущего репозитория. Другие репозитории сохраняют свои данные автора."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výberom profilu sa profil použije v lokálnej konfigurácii Git aktuálneho repozitára. Ostatné repozitáre si ponechajú svoje identity."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbira profila ga uporabi v lokalnih nastavitvah Git trenutnega repozitorija. Drugi repozitoriji ohranijo svoje identitete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du väljer en profil tillämpas den på det aktuella arkivets lokala Git-konfiguration. Andra arkiv behåller sina identiteter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเลือกโปรไฟล์จะนำไปใช้กับการกำหนดค่า Git ภายในคลังปัจจุบัน คลังอื่นจะยังใช้ข้อมูลประจำตัวเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil seçmek, profili geçerli deponun yerel Git yapılandırmasına uygular. Diğer depolar kimliklerini korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибір профілю застосовує його до локальної конфігурації Git поточного репозиторію. Інші репозиторії зберігають свої ідентичності."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn hồ sơ sẽ áp dụng hồ sơ đó vào cấu hình Git cục bộ của kho hiện tại. Các kho khác giữ nguyên danh tính."
          }
        },
        "zh-HK" : {
