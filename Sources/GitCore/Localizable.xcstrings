    "Text inspection supports UTF-8 files up to 2 MB. Binary and larger files cannot be displayed here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدعم فحص النص ملفات UTF-8 حتى 2 ميغابايت. لا يمكن عرض الملفات الثنائية والأكبر هنا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La inspecció de text admet fitxers UTF-8 de fins a 2 MB. Aquí no es poden mostrar fitxers binaris ni més grans."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prohlížení textu podporuje soubory UTF-8 do 2 MB. Binární a větší soubory zde nelze zobrazit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstvisning understøtter UTF-8-filer på op til 2 MB. Binære og større filer kan ikke vises her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Textprüfung unterstützt UTF-8-Dateien bis 2 MB. Binäre und größere Dateien können hier nicht angezeigt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο έλεγχος κειμένου υποστηρίζει αρχεία UTF-8 έως 2 MB. Δυαδικά και μεγαλύτερα αρχεία δεν μπορούν να εμφανιστούν εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La inspección de texto admite archivos UTF-8 de hasta 2 MB. Los archivos binarios y más grandes no se pueden mostrar aquí."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La inspección de texto admite archivos UTF-8 de hasta 2 MB. Los archivos binarios y más grandes no se pueden mostrar aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstin tarkastelu tukee enintään 2 Mt:n UTF-8-tiedostoja. Binääritiedostoja ja suurempia tiedostoja ei voida näyttää tässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’inspection du texte prend en charge les fichiers UTF-8 jusqu’à 2 Mo. Les fichiers binaires et plus volumineux ne peuvent pas être affichés ici."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’inspection du texte prend en charge les fichiers UTF-8 jusqu’à 2 Mo. Les fichiers binaires et plus volumineux ne peuvent pas être affichés ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בדיקת טקסט תומכת בקובצי UTF-8 בגודל של עד 2 MB. לא ניתן להציג כאן קבצים בינאריים או גדולים יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेक्स्ट निरीक्षण में 2 MB तक की UTF-8 फ़ाइलें समर्थित हैं। बाइनरी और बड़ी फ़ाइलें यहाँ नहीं दिखाई जा सकतीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregled teksta podržava UTF-8 datoteke do 2 MB. Binarne i veće datoteke ovdje se ne mogu prikazati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szöveges vizsgálat legfeljebb 2 MB méretű UTF-8-fájlokat támogat. A bináris és a nagyobb fájlok itt nem jeleníthetők meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemeriksaan teks mendukung file UTF-8 hingga 2 MB. File biner dan file yang lebih besar tidak dapat ditampilkan di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ispezione del testo supporta file UTF-8 fino a 2 MB. I file binari e più grandi non possono essere mostrati qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストの確認は 2 MB までの UTF-8 ファイルに対応しています。バイナリやそれより大きいファイルはここに表示できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 검사는 2MB 이하의 UTF-8 파일을 지원합니다. 바이너리 및 더 큰 파일은 여기에 표시할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemeriksaan teks menyokong fail UTF-8 sehingga 2 MB. Fail perduaan dan fail yang lebih besar tidak boleh dipaparkan di sini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstinspectie ondersteunt UTF-8-bestanden van maximaal 2 MB. Binaire en grotere bestanden kunnen hier niet worden weergegeven."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstvisningen støtter UTF-8-filer på opptil 2 MB. Binærfiler og større filer kan ikke vises her."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podgląd tekstu obsługuje pliki UTF-8 o rozmiarze do 2 MB. Plików binarnych i większych nie można tutaj wyświetlić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
