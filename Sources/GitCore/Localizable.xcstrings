    "Fast-forward when possible. Create a merge commit when the branches diverge; local commit hashes are preserved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقدّم سريعًا عند الإمكان. ينشئ إيداع دمج عند تباعد الفرعين؛ ويُحتفظ بتجزئات الإيداعات المحلية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avança ràpidament quan sigui possible. Crea un commit de fusió quan les branques divergeixen; es conserven les empremtes dels commits locals."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li to možné, posune větev vpřed. Pokud se větve rozcházejí, vytvoří slučovací commit; hashe místních commitů zůstanou zachovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spol frem, når det er muligt. Opret et fletningscommit, når grenene er divergeret; lokale commithashværdier bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn möglich Fast-Forward. Bei auseinanderlaufenden Branches einen Merge-Commit erstellen; lokale Commit-Hashes bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προώθηση όπου είναι δυνατό. Δημιουργία υποβολής συγχώνευσης όταν οι κλάδοι αποκλίνουν· οι κατακερματισμοί τοπικών υποβολών διατηρούνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avance rápido cuando sea posible. Crea un commit de fusión cuando las ramas divergen; se conservan los hashes de los commits locales."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avance rápido cuando sea posible. Crea un commit de fusión cuando las ramas divergen; se conservan los hashes de los commits locales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pikakelaa eteenpäin, kun mahdollista. Luo yhdistämistallennus, kun haarat eriytyvät; paikallisten tallennusten tiivisteet säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avance rapide si possible. Crée un commit de fusion lorsque les branches divergent ; les hachages des commits locaux sont conservés."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avance rapide si possible. Crée un commit de fusion lorsque les branches divergent; les hachages des commits locaux sont conservés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קידום מהיר כשאפשר. יצירת קומיט מיזוג כשהענפים מתפצלים; מזהי הקומיטים המקומיים נשמרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संभव होने पर फ़ास्ट-फ़ॉरवर्ड करें। ब्रांच अलग दिशाओं में बढ़ने पर मर्ज कमिट बनाएँ; स्थानीय कमिट हैश सुरक्षित रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premota unaprijed kad je moguće. Stvara predaju spajanja kada se grane raziđu; sažeci lokalnih predaja su sačuvani."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha lehetséges, gyors előreléptetést végez. Az ágak szétválásakor egyesítési véglegesítést hoz létre; a helyi véglegesítések hashértékei megmaradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Majukan langsung jika memungkinkan. Buat komit penggabungan saat cabang menyimpang; hash komit lokal dipertahankan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanzamento rapido quando possibile. Crea un commit di unione quando i rami divergono; gli hash dei commit locali vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能な場合は早送りします。ブランチが分岐している場合はマージコミットを作成します。ローカルのコミットハッシュは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가능하면 빨리 감기합니다. 브랜치가 분기되면 병합 커밋을 생성하며 로컬 커밋 해시는 보존됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maju pantas apabila boleh. Cipta komit penggabungan apabila cabang mencapah; hash komit setempat dikekalkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer waar mogelijk een fast-forward uit. Maak een mergecommit als de branches uiteenlopen; lokale commithashes blijven behouden."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spol fremover når det er mulig. Opprett en sammenslåingsinnsjekking når grenene har skilt lag. Hashverdiene til lokale innsjekkinger beholdes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewiń do przodu, gdy to możliwe. Utwórz commit scalenia, gdy gałęzie się rozeszły; skróty lokalnych commitów zostają zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avançar rapidamente quando possível. Criar um commit de merge quando os branches divergirem; os hashes dos commits locais são preservados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avançar rapidamente quando possível. Criar um commit de merge quando os branches divergirem; os hashes dos commits locais são preservados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avansează rapid când este posibil. Creează un commit de îmbinare când ramurile diverg; hash-urile commiturilor locale sunt păstrate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемотка вперёд, если возможно. Если ветки разошлись, создаётся коммит слияния; хеши локальных коммитов сохраняются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je to možné, vykoná sa rýchly posun vpred. Pri rozchode vetiev sa vytvorí zlučovací commit; hashe lokálnych commitov sa zachovajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadar je mogoče, pomakne naprej. Ob razhajanju vej ustvari potrditev združevanja; zgoščene vrednosti lokalnih potrditev so ohranjene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snabbspola när det är möjligt. Skapa en sammanslagningsincheckning när grenarna har gått isär. Lokala incheckningars hashvärden bevaras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลื่อนไปข้างหน้าเมื่อทำได้ สร้างคอมมิตผสานเมื่อแบรนช์แยกจากกัน โดยคงแฮชคอมมิตในเครื่องไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mümkünse ileri sarar. Dallar ayrışırsa bir birleştirme işlemesi oluşturur; yerel işleme karmaları korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемотування вперед, якщо можливо. Створювати коміт злиття, коли гілки розійшлися; хеші локальних комітів зберігаються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiến nhanh khi có thể. Tạo commit hợp nhất khi các nhánh phân kỳ; giữ nguyên mã băm commit cục bộ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "盡可能使用快轉。分支分歧時建立合併提交；本機提交的雜湊會保留。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽可能快进。分支分叉时创建合并提交；本地提交哈希会被保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "盡可能使用快轉。分支分歧時建立合併提交；本機提交的雜湊會保留。"
          }
        }
      }
    },
