    "Commit workflow storage could not be loaded. Preserve it and reopen after repairing it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر تحميل تخزين سير عمل الإيداع. احتفظ به وأعد الفتح بعد إصلاحه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut carregar l'emmagatzematge dels fluxos de commit. Conserva'l i torna a obrir després de reparar-lo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úložiště pracovních postupů commitů se nepodařilo načíst. Uchovejte ho a po opravě znovu otevřete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lageret til commitarbejdsgange kunne ikke indlæses. Bevar det, og åbn igen, når det er repareret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speicher für Commit-Workflows konnte nicht geladen werden. Behalte ihn und öffne erneut, nachdem er repariert ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η φόρτωση του χώρου αποθήκευσης ροών υποβολής. Διατηρήστε τον και ανοίξτε ξανά μετά την επισκευή του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar el almacenamiento de flujos de commit. Consérvalo y vuelve a abrir tras repararlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar el almacenamiento de flujos de commit. Consérvalo y vuelve a abrir tras repararlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennustyönkulkujen tietoja ei voitu ladata. Säilytä ne ja avaa uudelleen korjauksen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger le stockage des workflows de commit. Conservez-le et rouvrez l’app après l’avoir réparé."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger le stockage des workflows de commit. Conservez-le et rouvrez l’app après l’avoir réparé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לטעון את אחסון תהליכי העבודה לקומיטים. יש לשמור עליו ולפתוח מחדש לאחר תיקונו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कमिट वर्कफ़्लो संग्रहण लोड नहीं हो सका। उसे सुरक्षित रखें और सुधारने के बाद फिर खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće učitati pohranu tijeka rada predaja. Sačuvajte je i ponovno otvorite nakon popravka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült betölteni a véglegesítési munkafolyamatok tárolóját. Őrizze meg, és a javítása után nyissa meg újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyimpanan alur kerja komit tidak dapat dimuat. Pertahankan penyimpanan tersebut dan buka kembali setelah diperbaiki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
