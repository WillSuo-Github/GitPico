    "Fixup message prepared. Stage the correction and commit, then use Autosquash in Interactive Rebase." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُعدّت رسالة التصحيح. جهّز التصحيح وأودعه، ثم استخدم الدمج التلقائي في إعادة التأسيس التفاعلية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Missatge de correcció preparat. Prepara la correcció i fes-ne un commit; després fes servir Agrupa automàticament a Rebase interactiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zpráva opravného commitu je připravena. Připravte opravu a vytvořte commit, poté v interaktivním přeskládání použijte automatické sloučení oprav."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskeden til rettelsescommittet er klar. Klargør rettelsen, og opret et commit. Brug derefter Automatisk sammenfoldning i Interaktiv ombasering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixup-Nachricht vorbereitet. Stage die Korrektur und committe, dann verwende Autosquash im interaktiven Rebase."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το μήνυμα διορθωτικής συνένωσης ετοιμάστηκε. Προετοιμάστε τη διόρθωση και υποβάλετέ την και χρησιμοποιήστε την Αυτόματη συνένωση στη Διαδραστική αναθεμελίωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensaje de fixup preparado. Prepara la corrección y haz commit; luego usa Autosquash en Rebase interactivo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensaje de fixup preparado. Prepara la corrección y haz commit; luego usa Autosquash en Rebase interactivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korjaustallennuksen viesti on valmisteltu. Valmistele korjaus ja tallenna se. Käytä sitten automaattista tiivistystä vuorovaikutteisessa uudelleenpohjustuksessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Message fixup préparé. Indexez la correction et validez, puis utilisez Autosquash dans Rebasage interactif."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Message fixup préparé. Indexez la correction et validez, puis utilisez Autosquash dans Rebasage interactif."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוכנה הודעת תיקון משלים. יש להכין את התיקון לקומיט וליצור קומיט, ואז להשתמש באיחוד אוטומטי בשינוי בסיס אינטראקטיבי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़िक्सअप संदेश तैयार है। सुधार स्टेज करके कमिट करें, फिर इंटरैक्टिव रीबेस में ऑटोस्क्वैश इस्तेमाल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poruka ispravka je pripremljena. Pripremite ispravak i predajte ga pa upotrijebite Automatsko sažimanje u Interaktivnom preslagivanju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A javítás üzenete elkészült. Készítse elő és véglegesítse a javítást, majd használja az Automatikus összevonás műveletet az Interaktív újraalapozás ablakban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
