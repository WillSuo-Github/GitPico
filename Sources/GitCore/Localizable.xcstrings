        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nĐã lưu tiến trình Git Flow. Giải quyết thao tác hiện tại, rồi dùng Tiếp tục Git Flow; nhánh chủ đề và lịch sử đã hoàn tất được giữ lại."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nGit Flow 進度已儲存。請解決目前的操作，然後使用「繼續 Git Flow」；主題分支與已完成的歷史記錄都會保留。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nGit Flow 进度已保存。请解决当前操作，然后使用“继续 Git Flow”；主题分支和已完成的历史记录会被保留。"
