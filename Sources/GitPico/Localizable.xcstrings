    "Versioned in .gitignore and shared with everyone who clones the repository." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُتبع في .gitignore وتُشارك مع كل من يستنسخ المستودع."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sota control de versions a .gitignore i compartit amb tothom que cloni el repositori."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzováno v .gitignore a sdíleno se všemi, kdo klonují repozitář."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versionsstyres i .gitignore og deles med alle, der kloner kodelageret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In .gitignore versioniert und mit allen geteilt, die das Repository klonen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγχεται από εκδόσεις στο .gitignore και κοινοποιείται σε όλους όσοι κλωνοποιούν το αποθετήριο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versionado en .gitignore y compartido con todos los que clonen el repositorio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
