          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βρέθηκαν πολλές προηγούμενες κύριες διαδρομές. Δώστε ρητά την αρχική διαδρομή κύριου αποθετηρίου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se encontraron varias rutas principales anteriores. Indica explícitamente la ruta original del repositorio principal."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
