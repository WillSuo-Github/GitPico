    "Moves the branch tip while preserving the index and every working file. Undoing a commit makes its changes staged again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل نهاية الفرع مع الحفاظ على الفهرس وكل ملفات العمل. يعيد التراجع عن إيداع تجهيز تغييراته."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mou la punta de la branca conservant l'índex i tots els fitxers de treball. Desfer un commit torna a deixar els seus canvis preparats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posune špičku větve a zachová index i všechny pracovní soubory. Vrácením commitu se jeho změny znovu připraví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter grenens spids og bevarer indekset og alle arbejdsfiler. Når en commit fortrydes, bliver dens ændringer klargjort igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegt die Branch-Spitze und behält Index und alle Arbeitsdateien. Wird ein Commit rückgängig gemacht, sind seine Änderungen wieder gestaget."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακινεί την κορυφή του κλάδου διατηρώντας το ευρετήριο και κάθε αρχείο εργασίας. Η αναίρεση υποβολής προετοιμάζει ξανά τις αλλαγές της."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve la punta de la rama conservando el índice y todos los archivos de trabajo. Deshacer un commit vuelve a dejar sus cambios preparados."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve la punta de la rama conservando el índice y todos los archivos de trabajo. Deshacer un commit vuelve a dejar sus cambios preparados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirtää haaran kärkeä säilyttäen indeksin ja kaikki työtiedostot. Tallennuksen kumoaminen palauttaa sen muutokset valmistelluiksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace l’extrémité de la branche en conservant l’index et chaque fichier de travail. L’annulation d’un commit remet ses modifications dans l’index."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace l’extrémité de la branche en conservant l’index et chaque fichier de travail. L’annulation d’un commit remet ses modifications dans l’index."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מזיז את קצה הענף תוך שמירה על האינדקס ועל כל קובצי העבודה. ביטול קומיט מחזיר את השינויים שלו למצב מוכן לקומיט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
