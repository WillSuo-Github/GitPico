    "The signed-in account differs from the account being renewed, or account settings changed. Add it as a separate account or reload settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يختلف الحساب المسجل دخوله عن الحساب الجاري تجديده، أو تغيرت إعدادات الحساب. أضفه كحساب منفصل أو أعد تحميل الإعدادات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El compte de la sessió iniciada difereix del compte que s'està renovant, o la configuració del compte ha canviat. Afegeix-lo com a compte separat o torna a carregar la configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlášený účet se liší od obnovovaného účtu nebo se změnilo nastavení účtu. Přidejte jej jako samostatný účet nebo znovu načtěte nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den konto, du er logget ind på, er en anden end den, der fornyes, eller kontoindstillingerne er ændret. Tilføj den som en separat konto, eller genindlæs indstillingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der angemeldete Account weicht vom zu erneuernden Account ab oder die Account-Einstellungen wurden geändert. Füge ihn als separaten Account hinzu oder lade die Einstellungen neu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο συνδεδεμένος λογαριασμός διαφέρει από τον λογαριασμό που ανανεώνεται ή οι ρυθμίσεις λογαριασμού άλλαξαν. Προσθέστε τον ως ξεχωριστό λογαριασμό ή επαναφορτώστε τις ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta con la que se inició sesión difiere de la que se está renovando, o cambiaron los ajustes de la cuenta. Añádela como cuenta aparte o vuelve a cargar los ajustes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta con la que se inició sesión difiere de la que se está renovando, o cambió la configuración de la cuenta. Agrégala como cuenta aparte o vuelve a cargar la configuración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjautunut tili eroaa uusittavasta tilistä tai tilin asetukset muuttuivat. Lisää se erillisenä tilinä tai lataa asetukset uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte connecté diffère du compte en cours de renouvellement, ou les réglages du compte ont changé. Ajoutez-le comme compte distinct ou rechargez les réglages."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte connecté diffère du compte en cours de renouvellement, ou les réglages du compte ont changé. Ajoutez-le comme compte distinct ou rechargez les réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החשבון שהתחבר שונה מהחשבון שמתחדש, או שהגדרות החשבון השתנו. יש להוסיף אותו כחשבון נפרד או לטעון מחדש את ההגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन इन किया गया खाता नवीनीकृत किए जा रहे खाते से अलग है या खाते की सेटिंग्ज़ बदल गई हैं। इसे अलग खाते के रूप में जोड़ें या सेटिंग्ज़ फिर लोड करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavljeni račun razlikuje se od računa koji se obnavlja ili su postavke računa promijenjene. Dodajte ga kao zaseban račun ili ponovno učitajte postavke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bejelentkezett fiók eltér a megújítandó fióktól, vagy a fiókbeállítások megváltoztak. Adja hozzá külön fiókként, vagy töltse újra a beállításokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun yang masuk berbeda dari akun yang sedang diperbarui, atau pengaturan akun berubah. Tambahkan sebagai akun terpisah atau muat ulang pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'account con cui hai effettuato l'accesso è diverso da quello in rinnovo oppure le impostazioni dell'account sono cambiate. Aggiungilo come account separato o ricarica le impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインしたアカウントが更新対象のアカウントと異なるか、アカウント設定が変更されました。別のアカウントとして追加するか、設定を再読み込みしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인한 계정이 갱신 중인 계정과 다르거나 계정 설정이 변경되었습니다. 별도의 계정으로 추가하거나 설정을 다시 불러오십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akaun yang dilog masuk berbeza daripada akaun yang diperbaharui, atau tetapan akaun telah berubah. Tambahkannya sebagai akaun berasingan atau muat semula tetapan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het ingelogde account wijkt af van het account dat wordt vernieuwd of de accountinstellingen zijn gewijzigd. Voeg het toe als een apart account of laad de instellingen opnieuw."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den innloggede kontoen er en annen enn kontoen som fornyes, eller kontoinnstillingene er endret. Legg den til som en egen konto, eller last inn innstillingene på nytt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zalogowane konto różni się od odnawianego konta lub ustawienia kont zmieniły się. Dodaj je jako osobne konto lub wczytaj ponownie ustawienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conta conectada difere da conta sendo renovada ou os ajustes da conta foram alterados. Adicione-a como conta separada ou recarregue os ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conta associada difere da conta cuja autorização está a ser renovada ou as definições da conta foram alteradas. Adicione-a como conta separada ou recarregue as definições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contul autentificat diferă de contul reînnoit sau configurările contului s-au modificat. Adăugați-l ca un cont separat sau reîncărcați configurările."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учётная запись, в которую выполнен вход, отличается от продлеваемой, или настройки учётных записей изменились. Добавьте её как отдельную учётную запись или перезагрузите настройки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prihlásený účet sa líši od obnovovaného účtu alebo sa zmenili nastavenia účtu. Pridajte ho ako samostatný účet alebo znova načítajte nastavenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavljeni račun se razlikuje od računa, ki se obnavlja, ali pa so se spremenile nastavitve računa. Dodajte ga kot ločen račun ali znova naložite nastavitve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det inloggade kontot skiljer sig från kontot som förnyas, eller så har kontoinställningarna ändrats. Lägg till det som ett separat konto eller läs in inställningarna igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บัญชีที่ลงชื่อเข้าใช้ต่างจากบัญชีที่กำลังต่ออายุ หรือการตั้งค่าบัญชีเปลี่ยนไป เพิ่มเป็นบัญชีแยกต่างหากหรือโหลดการตั้งค่าใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş yapılan hesap yenilenen hesaptan farklı veya hesap ayarları değişti. Ayrı bir hesap olarak ekleyin ya da ayarları yeniden yükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обліковий запис, у який виконано вхід, відрізняється від поновлюваного, або параметри облікового запису змінилися. Додайте його як окремий обліковий запис або перезавантажте параметри."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản đăng nhập khác với tài khoản đang gia hạn hoặc cài đặt tài khoản đã thay đổi. Thêm thành tài khoản riêng hoặc tải lại cài đặt."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已登入的帳户與正在更新的帳户不同，或帳户設定已更改。請將其加入為獨立的帳户，或重新載入設定。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已登录的账户与正在续订的账户不同，或账户设置已更改。请将其添加为单独的账户或重新载入设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已登入的帳號與正在更新的帳號不同，或帳號設定已更改。請將其加入為獨立的帳號，或重新載入設定。"
          }
        }
      }
    },
    "The staged changes or commit mode changed. Generate a new message." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
