    "Restore would replace an untracked or ignored file at %@. Choose a new path or move it aside first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستستبدل الاستعادة ملفًا غير متتبع أو متجاهل في %@. اختر مسارًا جديدًا أو انقله جانبًا أولًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauració substituiria un fitxer sense seguiment o ignorat a %@. Tria un camí nou o mou-lo abans a una altra ubicació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnova by nahradila nesledovaný nebo ignorovaný soubor v %@. Zvolte novou cestu nebo jej nejprve přesuňte jinam."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gendannelse ville erstatte en usporet eller ignoreret fil på %@. Vælg en ny sti, eller flyt først filen til en anden placering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiederherstellung würde eine nicht verfolgte oder ignorierte Datei in %@ ersetzen. Wähle einen neuen Pfad oder verschiebe sie zuerst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επαναφορά θα αντικαθιστούσε μη παρακολουθούμενο ή αγνοημένο αρχείο στο %@. Επιλέξτε νέα διαδρομή ή μετακινήστε το πρώτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauración sustituiría un archivo sin seguimiento o ignorado en %@. Elige una ruta nueva o apártalo primero."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauración reemplazaría un archivo sin seguimiento o ignorado en %@. Elige una ruta nueva o apártalo primero."
          }
        },
        "fi" : {
          "stringUnit" : {
