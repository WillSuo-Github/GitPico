    "Rebase replays the current branch's commits onto the selected branch and changes their hashes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعيد عملية إعادة التأسيس تطبيق إيداعات الفرع الحالي على الفرع المحدد وتغير تجزئاتها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rebase reaplica els commits de la branca actual sobre la branca seleccionada i en canvia les empremtes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přeskládání znovu použije commity aktuální větve na vybrané větvi a změní jejich hashe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombasering genafspiller den aktuelle grens commits på den valgte gren og ændrer deres hashværdier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebase wendet die Commits des aktuellen Branches erneut auf den ausgewählten Branch an und ändert ihre Hashes."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναθεμελίωση επανεκτελεί τις υποβολές του τρέχοντος κλάδου στον επιλεγμένο κλάδο και αλλάζει τους κατακερματισμούς τους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rebase reaplica los commits de la rama actual sobre la rama seleccionada y cambia sus hashes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rebase reaplica los commits de la rama actual sobre la rama seleccionada y cambia sus hashes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudelleenpohjustus toistaa nykyisen haaran tallennukset valitun haaran päälle ja muuttaa niiden tiivisteitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rebasage rejoue les commits de la branche actuelle sur la branche sélectionnée et modifie leurs hachages."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rebasage rejoue les commits de la branche actuelle sur la branche sélectionnée et modifie leurs hachages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שינוי בסיס מחיל מחדש את הקומיטים של הענף הנוכחי על הענף שנבחר ומשנה את המזהים שלהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रीबेस मौजूदा ब्रांच के कमिट चुनी गई ब्रांच पर फिर लागू करता है और उनके हैश बदल देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preslagivanje ponovno primjenjuje predaje trenutačne grane na odabranu granu i mijenja njihove sažetke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az újraalapozás újra alkalmazza az aktuális ág véglegesítéseit a kijelölt ágra, és megváltoztatja a hashértékeiket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebase menerapkan ulang komit cabang saat ini ke cabang yang dipilih dan mengubah hash komit tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rebase riapplica i commit del ramo attuale sul ramo selezionato e ne cambia gli hash."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リベースは現在のブランチのコミットを選択したブランチの上に再適用し、それらのハッシュを変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리베이스는 현재 브랜치의 커밋을 선택한 브랜치 위에 재실행하며 해당 해시를 변경합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengasasan semula menerapkan semula komit cabang semasa pada cabang yang dipilih dan mengubah cincang komit tersebut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebase past de commits van de huidige branch opnieuw toe op de geselecteerde branch en wijzigt hun hashes."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombasering legger innsjekkingene fra gjeldende gren på den valgte grenen og endrer hashverdiene deres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana bazy odtwarza commity bieżącej gałęzi na zaznaczonej gałęzi i zmienia ich skróty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O rebase reaplica os commits do branch atual sobre o branch selecionado e altera os hashes deles."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O rebase reaplica os commits do branch atual sobre o branch selecionado e altera os hashes deles."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebazarea reaplică commiturile ramurii curente pe ramura selectată și le modifică hash-urile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перебазирование повторно применяет коммиты текущей ветки поверх выбранной ветки и меняет их хеши."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prebázovanie znova použije commity aktuálnej vetvy na vybranej vetve a zmení ich hashe."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prebaziranje znova uveljavi potrditve trenutne veje na izbrani veji in spremeni njihove zgoščene vrednosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombasering tillämpar den aktuella grenens incheckningar på den valda grenen och ändrar deras hashvärden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การรีเบสจะนำคอมมิตของแบรนช์ปัจจุบันไปใช้ซ้ำบนแบรนช์ที่เลือก และเปลี่ยนค่าแฮชของคอมมิตเหล่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden temellendirme, geçerli dalın işlemelerini seçili dala yeniden uygular ve karmalarını değiştirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перебазування повторно застосовує коміти поточної гілки поверх вибраної гілки й змінює їхні хеші."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebase phát lại các commit của nhánh hiện tại lên nhánh đã chọn và thay đổi mã băm của chúng."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重定基底會將目前分支的提交重播到選取的分支上，並更改它們的雜湊。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "变基会将当前分支的提交重放到所选分支上，并更改它们的哈希。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重定基底會將目前分支的提交重播到選取的分支上，並更改它們的雜湊。"
          }
        }
      }
    },
