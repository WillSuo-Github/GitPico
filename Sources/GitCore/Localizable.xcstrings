          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โมดูลย่อยจะถูกส่งออกเป็นไดเรกทอรีว่าง โดยไม่รวมคลังแยกของโมดูลย่อย"
