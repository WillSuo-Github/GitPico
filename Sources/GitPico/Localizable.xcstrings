    "Remove deletes this app's local credential. Revoke the provider grant from your authorized applications to withdraw server access." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحذف الإزالة بيانات الاعتماد المحلية لهذا التطبيق. ألغِ منحة المزوّد من تطبيقاتك المفوضة لسحب الوصول إلى الخادم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar suprimeix la credencial local d'aquesta app. Revoca el permís del proveïdor des de les aplicacions autoritzades per retirar l'accés al servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebráním se smažou místní přihlašovací údaje této aplikace. Chcete-li zrušit přístup k serveru, odvolejte oprávnění poskytovatele v seznamu autorizovaných aplikací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjernelse sletter appens lokale legitimationsoplysninger. Tilbagekald udbyderens tilladelse under dine godkendte apps for at fjerne serveradgangen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Entfernen“ löscht die lokalen Anmeldedaten dieser App. Widerrufe die Freigabe beim Anbieter in deinen autorisierten Anwendungen, um den Serverzugriff zu entziehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αφαίρεση διαγράφει το τοπικό διαπιστευτήριο αυτής της εφαρμογής. Ανακαλέστε την άδεια του παρόχου από τις εξουσιοδοτημένες εφαρμογές σας για να αποσύρετε την πρόσβαση στον διακομιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar borra la credencial local de esta app. Revoca la concesión del proveedor en tus aplicaciones autorizadas para retirar el acceso al servidor."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción elimina la credencial local de la app. Revoca el permiso del proveedor en tus aplicaciones autorizadas para retirar el acceso al servidor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaminen poistaa tämän sovelluksen paikallisen tunnistetiedon. Peru palveluntarjoajan käyttöoikeus valtuutetuista sovelluksista estääksesi palvelimen käytön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer efface l’identifiant local de cette app. Révoquez l’autorisation du fournisseur dans vos applications autorisées pour retirer l’accès au serveur."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer efface l’identifiant local de cette app. Révoquez l’autorisation du fournisseur dans vos applications autorisées pour retirer l’accès au serveur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההסרה מוחקת את האישור המקומי של יישום זה. כדי לבטל גישה לשרת, יש לבטל את הרשאת הספק ברשימת היישומים המורשים שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हटाने पर इस ऐप का स्थानीय क्रेडेंशियल मिट जाता है। सर्वर की पहुँच समाप्त करने के लिए अपने अधिकृत ऐप्स में प्रदाता की दी गई अनुमति रद्द करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanjanje briše lokalnu vjerodajnicu ove aplikacije. Opozovite odobrenje pružatelja u autoriziranim aplikacijama za ukidanje pristupa poslužitelju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Eltávolítás törli az alkalmazás helyi hitelesítő adatát. A szerverhozzáférés megszüntetéséhez vonja vissza a szolgáltató engedélyét az engedélyezett alkalmazások között."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus menghapus kredensial lokal aplikasi ini. Cabut izin penyedia dari daftar aplikasi yang Anda izinkan untuk mencabut akses server."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovi elimina la credenziale locale di questa app. Revoca l'autorizzazione del provider dalle applicazioni autorizzate per ritirare l'accesso al server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除すると、この App のローカルの資格情報が削除されます。サーバへのアクセスを取り消すには、認証済みアプリケーションからプロバイダの許可を取り消してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제거하면 이 앱의 로컬 자격 증명이 삭제됩니다. 서버 접근을 철회하려면 승인된 애플리케이션에서 제공업체 권한을 취소하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluarkan memadamkan butiran kelayakan setempat aplikasi ini. Batalkan kebenaran penyedia daripada aplikasi yang anda benarkan untuk menarik balik akses pelayan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderen wist de lokale inloggegevens van deze app. Trek de toestemming bij je geautoriseerde apps van de aanbieder in om servertoegang in te trekken."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerning sletter appens lokale påloggingsopplysninger. Trekk tilbake tilgangen under autoriserte applikasjoner hos leverandøren for å oppheve servertilgangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń kasuje lokalne dane uwierzytelniające tej aplikacji. Aby wycofać dostęp do serwera, cofnij zgodę dostawcy w autoryzowanych aplikacjach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover apaga a credencial local deste app. Revogue a concessão nos aplicativos autorizados do provedor para retirar o acesso ao servidor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover apaga a credencial local desta aplicação. Revogue a autorização nas aplicações autorizadas do fornecedor para retirar o acesso ao servidor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminarea șterge acreditarea locală a acestei aplicații. Revocați autorizarea furnizorului din aplicațiile autorizate pentru a retrage accesul la server."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление стирает локальные учётные данные этого приложения. Чтобы отозвать доступ к серверу, отзовите разрешение у провайдера в списке авторизованных приложений."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstránením sa vymaže lokálny prihlasovací údaj tejto aplikácie. Ak chcete zrušiť prístup na server, odvolajte oprávnenie u poskytovateľa v zozname autorizovaných aplikácií."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstranitev izbriše lokalno poverilnico te aplikacije. Za odvzem strežniškega dostopa prekličite odobritev ponudnika med pooblaščenimi aplikacijami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du tar bort kontot raderas appens lokala inloggningsuppgift. Återkalla leverantörens behörighet bland dina auktoriserade appar för att dra tillbaka åtkomsten till servern."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเอาออกจะลบข้อมูลรับรองในเครื่องของแอปนี้ เพิกถอนสิทธิ์ที่ผู้ให้บริการมอบให้จากรายการแอปที่ได้รับอนุญาตเพื่อยกเลิกการเข้าถึงเซิร์ฟเวอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaldır, bu uygulamanın yerel kimlik bilgisini siler. Sunucu erişimini kaldırmak için yetkili uygulamalarınızdan sağlayıcı iznini iptal edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вилучення видаляє локальні облікові дані цієї програми. Щоб скасувати доступ до сервера, відкличте дозвіл постачальника в списку авторизованих застосунків."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa sẽ xóa thông tin xác thực cục bộ của ứng dụng này. Thu hồi ủy quyền của nhà cung cấp trong các ứng dụng được ủy quyền để rút quyền truy cập máy chủ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「移除」會刪除此 App 的本機憑證。若要撤回伺服器存取權，請從你的已授權應用程式中撤銷服務提供者的授權。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“移除”会删除此 App 的本地凭证。若要撤销服务器访问权限，请在已授权的应用程序中撤销提供方授权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「移除」會刪除此 App 的本機憑證。若要撤回伺服器存取權，請從你的已授權應用程式中撤銷服務提供者的授權。"
          }
        }
      }
    },
