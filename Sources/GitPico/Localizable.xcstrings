          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versionné dans .gitignore et partagé avec toutes les personnes qui clonent le dépôt."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versionné dans .gitignore et partagé avec toutes les personnes qui clonent le dépôt."
          }
        },
        "he" : {
          "stringUnit" : {
