    "Restore supports up to 512 regular files. Links and submodules cannot be restored here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدعم الاستعادة حتى 512 ملفًا عاديًا. لا يمكن استعادة الروابط والوحدات الفرعية هنا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauració admet fins a 512 fitxers normals. Aquí no es poden restaurar enllaços ni submòduls."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnova podporuje až 512 běžných souborů. Odkazy a podmoduly zde nelze obnovit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gendannelse understøtter op til 512 almindelige filer. Links og undermoduler kan ikke gendannes her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiederherstellung unterstützt bis zu 512 reguläre Dateien. Links und Submodule können hier nicht wiederhergestellt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επαναφορά υποστηρίζει έως 512 κανονικά αρχεία. Σύνδεσμοι και υπομονάδες δεν μπορούν να επαναφερθούν εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauración admite hasta 512 archivos normales. Los enlaces y submódulos no se pueden restaurar aquí."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauración admite hasta 512 archivos normales. Los enlaces y submódulos no se pueden restaurar aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit palauttaa enintään 512 tavallista tiedostoa. Linkkejä ja alimoduuleja ei voi palauttaa tässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauration prend en charge jusqu’à 512 fichiers standard. Les liens et les sous-modules ne peuvent pas être restaurés ici."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauration prend en charge jusqu’à 512 fichiers standard. Les liens et les sous-modules ne peuvent pas être restaurés ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השחזור תומך בעד 512 קבצים רגילים. לא ניתן לשחזר כאן קישורים ותת־מודולים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अधिकतम 512 सामान्य फ़ाइलें बहाल की जा सकती हैं। लिंक और सबमॉड्यूल यहाँ बहाल नहीं किए जा सकते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnova podržava do 512 običnih datoteka. Poveznice i podmoduli ne mogu se obnoviti ovdje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legfeljebb 512 normál fájl állítható vissza. Hivatkozások és almodulok itt nem állíthatók vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemulihan mendukung hingga 512 file biasa. Tautan dan submodul tidak dapat dipulihkan di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ripristino supporta fino a 512 file normali. Link e sottomoduli non possono essere ripristinati qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元は最大 512 個の通常ファイルまで対応しています。リンクとサブモジュールはここでは復元できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복원은 최대 512개의 일반 파일을 지원합니다. 링크와 서브모듈은 여기에서 복원할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemulihan menyokong sehingga 512 fail biasa. Pautan dan submodul tidak boleh dipulihkan di sini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terugzetten ondersteunt maximaal 512 normale bestanden. Links en submodules kunnen hier niet worden teruggezet."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan gjenopprette opptil 512 vanlige filer. Lenker og undermoduler kan ikke gjenopprettes her."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywracanie obsługuje do 512 zwykłych plików. Dowiązań i modułów podrzędnych nie można tutaj przywrócić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A restauração aceita até 512 arquivos comuns. Links e submódulos não podem ser restaurados aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O restauro aceita até 512 ficheiros comuns. Ligações e submódulos não podem ser restaurados aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurarea acceptă până la 512 fișiere obișnuite. Legăturile și submodulele nu pot fi restaurate aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление поддерживает до 512 обычных файлов. Ссылки и подмодули здесь восстановить нельзя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnova podporuje najviac 512 bežných súborov. Odkazy a podmoduly tu nemožno obnoviť."
          }
        },
        "sl" : {
          "stringUnit" : {
