    "Exports app/build and repository state counts. File contents, raw logs, names, paths, URLs and credentials are excluded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصدّر أعداد حالات التطبيق/البناء والمستودع. تُستبعد محتويات الملفات والسجلات الخام والأسماء والمسارات وعناوين URL وبيانات الاعتماد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta recomptes de l'estat de l'app/compilació i del repositori. S'exclouen el contingut dels fitxers, els registres en brut, els noms, els camins, els URL i les credencials."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportuje stav aplikace a sestavení a počty položek stavu repozitáře. Obsah souborů, nezpracované protokoly, názvy, cesty, URL a přihlašovací údaje jsou vyloučeny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporterer oplysninger om appen og dens build samt optællinger af kodelagerets tilstand. Filindhold, rå logfiler, navne, stier, URL'er og loginoplysninger udelades."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiert App-/Build-Informationen und Repository-Statuszahlen. Dateiinhalte, Rohprotokolle, Namen, Pfade, URLs und Anmeldedaten sind ausgeschlossen."
          }
        },
        "el" : {
          "stringUnit" : {
