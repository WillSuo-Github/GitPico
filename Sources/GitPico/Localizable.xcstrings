    "\nGitPico was closed before completion was recorded. Inspect the repository and remote before retrying." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nأُغلق GitPico قبل تسجيل الاكتمال. افحص المستودع والمستودع البعيد قبل إعادة المحاولة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico s'ha tancat abans de registrar la finalització. Inspecciona el repositori i el remot abans de tornar-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico byl zavřen před zaznamenáním dokončení. Před dalším pokusem zkontrolujte místní i vzdálený repozitář."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico blev lukket, før afslutningen blev registreret. Kontrollér kodelageret og fjernlageret, før du prøver igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico wurde beendet, bevor der Abschluss erfasst wurde. Prüfe Repository und Remote, bevor du es erneut versuchst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nΤο GitPico έκλεισε πριν καταγραφεί η ολοκλήρωση. Ελέγξτε το αποθετήριο και το απομακρυσμένο πριν δοκιμάσετε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico se cerró antes de registrar la finalización. Revisa el repositorio y el remoto antes de reintentar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico se cerró antes de registrar la finalización. Revisa el repositorio y el remoto antes de reintentar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico suljettiin ennen valmistumisen kirjaamista. Tarkista tietovarasto ja etätietovarasto ennen uutta yritystä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico a été fermé avant que l’achèvement soit enregistré. Inspectez le dépôt et le dépôt distant avant de réessayer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico a été fermé avant que l’achèvement soit enregistré. Inspectez le dépôt et le dépôt distant avant de réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico נסגר לפני שתועדה השלמת הפעולה. יש לבדוק את המאגר המקומי והמרוחק לפני ניסיון חוזר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nपूरा होने का रिकॉर्ड बनने से पहले GitPico बंद हो गया था। फिर से कोशिश करने से पहले रिपॉज़िटरी और रिमोट जाँचें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico je zatvoren prije bilježenja dovršetka. Provjerite repozitorij i udaljeni repozitorij prije ponovnog pokušaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nA GitPico bezárult a befejezés rögzítése előtt. Újrapróbálkozás előtt ellenőrizze a tárolót és a távoli tárolót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico ditutup sebelum penyelesaian dicatat. Periksa repositori dan repositori jarak jauh sebelum mencoba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico è stato chiuso prima che il completamento venisse registrato. Controlla il repository e il remoto prima di riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n完了が記録される前に GitPico が終了しました。再試行する前にリポジトリとリモートを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n완료가 기록되기 전에 GitPico가 종료되었습니다. 다시 시도하기 전에 저장소와 원격을 확인하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico ditutup sebelum penyelesaian direkodkan. Periksa repositori dan repositori jauh sebelum mencuba lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico is gesloten voordat de voltooiing werd vastgelegd. Controleer de repository en de remote voordat je het opnieuw probeert."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico ble lukket før fullføringen ble registrert. Kontroller kodelageret og fjernlageret før du prøver igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico zostało zamknięte przed zapisaniem zakończenia. Sprawdź repozytorium i zdalne repozytorium przed ponowną próbą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nO GitPico foi fechado antes de a conclusão ser registrada. Inspecione o repositório e o remoto antes de tentar novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nO GitPico foi fechado antes de a conclusão ser registada. Inspecione o repositório e o remoto antes de tentar novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico a fost închis înainte de înregistrarea finalizării. Verificați depozitul și depozitul la distanță înainte de a reîncerca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico был закрыт до записи результата. Проверьте репозиторий и удалённый репозиторий перед повтором."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico sa zatvorilo pred zaznamenaním dokončenia. Pred opakovaním skontrolujte repozitár a vzdialený repozitár."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico se je zaprl, preden je bil zabeležen zaključek. Pred ponovnim poskusom preglejte repozitorij in oddaljeni repozitorij."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico stängdes innan slutförandet registrerades. Kontrollera arkivet och fjärrarkivet innan du försöker igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico ถูกปิดก่อนบันทึกว่าดำเนินการเสร็จ ตรวจสอบคลังและรีโมตก่อนลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico, tamamlanma kaydedilmeden kapatıldı. Yeniden denemeden önce depoyu ve uzak depoyu inceleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico було закрито до того, як завершення було записано. Перевірте репозиторій і віддалений репозиторій, перш ніж повторити спробу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico đã đóng trước khi ghi nhận hoàn tất. Kiểm tra kho và kho từ xa trước khi thử lại."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico 在記錄完成之前已關閉。請先檢查儲存庫與遠端，再重試。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico 在记录完成前被关闭。请先检查仓库和远程仓库再重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGitPico 在記錄完成之前已關閉。請先檢查儲存庫與遠端，再重試。"
          }
        }
      }
    },
