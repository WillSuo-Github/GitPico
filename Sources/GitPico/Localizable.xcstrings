          "stringUnit" : {
            "state" : "translated",
            "value" : "Git ovdje bilježi svaki lokalni pomak HEAD i grane kako bi se izgubljene predaje mogle oporaviti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Git itt rögzíti a HEAD és az ágak minden helyi elmozdulását, így az elveszett véglegesítések helyreállíthatók."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git mencatat setiap perpindahan HEAD dan cabang lokal di sini, sehingga komit yang hilang dapat dipulihkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git registra qui ogni spostamento locale di HEAD e dei rami, così i commit persi possono essere recuperati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git はローカルの HEAD とブランチの移動をすべてここに記録するため、失われたコミットを復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git은 모든 로컬 HEAD 및 브랜치 이동을 여기에 기록하므로 잃어버린 커밋을 복구할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git merekodkan setiap pergerakan HEAD dan cabang setempat di sini supaya komit yang hilang boleh dipulihkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git legt hier elke lokale verplaatsing van HEAD en branches vast, zodat verloren commits kunnen worden hersteld."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git registrerer alle lokale flyttinger av HEAD og grener her, slik at tapte innsjekkinger kan gjenopprettes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git zapisuje tutaj każdy ruch lokalnego HEAD i gałęzi, dzięki czemu utracone commity można odzyskać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Git registra aqui cada movimento local do HEAD e dos branches, para que commits perdidos possam ser recuperados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Git regista aqui cada movimento local do HEAD e dos branches, para que commits perdidos possam ser recuperados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git înregistrează aici fiecare deplasare locală a HEAD și a ramurilor, astfel încât commiturile pierdute să poată fi recuperate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git записывает здесь каждое перемещение локального HEAD и веток, поэтому потерянные коммиты можно восстановить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git tu zaznamenáva každý lokálny pohyb HEAD a vetiev, aby sa stratené commity dali obnoviť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git tukaj zabeleži vsak lokalni premik HEAD in vej, da je mogoče obnoviti izgubljene potrditve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git registrerar alla lokala förflyttningar av HEAD och grenar här, så att förlorade incheckningar kan återställas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git บันทึกการย้าย HEAD และแบรนช์ในเครื่องทุกครั้งไว้ที่นี่ จึงกู้คืนคอมมิตที่สูญหายได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git, kayıp işlemelerin kurtarılabilmesi için her yerel HEAD ve dal hareketini buraya kaydeder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git записує тут кожне переміщення локального HEAD і гілок, тож втрачені коміти можна відновити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git ghi lại mọi lần di chuyển HEAD và nhánh cục bộ tại đây để có thể khôi phục commit bị mất."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git 會在此記錄每次本機 HEAD 與分支的移動，以便復原遺失的提交。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git 会在此处记录每次本地 HEAD 和分支移动，以便恢复丢失的提交。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git 會在此記錄每次本機 HEAD 與分支的移動，以便復原遺失的提交。"
          }
        }
      }
