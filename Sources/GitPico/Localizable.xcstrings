    "The complete saved parent index and the listed configuration files are restored. A stale preview is rejected. No commit or network operation is performed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستعاد فهرس المستودع الأصل المحفوظ كاملًا وملفات الإعدادات المدرجة. تُرفض المعاينة القديمة. لا يُجرى إيداع أو عملية شبكة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es restauren tot l'índex desat del pare i els fitxers de configuració indicats. Es rebutja una previsualització desactualitzada. No es fa cap commit ni operació de xarxa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnoví se celý uložený index nadřazeného repozitáře a uvedené konfigurační soubory. Zastaralý náhled bude odmítnut. Neprovede se žádný commit ani síťová operace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hele det gemte indeks fra det overordnede kodelager og de angivne konfigurationsfiler gendannes. En forældet forhåndsvisning afvises. Der oprettes ingen commit og udføres ingen netværkshandling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der vollständige gesicherte Parent-Index und die aufgeführten Konfigurationsdateien werden wiederhergestellt. Eine veraltete Vorschau wird abgelehnt. Es wird kein Commit und kein Netzwerkvorgang ausgeführt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαναφέρεται ολόκληρο το αποθηκευμένο γονικό ευρετήριο και τα αναφερόμενα αρχεία διαμόρφωσης. Μια παρωχημένη προεπισκόπηση απορρίπτεται. Δεν εκτελείται υποβολή ή λειτουργία δικτύου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se restauran el índice completo guardado del padre y los archivos de configuración indicados. Una vista previa obsoleta se rechaza. No se realiza ningún commit ni operación de red."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se restauran el índice completo guardado del padre y los archivos de configuración indicados. Una vista previa obsoleta se rechaza. No se realiza ningún commit ni operación de red."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ylemmän tietovaraston koko tallennettu indeksi ja luetellut asetustiedostot palautetaan. Vanhentunut esikatselu hylätään. Tallennusta tai verkkotoimintoa ei suoriteta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’index parent enregistré complet et les fichiers de configuration indiqués sont restaurés. Un aperçu obsolète est rejeté. Aucun commit ni aucune opération réseau n’est effectué."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’index parent enregistré complet et les fichiers de configuration indiqués sont restaurés. Un aperçu obsolète est rejeté. Aucun commit ni aucune opération réseau n’est effectué."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האינדקס השמור המלא של ההורה וקובצי ההגדרות הרשומים משוחזרים. תצוגה מקדימה שאינה עדכנית נדחית. לא מתבצעת פעולת קומיט או רשת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजा गया पूरा पैरेंट इंडेक्स और सूचीबद्ध कॉन्फ़िगरेशन फ़ाइलें बहाल की जाती हैं। पुराना पूर्वावलोकन अस्वीकार कर दिया जाता है। कोई कमिट या नेटवर्क कार्रवाई नहीं की जाती।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnavljaju se cijeli spremljeni indeks nadređenog repozitorija i navedene konfiguracijske datoteke. Zastarjeli pregled se odbija. Ne izvršava se predaja ni mrežna operacija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szülő teljes mentett indexe és a felsorolt konfigurációs fájlok visszaállnak. Az elavult előnézetet a rendszer elutasítja. Nem történik véglegesítés vagy hálózati művelet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seluruh indeks induk yang tersimpan dan file konfigurasi yang tercantum dipulihkan. Pratinjau yang kedaluwarsa ditolak. Tidak ada komit atau operasi jaringan yang dilakukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono ripristinati l'indice completo del genitore salvato e i file di configurazione elencati. Un'anteprima non aggiornata viene rifiutata. Non viene eseguito alcun commit né alcuna operazione di rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された親の完全なインデックスと一覧の構成ファイルが復元されます。古いプレビューは拒否されます。コミットやネットワーク操作は実行されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 전체 상위 인덱스와 나열된 구성 파일이 복원됩니다. 오래된 미리보기는 거부됩니다. 커밋이나 네트워크 작업은 수행되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keseluruhan indeks induk yang disimpan dan fail konfigurasi yang disenaraikan dipulihkan. Pratonton lapuk ditolak. Tiada komit atau operasi rangkaian dilakukan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De volledige opgeslagen index van de bovenliggende repository en de vermelde configuratiebestanden worden teruggezet. Een verouderde voorvertoning wordt geweigerd. Er wordt geen commit of netwerkbewerking uitgevoerd."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hele den lagrede indeksen til det overordnede kodelageret og de oppførte konfigurasjonsfilene gjenopprettes. En utdatert forhåndsvisning avvises. Ingen innsjekking eller nettverksoperasjon utføres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywracany jest pełny zapisany indeks repozytorium nadrzędnego i wymienione pliki konfiguracji. Nieaktualny podgląd jest odrzucany. Nie jest wykonywany żaden commit ani operacja sieciowa."
