    "Creates a branch at the stash's original base, restores its changes and index, then removes the stash after success. Requires a clean working copy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ فرعًا عند أساس المخبأ الأصلي، ويستعيد تغييراته وفهرسه، ثم يزيل المخبأ بعد النجاح. يتطلب نسخة عمل نظيفة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una branca a la base original de la reserva, en restaura els canvis i l'índex i elimina la reserva quan acaba correctament. Requereix una còpia de treball neta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvoří větev na původním základu odložených změn, obnoví změny i index a po úspěchu odložené změny odstraní. Vyžaduje čistou pracovní kopii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opretter en gren ved de gemte ændringers oprindelige udgangspunkt, gendanner ændringerne og indekset og fjerner derefter de gemte ændringer, når handlingen er gennemført. Kræver en arbejdskopi uden ændringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt einen Branch an der ursprünglichen Basis des Stashs, stellt dessen Änderungen und Index wieder her und entfernt den Stash nach Erfolg. Erfordert eine saubere Arbeitskopie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργεί κλάδο στην αρχική βάση της προσωρινής αποθήκευσης, επαναφέρει τις αλλαγές και το ευρετήριό της και αφαιρεί την προσωρινή αποθήκευση μετά την επιτυχία. Απαιτεί καθαρό αντίγραφο εργασίας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una rama en la base original del stash, restaura sus cambios y el índice, y elimina el stash si todo va bien. Requiere una copia de trabajo limpia."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una rama en la base original del stash, restaura sus cambios y el índice, y elimina el stash si todo va bien. Requiere una copia de trabajo limpia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo haaran kätkön alkuperäiseen pohjaan, palauttaa sen muutokset ja indeksin ja poistaa kätkön onnistumisen jälkeen. Vaatii puhtaan työkopion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée une branche à la base d’origine de la remise, restaure ses modifications et son index, puis supprime la remise en cas de réussite. Nécessite une copie de travail propre."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée une branche à la base d’origine de la remise, restaure ses modifications et son index, puis supprime la remise en cas de réussite. Nécessite une copie de travail propre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יוצר ענף בבסיס המקורי של האחסון הזמני, משחזר את השינויים והאינדקס שלו, ומסיר את האחסון הזמני לאחר הצלחה. נדרש עותק עבודה נקי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्टैश के मूल आधार पर ब्रांच बनाता है, उसके बदलाव और इंडेक्स बहाल करता है, फिर सफल होने पर स्टैश हटा देता है। वर्किंग कॉपी में कोई बदलाव नहीं होना चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stvara granu na izvornoj osnovi privremeno spremljenih promjena, obnavlja promjene i indeks pa nakon uspjeha uklanja privremeni zapis. Zahtijeva čistu radnu kopiju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Létrehoz egy ágat a félretétel eredeti alapjánál, visszaállítja a módosításait és az indexét, majd siker esetén eltávolítja a félretételt. Tiszta munkapéldány szükséges."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuat cabang pada dasar asli simpanan, memulihkan perubahan dan indeksnya, lalu menghapus simpanan setelah berhasil. Memerlukan salinan kerja yang bersih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un ramo sulla base originale dello stash, ne ripristina le modifiche e l'indice, poi rimuove lo stash in caso di successo. Richiede una copia di lavoro pulita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スタッシュの元のベースにブランチを作成し、変更とインデックスを復元します。成功したらスタッシュを削除します。クリーンな作業コピーが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스태시의 원래 기준에서 브랜치를 생성하고 변경 사항과 인덱스를 복원한 다음, 성공하면 스태시를 제거합니다. 깨끗한 작업 사본이 필요합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencipta cabang pada asas asal simpanan, memulihkan perubahan dan indeksnya, kemudian mengalih keluar simpanan selepas berjaya. Memerlukan salinan kerja yang bersih."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt een branch op de oorspronkelijke basis van de stash, herstelt de wijzigingen en index en verwijdert de stash zodra dit is gelukt. Vereist een schone werkkopie."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppretter en gren ved den midlertidige lagringens opprinnelige basisinnsjekking, gjenoppretter endringene og indeksen, og fjerner deretter den midlertidige lagringen hvis alt lykkes. Krever en ren arbeidskopi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzy gałąź w oryginalnej bazie schowka, przywraca jego zmiany i indeks, a następnie po powodzeniu usuwa schowek. Wymaga czystej kopii roboczej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cria um branch na base original do stash, restaura as alterações e o índice e remove o stash após o sucesso. Requer uma cópia de trabalho limpa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cria um branch na base original do stash, restaura as alterações e o índice e remove o stash após o sucesso. Requer uma cópia de trabalho limpa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creează o ramură la baza originală a stocării temporare, îi restaurează modificările și indexul, apoi elimină stocarea temporară după reușită. Necesită o copie de lucru curată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создаёт ветку в исходной базе стеша, восстанавливает его изменения и индекс, затем удаляет стеш после успешного завершения. Требуется чистая рабочая копия."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvorí vetvu na pôvodnom základe odložených zmien, obnoví ich zmeny a index a po úspechu odstráni odložené zmeny. Vyžaduje čistú pracovnú kópiu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustvari vejo na izvirni osnovi zaloge, obnovi njene spremembe in indeks ter po uspehu odstrani zalogo. Zahteva čisto delovno kopijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapar en gren vid den tillfälliga lagringens ursprungliga bas, återställer dess ändringar och index och tar sedan bort den tillfälliga lagringen när allt har lyckats. Kräver en ren arbetskopia."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างแบรนช์ที่ฐานเดิมของรายการพัก กู้คืนการเปลี่ยนแปลงและดัชนี แล้วลบรายการพักเมื่อสำเร็จ ต้องใช้สำเนาทำงานที่ไม่มีการเปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zulanın özgün temelinde bir dal oluşturur, değişikliklerini ve indeksini geri yükler, ardından başarılı olursa zulayı kaldırır. Temiz bir çalışma kopyası gerektirir."
