    "Submodule configuration, revision or local state changed. Refresh its preview." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيرت إعدادات الوحدة الفرعية أو مراجعتها أو حالتها المحلية. حدّث معاينتها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuració, la revisió o l'estat local del submòdul han canviat. Actualitza'n la previsualització."
