        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A folytatás előtt oldja fel és készítse elő a jelenlegi ütközéseket. A hátralévő lépések futtatása előtt a már elvégzett kézi egyesítés ellenőrzésre kerül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selesaikan dan siapkan konflik saat ini sebelum melanjutkan. Penggabungan manual yang sudah selesai diverifikasi sebelum langkah berikutnya dijalankan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risolvi e aggiungi allo stage i conflitti attuali prima di continuare. Un'unione manuale già completata viene verificata prima dell'esecuzione dei passaggi rimanenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続行する前に、現在のコンフリクトを解決してステージしてください。すでに完了している手動マージは、残りのステップの実行前に検証されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속하기 전에 현재 충돌을 해결하고 스테이징하십시오. 이미 완료된 수동 병합은 남은 단계가 실행되기 전에 확인됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selesaikan dan pentaskan konflik semasa sebelum meneruskan. Penggabungan manual yang sudah selesai akan disahkan sebelum langkah selebihnya dijalankan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los de huidige conflicten op en stage ze voordat je doorgaat. Een al voltooide handmatige merge wordt geverifieerd voordat de resterende stappen worden uitgevoerd."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løs gjeldende konflikter og klargjør filene før du fortsetter. En manuell sammenslåing som allerede er fullført, kontrolleres før de resterende trinnene kjøres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed kontynuowaniem rozwiąż bieżące konflikty i dodaj je do indeksu. Już ukończone ręczne scalanie jest weryfikowane przed wykonaniem pozostałych kroków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolva e prepare os conflitos atuais antes de continuar. Um merge manual já concluído é verificado antes da execução das etapas restantes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolva e prepare os conflitos atuais antes de continuar. Um merge manual já concluído é verificado antes da execução das etapas restantes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rezolvați și pregătiți conflictele curente înainte de a continua. O îmbinare manuală deja finalizată este verificată înainte de executarea pașilor rămași."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед продолжением разрешите текущие конфликты и добавьте их в индекс. Уже выполненное ручное слияние проверяется перед запуском оставшихся шагов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pred pokračovaním vyriešte a pripravte aktuálne konflikty. Už dokončené ručné zlúčenie sa overí pred spustením zvyšných krokov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pred nadaljevanjem razrešite in pripravite trenutne spore. Že zaključeno ročno združevanje se preveri pred izvedbo preostalih korakov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lös de aktuella konflikterna och mellanlagra resultatet innan du fortsätter. En redan slutförd manuell sammanslagning verifieras innan de återstående stegen körs."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แก้ไขและจัดเตรียมข้อขัดแย้งปัจจุบันก่อนดำเนินการต่อ ระบบจะตรวจสอบการผสานด้วยตนเองที่เสร็จแล้วก่อนทำขั้นตอนที่เหลือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürdürmeden önce geçerli çakışmaları çözümleyip hazırlayın. Kalan adımlar çalıştırılmadan önce tamamlanmış elle birleştirme doğrulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перш ніж продовжити, розвʼяжіть і проіндексуйте поточні конфлікти. Уже завершене ручне злиття перевіряється перед виконанням решти кроків."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giải quyết và đưa xung đột hiện tại vào vùng chờ trước khi tiếp tục. Lần hợp nhất thủ công đã hoàn tất được xác minh trước khi chạy các bước còn lại."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繼續之前請先解決並暫存目前的衝突。執行剩餘步驟前，會先驗證已完成的手動合併。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续前请解决并暂存当前冲突。已完成的手动合并会在运行剩余步骤前进行验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繼續之前請先解決並暫存目前的衝突。執行剩餘步驟前，會先驗證已完成的手動合併。"
          }
        }
      }
    },
