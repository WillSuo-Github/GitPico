            "value" : "Obnovitev podpira do 512 običajnih datotek. Povezav in podmodulov tukaj ni mogoče obnoviti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upp till 512 vanliga filer kan återställas. Länkar och undermoduler kan inte återställas här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กู้คืนไฟล์ปกติได้สูงสุด 512 ไฟล์ ไม่สามารถกู้คืนลิงก์และโมดูลย่อยที่นี่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri yükleme en fazla 512 normal dosya destekler. Bağlantılar ve alt modüller burada geri yüklenemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відновлення підтримує до 512 звичайних файлів. Посилання й підмодулі тут відновити не можна."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khôi phục hỗ trợ tối đa 512 tệp thông thường. Không thể khôi phục liên kết và mô-đun con ở đây."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復最多支援 512 個一般檔案。連結與子模組無法在此回復。"
          }
        },
