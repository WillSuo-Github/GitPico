            "value" : "Yerel uzak depo yapılandırmasını ve izleme referanslarını kaldırır. Sunucu ve dalları etkilenmez. Yapılandırma ve referans kurtarma kayıtları korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
