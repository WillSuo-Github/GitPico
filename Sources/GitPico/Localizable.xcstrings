    "Only the selected unstaged changes will be discarded. Staged contents stay in the index." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُتجاهل التغييرات المحددة غير المجهزة فقط. تبقى المحتويات المجهزة في الفهرس."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només es descartaran els canvis sense preparar seleccionats. El contingut preparat es manté a l'índex."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budou zahozeny pouze vybrané nepřipravené změny. Připravený obsah zůstane v indexu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun de valgte ændringer, som ikke er klargjort, bliver kasseret. Klargjort indhold forbliver i indekset."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die ausgewählten nicht gestageten Änderungen werden verworfen. Gestagete Inhalte bleiben im Index."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα απορριφθούν μόνο οι επιλεγμένες μη προετοιμασμένες αλλαγές. Τα προετοιμασμένα περιεχόμενα παραμένουν στο ευρετήριο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se descartarán los cambios sin preparar seleccionados. El contenido preparado permanece en el índice."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se descartarán los cambios sin preparar seleccionados. El contenido preparado permanece en el índice."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain valitut valmistelemattomat muutokset hylätään. Valmisteltu sisältö säilyy indeksissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les modifications non indexées sélectionnées seront abandonnées. Le contenu indexé reste dans l’index."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les modifications non indexées sélectionnées seront abandonnées. Le contenu indexé reste dans l’index."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק השינויים שנבחרו ושלא הוכנו לקומיט יבוטלו. תוכן שהוכן לקומיט נשאר באינדקס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल चुने गए अनस्टेज बदलाव त्यागे जाएँगे। स्टेज की गई सामग्री इंडेक्स में बनी रहेगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odbacit će se samo odabrane nepripremljene promjene. Pripremljeni sadržaj ostaje u indeksu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak a kijelölt, előkészítetlen módosítások lesznek elvetve. Az előkészített tartalom az indexben marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya perubahan terpilih yang belum disiapkan yang akan dibuang. Konten yang sudah disiapkan tetap berada dalam indeks."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno scartate solo le modifiche fuori dallo stage selezionate. I contenuti nello stage restano nell'indice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した未ステージの変更のみが破棄されます。ステージ済みの内容はインデックスに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 스테이징되지 않은 변경 사항만 버려집니다. 스테이징된 내용은 인덱스에 남습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya perubahan belum dipentaskan yang dipilih akan dibuang. Kandungan yang dipentaskan kekal dalam indeks."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen de geselecteerde niet-gestagede wijzigingen worden verworpen. Gestagede inhoud blijft in de index."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare de valgte endringene som ikke er klargjort, blir forkastet. Klargjort innhold blir værende i indeksen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odrzucone zostaną tylko zaznaczone zmiany poza indeksem. Zawartość w indeksie pozostaje w indeksie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente as alterações não preparadas selecionadas serão descartadas. O conteúdo preparado permanece no índice."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas as alterações não preparadas selecionadas serão descartadas. O conteúdo preparado permanece no índice."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se va renunța doar la modificările nepregătite selectate. Conținutul pregătit rămâne în index."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут отменены только выбранные изменения вне индекса. Содержимое индекса не изменится."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahodia sa iba vybrané nepripravené zmeny. Pripravený obsah zostane v indexe."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavržene bodo samo izbrane nepripravljene spremembe. Pripravljena vsebina ostane v indeksu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast de markerade ändringarna som inte är mellanlagrade kommer att förkastas. Mellanlagrat innehåll finns kvar i indexet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะทิ้งเฉพาะการเปลี่ยนแปลงที่ยังไม่จัดเตรียมที่เลือกไว้ เนื้อหาที่จัดเตรียมแล้วจะยังอยู่ในดัชนี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca seçili hazırlanmamış değişikliklerden vazgeçilecek. Hazırlanan içerikler indekste kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буде відкинуто лише вибрані непроіндексовані зміни. Проіндексований вміст залишиться в індексі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ các thay đổi chưa đưa vào vùng chờ đã chọn sẽ bị loại bỏ. Nội dung trong vùng chờ vẫn ở chỉ mục."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會捨棄選取的未暫存變更。已暫存的內容會留在索引中。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会放弃所选的未暂存更改。已暂存的内容保留在索引中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會捨棄選取的未暫存變更。已暫存的內容會留在索引中。"
          }
        }
      }
    },
