    "HEAD changed outside this drag. Refresh and drag again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغير HEAD خارج عملية السحب هذه. حدّث واسحب مجددًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD ha canviat fora d'aquest arrossegament. Actualitza i torna a arrossegar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD se během tohoto přetažení změnil jinou operací. Obnovte zobrazení a přetáhněte znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD blev ændret uafhængigt af denne trækhandling. Opdater, og træk igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD wurde außerhalb dieses Ziehvorgangs geändert. Aktualisiere und ziehe erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το HEAD άλλαξε εκτός αυτής της μεταφοράς. Ανανεώστε και σύρετε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD cambió fuera de este arrastre. Actualiza y vuelve a arrastrar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD cambió fuera de este arrastre. Actualiza y vuelve a arrastrar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD muuttui tämän vetämistoiminnon ulkopuolella. Päivitä ja vedä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD a changé en dehors de ce glissement. Actualisez et faites glisser à nouveau."
          }
        },
        "fr-CA" : {
