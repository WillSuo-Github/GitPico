    "Creates an isolated recovered index snapshot with a recovery commit. The current index, .gitmodules and Git configuration remain intact. Gitlinks are represented by empty module directories; no network initialization is performed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
