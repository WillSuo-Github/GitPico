          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta recuentos del estado de la app, la compilación y el repositorio. Se excluyen el contenido de los archivos, los registros sin procesar, los nombres, las rutas, las URL y las credenciales."
          }
        },
        "es-419" : {
