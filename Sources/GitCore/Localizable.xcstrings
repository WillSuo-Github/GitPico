            "state" : "translated",
            "value" : "Za ta razpon uporabite pogovorno okno Interaktivno prebaziranje z ohranjanjem združitev; prerazporejanje z vlečenjem zahteva linearni razpon."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
