        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解決されたコミットを HEAD を切り離してチェックアウトします。そのバージョンを記録するには、親の作業コピーでサブモジュールをステージしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인된 커밋을 분리된 HEAD로 체크아웃합니다. 해당 버전을 기록하려면 상위 항목의 작업 사본에서 서브모듈을 스테이징하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mendaftar keluar komit yang ditentukan dengan HEAD terpisah. Pentaskan submodul dalam Salinan Kerja induk untuk merekodkan versi tersebut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkt de gevonden commit uit met losgekoppelde HEAD. Stage de submodule in de werkkopie van de bovenliggende repository om die versie vast te leggen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekker ut den identifiserte innsjekkingen med frakoblet HEAD. Klargjør undermodulen i arbeidskopien til det overordnede kodelageret for å registrere denne versjonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przełącza na ustalony commit z odłączonym HEAD. Dodaj moduł podrzędny do indeksu w kopii roboczej repozytorium nadrzędnego, aby zapisać tę wersję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz checkout do commit resolvido com HEAD desanexado. Prepare o submódulo na Cópia de Trabalho do pai para registrar essa versão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz checkout do commit resolvido com HEAD desanexado. Prepare o submódulo na Cópia de Trabalho do pai para registar essa versão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrage commitul rezolvat cu HEAD detașat. Pregătiți submodulul în Copia de lucru a părintelui pentru a înregistra versiunea respectivă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Извлекает найденный коммит с отсоединённым HEAD. Добавьте подмодуль в индекс в рабочей копии родителя, чтобы записать эту версию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepne na vyriešený commit s odpojeným HEAD. Na zaznamenanie tejto verzie pripravte podmodul v Pracovnej kópii nadradeného repozitára."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevzame razrešeno potrditev z ločenim HEAD. Pripravite podmodul v delovni kopiji nadrejenega repozitorija, da zabeležite to različico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkar ut den identifierade incheckningen med frikopplat HEAD. Mellanlagra undermodulen i det överordnade arkivets arbetskopia för att registrera den versionen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เช็กเอาต์คอมมิตที่ระบุได้โดยแยก HEAD จัดเตรียมโมดูลย่อยในสำเนาทำงานของคลังแม่เพื่อบันทึกรุ่นนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çözümlenen işlemeyi ayrık HEAD ile kullanıma alır. Bu sürümü kaydetmek için alt modülü üst deponun Çalışma Kopyası'nda hazırlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Витягує визначений коміт із відʼєднаним HEAD. Проіндексуйте підмодуль у робочій копії батьківського репозиторію, щоб записати цю версію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkout commit đã xác định với HEAD tách rời. Đưa mô-đun con vào vùng chờ trong Bản làm việc của kho cha để ghi nhận phiên bản đó."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以分離的 HEAD 取出解析出的提交。請在上層的「工作副本」中暫存子模組以記錄該版本。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以分离 HEAD 检出解析出的提交。在父仓库的工作副本中暂存子模块以记录该版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以分離的 HEAD 取出解析出的提交。請在上層的「工作副本」中暫存子模組以記錄該版本。"
          }
        }
      }
    },
