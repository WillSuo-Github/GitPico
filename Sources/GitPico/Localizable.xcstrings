    "Server locks coordinate binary-file editing. Your configured LFS endpoint and selected HTTPS account or system SSH setup are used." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنسق أقفال الخادم تعديل الملفات الثنائية. تُستخدم نقطة نهاية LFS المضبوطة وحساب HTTPS المحدد أو إعدادات SSH للنظام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els bloquejos del servidor coordinen l'edició de fitxers binaris. Es fan servir el punt de connexió LFS configurat i el compte HTTPS seleccionat o la configuració SSH del sistema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zámky na serveru koordinují úpravy binárních souborů. Použije se nastavený koncový bod LFS a vybraný účet HTTPS nebo systémové nastavení SSH."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverlåse koordinerer redigering af binære filer. Dit konfigurerede LFS-slutpunkt og den valgte HTTPS-konto eller systemets SSH-opsætning bruges."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serversperren koordinieren die Bearbeitung von Binärdateien. Dein konfigurierter LFS-Endpunkt und der ausgewählte HTTPS-Account oder die System-SSH-Konfiguration werden verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κλειδώματα διακομιστή συντονίζουν την επεξεργασία δυαδικών αρχείων. Χρησιμοποιούνται το διαμορφωμένο τελικό σημείο LFS και ο επιλεγμένος λογαριασμός HTTPS ή οι ρυθμίσεις SSH συστήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los bloqueos del servidor coordinan la edición de archivos binarios. Se usan tu endpoint LFS configurado y la cuenta HTTPS seleccionada o la configuración SSH del sistema."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los bloqueos del servidor coordinan la edición de archivos binarios. Se usan tu endpoint LFS configurado y la cuenta HTTPS seleccionada o la configuración SSH del sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelimen lukitukset koordinoivat binääritiedostojen muokkausta. Käytössä ovat määritetty LFS-päätepiste ja valittu HTTPS-tili tai järjestelmän SSH-asetukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les verrous du serveur coordonnent la modification des fichiers binaires. Votre point de terminaison LFS configuré et le compte HTTPS sélectionné ou la configuration SSH du système sont utilisés."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les verrous du serveur coordonnent la modification des fichiers binaires. Votre point de terminaison LFS configuré et le compte HTTPS sélectionné ou la configuration SSH du système sont utilisés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נעילות שרת מתאמות עריכה של קבצים בינאריים. נעשה שימוש בנקודת הקצה של LFS שהוגדרה ובחשבון HTTPS שנבחר או בהגדרות SSH של המערכת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर लॉक बाइनरी फ़ाइलों के संपादन में तालमेल रखते हैं। आपके कॉन्फ़िगर किए गए LFS एंडपॉइंट और चुने गए HTTPS खाते या सिस्टम के SSH सेटअप का उपयोग होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaključavanja poslužitelja usklađuju uređivanje binarnih datoteka. Koriste se konfigurirana LFS krajnja točka i odabrani HTTPS račun ili sustavske SSH postavke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiszolgálói zárolások összehangolják a bináris fájlok szerkesztését. A beállított LFS-végpontot és a kiválasztott HTTPS-fiókot vagy a rendszer SSH-beállításait használják."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci server mengoordinasikan pengeditan file biner. Titik akhir LFS yang dikonfigurasi serta akun HTTPS terpilih atau pengaturan SSH sistem akan digunakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I blocchi sul server coordinano la modifica dei file binari. Vengono usati l'endpoint LFS configurato e l'account HTTPS selezionato o la configurazione SSH di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバのロックはバイナリファイルの編集を調整します。設定済みの LFS エンドポイントと、選択した HTTPS アカウントまたはシステムの SSH 設定が使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버 잠금은 바이너리 파일 편집을 조정합니다. 구성된 LFS 엔드포인트와 선택한 HTTPS 계정 또는 시스템 SSH 설정이 사용됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci pelayan menyelaraskan penyuntingan fail binari. Titik akhir LFS yang dikonfigurasikan dan akaun HTTPS terpilih atau persediaan SSH sistem anda digunakan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serververgrendelingen coördineren het bewerken van binaire bestanden. Je ingestelde LFS-endpoint en het geselecteerde HTTPS-account of de SSH-systeemconfiguratie worden gebruikt."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjenerlåser samordner redigering av binærfiler. Det konfigurerte LFS-endepunktet og den valgte HTTPS-kontoen eller systemets SSH-oppsett brukes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokady serwera koordynują edycję plików binarnych. Używany jest skonfigurowany punkt końcowy LFS oraz wybrane konto HTTPS lub systemowa konfiguracja SSH."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os bloqueios do servidor coordenam a edição de arquivos binários. São usados o endpoint LFS configurado e a conta HTTPS selecionada ou o SSH do sistema."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os bloqueios do servidor coordenam a edição de ficheiros binários. São usados o endpoint LFS configurado e a conta HTTPS selecionada ou o SSH do sistema."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocările pe server coordonează editarea fișierelor binare. Se folosesc punctul final LFS configurat și contul HTTPS selectat sau configurarea SSH a sistemului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокировки на сервере координируют редактирование двоичных файлов. Используются настроенная конечная точка LFS и выбранная учётная запись HTTPS или системная конфигурация SSH."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zámky na serveri koordinujú úpravy binárnych súborov. Používa sa nakonfigurovaný koncový bod LFS a vybraný účet HTTPS alebo systémová konfigurácia SSH."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strežniški zaklepi usklajujejo urejanje dvojiških datotek. Uporabljena sta nastavljena končna točka LFS in izbrani račun HTTPS ali sistemske nastavitve SSH."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverlås samordnar redigering av binärfiler. Din konfigurerade LFS-slutpunkt och ditt valda HTTPS-konto eller systemets SSH-konfiguration används."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การล็อกบนเซิร์ฟเวอร์ช่วยประสานการแก้ไขไฟล์ไบนารี โดยใช้ปลายทาง LFS ที่กำหนดไว้และบัญชี HTTPS ที่เลือกหรือการตั้งค่า SSH ของระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu kilitleri, ikili dosya düzenlemelerini koordine eder. Yapılandırılmış LFS uç noktanız ve seçili HTTPS hesabınız veya sistem SSH ayarlarınız kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокування на сервері координують редагування двійкових файлів. Використовуються налаштована кінцева точка LFS і вибраний обліковий запис HTTPS або системні параметри SSH."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa máy chủ điều phối việc sửa tệp nhị phân. Dùng điểm cuối LFS đã cấu hình và tài khoản HTTPS đã chọn hoặc cấu hình SSH hệ thống."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器鎖定可協調二進位檔案的編輯。會使用你設定的 LFS 端點，以及選取的 HTTPS 帳户或系統 SSH 設定。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器锁用于协调二进制文件编辑。会使用你配置的 LFS 端点和所选 HTTPS 账户或系统 SSH 设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器鎖定可協調二進位檔案的編輯。會使用你設定的 LFS 端點，以及選取的 HTTPS 帳號或系統 SSH 設定。"
          }
        }
      }
