        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La herramienta edita un archivo de resultado aparte. Guarda y cierra la herramienta, revisa el resultado y aplícalo aquí. Al aplicarlo también se prepara este archivo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
