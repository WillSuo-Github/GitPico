    "An interrupted operation has an unknown result. Recover its saved directory manually; automatic restore cannot overwrite that state." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نتيجة عملية منقطعة غير معروفة. استرد مجلدها المحفوظ يدويًا؛ لا يمكن للاستعادة التلقائية استبدال تلك الحالة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una operació interrompuda té un resultat desconegut. Recupera manualment el directori desat; la restauració automàtica no pot sobreescriure aquest estat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přerušená operace má neznámý výsledek. Obnovte její uložený adresář ručně; automatická obnova nemůže tento stav přepsat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultatet af en afbrudt handling er ukendt. Gendan dens gemte mappe manuelt. Automatisk gendannelse kan ikke overskrive denne tilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein unterbrochener Vorgang hat ein unbekanntes Ergebnis. Stelle sein gesichertes Verzeichnis manuell wieder her; die automatische Wiederherstellung kann diesen Zustand nicht überschreiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια διακοπείσα λειτουργία έχει άγνωστο αποτέλεσμα. Ανακτήστε χειροκίνητα τον αποθηκευμένο κατάλογό της· η αυτόματη επαναφορά δεν μπορεί να αντικαταστήσει αυτή την κατάσταση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una operación interrumpida tiene un resultado desconocido. Recupera manualmente su directorio guardado; la restauración automática no puede sobrescribir ese estado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una operación interrumpida tiene un resultado desconocido. Recupera manualmente su directorio guardado; la restauración automática no puede sobrescribir ese estado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskeytetyn toiminnon tulos on tuntematon. Palauta sen tallennettu hakemisto käsin. Automaattinen palautus ei voi korvata tätä tilaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une opération interrompue a un résultat inconnu. Récupérez manuellement son dossier enregistré ; la restauration automatique ne peut pas écraser cet état."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une opération interrompue a un résultat inconnu. Récupérez manuellement son dossier enregistré; la restauration automatique ne peut pas écraser cet état."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התוצאה של פעולה שנקטעה אינה ידועה. יש לשחזר ידנית את התיקייה שנשמרה; שחזור אוטומטי אינו יכול לדרוס מצב זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बाधित कार्य का परिणाम अज्ञात है। उसकी सहेजी गई डायरेक्टरी से मैन्युअल रिकवरी करें; स्वचालित बहाली उस स्थिति को अधिलेखित नहीं कर सकती।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ishod prekinute operacije nije poznat. Ručno oporavite njezin spremljeni direktorij; automatska obnova ne može prepisati to stanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy megszakított művelet eredménye ismeretlen. Állítsa helyre kézzel a mentett könyvtárát; az automatikus visszaállítás nem írhatja felül ezt az állapotot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasil operasi yang terputus tidak diketahui. Pulihkan direktori tersimpannya secara manual; pemulihan otomatis tidak dapat menimpa keadaan tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'operazione interrotta ha un esito sconosciuto. Recupera manualmente la directory salvata; il ripristino automatico non può sovrascrivere quello stato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中断された操作の結果が不明です。保存されたディレクトリを手動で回復してください。自動復元ではその状態を上書きできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중단된 작업의 결과를 알 수 없습니다. 저장된 디렉토리를 수동으로 복구하십시오. 자동 복원은 해당 상태를 덮어쓸 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasil operasi yang terganggu tidak diketahui. Pulihkan direktori tersimpannya secara manual; pemulihan automatik tidak boleh menulis ganti keadaan itu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De uitkomst van een onderbroken bewerking is onbekend. Herstel de opgeslagen map handmatig; automatisch herstel kan die toestand niet overschrijven."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultatet av en avbrutt operasjon er ukjent. Gjenopprett den lagrede mappen manuelt. Automatisk gjenoppretting kan ikke overskrive denne tilstanden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przerwana operacja ma nieznany wynik. Odzyskaj jej zapisany katalog ręcznie; automatyczne przywracanie nie może nadpisać tego stanu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma operação interrompida tem resultado desconhecido. Recupere o diretório salvo manualmente; a restauração automática não pode substituir esse estado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma operação interrompida tem um resultado desconhecido. Recupere o diretório guardado manualmente; o restauro automático não pode substituir esse estado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O operațiune întreruptă are un rezultat necunoscut. Recuperați manual directorul salvat; restaurarea automată nu poate suprascrie acea stare."
