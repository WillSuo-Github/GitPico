    "Use a key name beginning with a letter and containing only ASCII letters, digits, hyphens or underscores." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم اسم مفتاح يبدأ بحرف ويحتوي فقط على أحرف ASCII أو أرقام أو شرطات أو شرطات سفلية."
          }
        },
        "ca" : {
          "stringUnit" : {
