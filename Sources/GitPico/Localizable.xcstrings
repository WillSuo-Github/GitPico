    "One URL per line. Without push URLs, Git uses the fetch URL. Existing fetch mappings and other remote settings are preserved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عنوان URL واحد لكل سطر. دون عناوين URL للدفع، يستخدم Git عنوان الجلب. يُحتفظ بخرائط الجلب الموجودة وإعدادات المستودع البعيد الأخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un URL per línia. Sense URL de pujada, Git fa servir l'URL de recuperació. Es conserven les assignacions de recuperació existents i la resta de configuració del remot."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna URL na řádek. Bez URL pro odesílání používá Git URL pro načítání. Stávající mapování načítání i ostatní nastavení vzdáleného repozitáře zůstanou zachována."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én URL pr. linje. Uden URL'er til afsendelse bruger Git hente-URL'en. Eksisterende hentetilknytninger og andre indstillinger for fjernlageret bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine URL pro Zeile. Ohne Push-URLs verwendet Git die Fetch-URL. Vorhandene Fetch-Zuordnungen und andere Remote-Einstellungen bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα URL ανά γραμμή. Χωρίς URL ώθησης, το Git χρησιμοποιεί το URL λήψης. Οι υπάρχουσες αντιστοιχίσεις λήψης και οι άλλες ρυθμίσεις απομακρυσμένου διατηρούνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una URL por línea. Sin URL de push, Git usa la URL de fetch. Se conservan las asignaciones de fetch existentes y los demás ajustes del remoto."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una URL por línea. Si no hay URL de push, Git usa la URL de fetch. Se conservan las asignaciones de fetch existentes y el resto de la configuración del remoto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi URL-osoite rivillä. Ilman lähetys-URL-osoitteita Git käyttää nouto-URL-osoitetta. Nykyiset noutomääritykset ja muut etätietovaraston asetukset säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une URL par ligne. Sans URL de push, Git utilise l’URL de récupération. Les mappages de récupération existants et les autres réglages du dépôt distant sont conservés."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une URL par ligne. Sans URL de push, Git utilise l’URL de récupération. Les mappages de récupération existants et les autres réglages du dépôt distant sont conservés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL אחד בכל שורה. ללא כתובות URL לדחיפה, Git משתמש ב־URL לאחזור. מיפויי אחזור קיימים והגדרות אחרות של המאגר המרוחק נשמרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर पंक्ति में एक URL। पुश URL न होने पर Git फ़ेच URL इस्तेमाल करता है। मौजूदा फ़ेच मैपिंग और अन्य रिमोट सेटिंग्ज़ बनी रहती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedan URL po retku. Bez URL-ova za slanje Git koristi URL za dohvat. Postojeća preslikavanja dohvata i druge postavke udaljenog repozitorija su sačuvane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soronként egy URL. Feltöltési URL nélkül a Git a lekérési URL címét használja. A meglévő lekérési leképezések és a távoli tároló egyéb beállításai megmaradnak."
          }
        },
        "id" : {
          "stringUnit" : {
