    "The operation updates the current branch. If conflicts occur, resolve them and use Continue or Abort." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدّث العملية الفرع الحالي. إذا حدثت تعارضات، فحلّها واستخدم «متابعة» أو «إجهاض»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'operació actualitza la branca actual. Si hi ha conflictes, resol-los i fes servir Continua o Avorta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operace aktualizuje aktuální větev. Pokud dojde ke konfliktům, vyřešte je a použijte Pokračovat nebo Přerušit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlingen opdaterer den aktuelle gren. Hvis der opstår konflikter, skal du løse dem og vælge Fortsæt eller Afbryd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Vorgang aktualisiert den aktuellen Branch. Löse bei Konflikten diese und wähle dann „Fortfahren“ oder „Abbrechen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η λειτουργία ενημερώνει τον τρέχοντα κλάδο. Αν προκύψουν διενέξεις, επιλύστε τις και χρησιμοποιήστε τη Συνέχιση ή τη Ματαίωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La operación actualiza la rama actual. Si hay conflictos, resuélvelos y usa Continuar o Abortar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
