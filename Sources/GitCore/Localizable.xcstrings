    "The target moved or disappeared. Restore its management backup before retrying." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نُقل الهدف أو اختفى. استعد نسخة الإدارة الاحتياطية الخاصة به قبل إعادة المحاولة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La destinació s'ha mogut o ha desaparegut. Restaura'n la còpia de seguretat de gestió abans de tornar-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cíl se přesunul nebo zmizel. Před dalším pokusem obnovte jeho zálohu správy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målet er flyttet eller forsvundet. Gendan dets administrationssikkerhedskopi, før du prøver igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ziel wurde bewegt oder ist verschwunden. Stelle sein Verwaltungs-Backup wieder her, bevor du es erneut versuchst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο στόχος μετακινήθηκε ή εξαφανίστηκε. Επαναφέρετε το αντίγραφο ασφαλείας διαχείρισής του πριν δοκιμάσετε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El destino se movió o desapareció. Restaura su copia de seguridad de gestión antes de reintentar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El destino se movió o desapareció. Restaura su respaldo de administración antes de reintentar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohde siirtyi tai katosi. Palauta sen hallinnan varmuuskopio ennen uutta yritystä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cible a été déplacée ou a disparu. Restaurez sa sauvegarde de gestion avant de réessayer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cible a été déplacée ou a disparu. Restaurez sa sauvegarde de gestion avant de réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היעד הועבר או נעלם. יש לשחזר את גיבוי הניהול שלו לפני ניסיון חוזר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लक्ष्य स्थानांतरित हो गया है या अब मौजूद नहीं है। फिर कोशिश करने से पहले उसका प्रबंधन बैकअप बहाल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilj je premješten ili nestao. Obnovite njegovu sigurnosnu kopiju upravljanja prije ponovnog pokušaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cél áthelyeződött vagy eltűnt. Újrapróbálkozás előtt állítsa vissza a kezelési biztonsági másolatát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target berpindah atau menghilang. Pulihkan cadangan pengelolaannya sebelum mencoba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La destinazione è stata spostata o è scomparsa. Ripristinane il backup di gestione prima di riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターゲットが移動されたか、見つからなくなりました。再試行する前に管理バックアップを復元してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상이 이동되었거나 사라졌습니다. 다시 시도하기 전에 관리 백업을 복원하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sasaran telah berpindah atau hilang. Pulihkan sandaran pengurusannya sebelum mencuba lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het doel is verplaatst of verdwenen. Zet de beheerreservekopie terug voordat je het opnieuw probeert."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målet er flyttet eller forsvunnet. Gjenopprett administrasjonssikkerhetskopien før du prøver igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cel został przeniesiony lub zniknął. Przywróć jego kopię zapasową zarządzania przed ponowną próbą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O alvo foi movido ou desapareceu. Restaure o backup de gerenciamento antes de tentar novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O alvo foi movido ou desapareceu. Restaure a cópia de segurança de gestão antes de tentar novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ținta s-a mutat sau a dispărut. Restaurați-i copia de siguranță administrativă înainte de a reîncerca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цель перемещена или исчезла. Восстановите её резервную копию управления перед повтором."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cieľ sa presunul alebo zmizol. Pred ďalším pokusom obnovte jeho zálohu správy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilj je premaknjen ali je izginil. Pred ponovnim poskusom obnovite njegovo varnostno kopijo upravljanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målet har flyttats eller försvunnit. Återställ dess hanteringssäkerhetskopia innan du försöker igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป้าหมายถูกย้ายหรือหายไป กู้คืนข้อมูลสำรองการจัดการก่อนลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedef taşındı veya kayboldu. Yeniden denemeden önce yönetim yedeğini geri yükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ціль перемістилася або зникла. Відновіть її резервну копію керування, перш ніж повторити спробу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đích đã di chuyển hoặc biến mất. Khôi phục bản sao lưu quản lý trước khi thử lại."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標已移動或消失。重試前請回復其管理備份。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标已移动或消失。重试前请恢复其管理备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標已移動或消失。重試前請回復其管理備份。"
          }
        }
      }
    },
    "The tool executable is missing or not executable. Check External Tools settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملف التنفيذي للأداة مفقود أو غير قابل للتنفيذ. تحقق من إعدادات الأدوات الخارجية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'executable de l'eina falta o no es pot executar. Comprova la configuració d'eines externes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
