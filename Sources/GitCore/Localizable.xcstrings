          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD, klargjøringen eller grener ble endret utenfor denne prosessen. Eksisterende endringer ble bevart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
