    "Sign in with GitHub or GitLab, connect an HTTPS token, or use your existing system Git and SSH setup. Credentials are stored in Keychain." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول باستخدام GitHub أو GitLab، أو اربط رمز HTTPS، أو استخدم إعدادات Git وSSH الحالية للنظام. تُخزن بيانات الاعتماد في سلسلة المفاتيح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sessió amb GitHub o GitLab, connecta un testimoni HTTPS o fes servir la configuració existent de Git i SSH del sistema. Les credencials es desen al clauer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlaste se přes GitHub nebo GitLab, připojte token HTTPS nebo použijte stávající systémové nastavení Git a SSH. Přihlašovací údaje se ukládají do Klíčenky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind med GitHub eller GitLab, tilknyt et HTTPS-token, eller brug systemets eksisterende Git- og SSH-opsætning. Loginoplysninger gemmes i nøgleringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit GitHub oder GitLab an, verbinde ein HTTPS-Token oder nutze deine vorhandene System-Git- und SSH-Konfiguration. Anmeldedaten werden im Schlüsselbund gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεθείτε μέσω GitHub ή GitLab, συνδέστε διακριτικό HTTPS ή χρησιμοποιήστε τις υπάρχουσες ρυθμίσεις Git και SSH του συστήματός σας. Τα διαπιστευτήρια αποθηκεύονται στην Κλειδοθήκη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con GitHub o GitLab, conecta un token HTTPS o usa tu configuración Git y SSH del sistema. Las credenciales se guardan en el Llavero."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con GitHub o GitLab, conecta un token HTTPS o usa tu configuración Git y SSH del sistema. Las credenciales se guardan en el Llavero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu GitHubilla tai GitLabilla, liitä HTTPS-tunniste tai käytä järjestelmän nykyisiä Git- ja SSH-asetuksia. Kirjautumistiedot tallennetaan Avainnippuun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
