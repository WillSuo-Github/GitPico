          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indexul părinte salvat complet și fișierele de configurare listate sunt restaurate. O previzualizare învechită este respinsă. Nu se efectuează niciun commit sau operațiune de rețea."
          }
