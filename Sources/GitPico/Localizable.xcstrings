    "Search this view, files, branches, commits and actions. Type > for actions. ⌘F to search; ⌘⇧A for actions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث في هذا العرض والملفات والفروع والإيداعات والإجراءات. اكتب > للإجراءات. ⌘F للبحث؛ ⌘⇧A للإجراءات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca en aquesta vista, fitxers, branques, commits i accions. Escriu > per a les accions. ⌘F per cercar; ⌘⇧A per a les accions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hledejte v tomto zobrazení, souborech, větvích, commitech a akcích. Pro akce zadejte >. ⌘F pro hledání; ⌘⇧A pro akce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søg i denne visning, filer, grene, commits og handlinger. Skriv > for handlinger. ⌘F for at søge; ⌘⇧A for handlinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Ansicht, Dateien, Branches, Commits und Aktionen durchsuchen. Gib > für Aktionen ein. ⌘F zum Suchen; ⌘⇧A für Aktionen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναζήτηση σε αυτή την προβολή, αρχεία, κλάδους, υποβολές και ενέργειες. Πληκτρολογήστε > για ενέργειες. ⌘F για αναζήτηση· ⌘⇧A για ενέργειες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca en esta vista, archivos, ramas, commits y acciones. Escribe > para acciones. ⌘F para buscar; ⌘⇧A para acciones."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca en esta vista, archivos, ramas, commits y acciones. Escribe > para acciones. ⌘F para buscar; ⌘⇧A para acciones."
