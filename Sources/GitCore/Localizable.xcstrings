    "Authorization could not be completed or renewed. Sign in again; check the OAuth application settings if the problem continues." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر إكمال التفويض أو تجديده. سجّل الدخول مجددًا؛ وتحقق من إعدادات تطبيق OAuth إذا استمرت المشكلة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut completar o renovar l'autorització. Torna a iniciar sessió; comprova la configuració de l'aplicació OAuth si el problema continua."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizaci se nepodařilo dokončit nebo obnovit. Znovu se přihlaste; pokud problém přetrvává, zkontrolujte nastavení aplikace OAuth."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgangstilladelsen kunne ikke oprettes eller fornyes. Log ind igen; kontrollér OAuth-appens indstillinger, hvis problemet fortsætter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisierung konnte nicht abgeschlossen oder erneuert werden. Melde dich erneut an; prüfe die Einstellungen der OAuth-Anwendung, falls das Problem bleibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ολοκλήρωση ή η ανανέωση της εξουσιοδότησης. Συνδεθείτε ξανά· ελέγξτε τις ρυθμίσεις εφαρμογής OAuth αν το πρόβλημα συνεχιστεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo completar ni renovar la autorización. Vuelve a iniciar sesión; si el problema persiste, revisa los ajustes de la aplicación OAuth."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo completar ni renovar la autorización. Vuelve a iniciar sesión; si el problema persiste, revisa la configuración de la aplicación OAuth."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valtuutusta ei voitu suorittaa tai uusia. Kirjaudu uudelleen. Tarkista OAuth-sovelluksen asetukset, jos ongelma jatkuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de terminer ou de renouveler l’autorisation. Connectez-vous à nouveau ; vérifiez les réglages de l’application OAuth si le problème persiste."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de terminer ou de renouveler l’autorisation. Connectez-vous à nouveau; vérifiez les réglages de l’application OAuth si le problème persiste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן להשלים או לחדש את ההרשאה. יש להתחבר שוב; אם הבעיה נמשכת, יש לבדוק את הגדרות יישום ה־OAuth."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्राधिकरण पूरा या नवीनीकृत नहीं हो सका। फिर से साइन इन करें; समस्या बनी रहे तो OAuth ऐप की सेटिंग्ज़ जाँचें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće dovršiti ili obnoviti autorizaciju. Ponovno se prijavite; provjerite postavke aplikacije OAuth ako se problem nastavi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az engedélyezést nem sikerült befejezni vagy megújítani. Jelentkezzen be újra; ha a probléma továbbra is fennáll, ellenőrizze az OAuth-alkalmazás beállításait."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otorisasi tidak dapat diselesaikan atau diperbarui. Masuk kembali; periksa pengaturan aplikasi OAuth jika masalah berlanjut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile completare o rinnovare l'autorizzazione. Accedi di nuovo; se il problema persiste, controlla le impostazioni dell'applicazione OAuth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認証を完了または更新できませんでした。もう一度サインインしてください。問題が解決しない場合は OAuth アプリケーションの設定を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인증을 완료하거나 갱신할 수 없습니다. 다시 로그인하십시오. 문제가 계속되면 OAuth 애플리케이션 설정을 확인하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebenaran tidak dapat dilengkapkan atau diperbaharui. Daftar masuk semula; semak tetapan aplikasi OAuth jika masalah berterusan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De autorisatie kan niet worden voltooid of vernieuwd. Log opnieuw in; controleer de instellingen van de OAuth-app als het probleem aanhoudt."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisasjonen kunne ikke fullføres eller fornyes. Logg inn på nytt. Kontroller innstillingene for OAuth-appen hvis problemet vedvarer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można ukończyć ani odnowić autoryzacji. Zaloguj się ponownie; jeśli problem nie ustąpi, sprawdź ustawienia aplikacji OAuth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível concluir ou renovar a autorização. Inicie a sessão novamente; verifique os ajustes do aplicativo OAuth se o problema continuar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível concluir ou renovar a autorização. Inicie sessão novamente; verifique as definições da aplicação OAuth se o problema continuar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizarea nu a putut fi finalizată sau reînnoită. Autentificați-vă din nou; verificați configurările aplicației OAuth dacă problema persistă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось выполнить или продлить авторизацию. Войдите снова; если проблема сохранится, проверьте настройки приложения OAuth."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizáciu sa nepodarilo dokončiť alebo obnoviť. Znova sa prihláste; ak problém pretrváva, skontrolujte nastavenia aplikácie OAuth."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pooblastitve ni bilo mogoče dokončati ali obnoviti. Znova se prijavite; če se težava nadaljuje, preverite nastavitve aplikacije OAuth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auktoriseringen kunde inte slutföras eller förnyas. Logga in igen. Kontrollera OAuth-appens inställningar om problemet kvarstår."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถอนุญาตหรือต่ออายุการอนุญาตได้ ลงชื่อเข้าใช้อีกครั้ง หากยังมีปัญหา ให้ตรวจสอบการตั้งค่าแอปพลิเคชัน OAuth"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yetkilendirme tamamlanamadı veya yenilenemedi. Yeniden giriş yapın; sorun sürerse OAuth uygulama ayarlarını kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося завершити або поновити авторизацію. Увійдіть знову; якщо проблема не зникне, перевірте параметри застосунку OAuth."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể hoàn tất hoặc gia hạn ủy quyền. Đăng nhập lại; kiểm tra cài đặt ứng dụng OAuth nếu lỗi vẫn xảy ra."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法完成或更新授權。請重新登入；若問題持續，請檢查 OAuth 應用程式設定。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法完成或续订授权。请重新登录；如果问题仍然存在，请检查 OAuth 应用程序设置。"
