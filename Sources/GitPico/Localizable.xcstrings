        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert de lokale remoteconfiguratie en de bijbehorende trackingreferenties. De server en de branches daarop blijven ongewijzigd. Herstelrecords voor configuratie en referenties blijven bewaard."
          }
        },
        "no" : {
          "stringUnit" : {
