        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git o il server potrebbero essere già cambiati. Controlla lo stato aggiornato prima di riprovare. Push e pull non vengono mai ripetuti automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git またはサーバがすでに変更されている可能性があります。再試行する前に更新後の状態を確認してください。プッシュとプルが自動的に再試行されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git 또는 서버가 이미 변경되었을 수 있습니다. 다시 시도하기 전에 새로 고친 상태를 검토하십시오. 푸시와 풀은 절대 자동으로 재시도되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git atau pelayan mungkin sudah berubah. Semak keadaan yang dimuat semula sebelum mencuba semula. Tolak dan Tarik tidak pernah dicuba semula secara automatik."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git of de server is mogelijk al gewijzigd. Controleer de vernieuwde status voordat je het opnieuw probeert. Push en pull worden nooit automatisch opnieuw geprobeerd."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git eller serveren kan allerede ha blitt endret. Gjennomgå den oppdaterte tilstanden før du prøver igjen. Sending og henting med integrering forsøkes aldri på nytt automatisk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git lub serwer mogły już ulec zmianie. Przejrzyj odświeżony stan przed ponowną próbą. Wypychanie i ściąganie nigdy nie są ponawiane automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Git ou o servidor podem já ter sido alterados. Revise o estado atualizado antes de tentar novamente. Push e Pull nunca são repetidos automaticamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
