    "Branches, configuration, staging or HEAD changed. Review Git Flow again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيرت الفروع أو الإعدادات أو التجهيز أو HEAD. راجع Git Flow مجددًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les branques, la configuració, l'àrea de preparació o HEAD han canviat. Torna a revisar Git Flow."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Větve, konfigurace, přípravná oblast nebo HEAD se změnily. Znovu zkontrolujte Git Flow."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grene, konfiguration, klargøring eller HEAD er ændret. Gennemgå Git Flow igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
