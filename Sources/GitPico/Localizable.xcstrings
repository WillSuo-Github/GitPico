    "Some saved repositories could not be reopened. Their tabs were kept for recovery:\n%@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر إعادة فتح بعض المستودعات المحفوظة. حُفظت علامات تبويبها للاسترداد:\n%@"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'han pogut tornar a obrir alguns repositoris desats. Se n'han conservat les pestanyes per recuperar-los:\n%@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé uložené repozitáře se nepodařilo znovu otevřít. Jejich panely byly zachovány pro obnovu:\n%@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle gemte kodelagre kunne ikke åbnes igen. Deres faner blev bevaret til gendannelse:\n%@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige gesicherte Repositorys konnten nicht erneut geöffnet werden. Ihre Tabs wurden zur Wiederherstellung behalten:\n%@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατό το εκ νέου άνοιγμα ορισμένων αποθηκευμένων αποθετηρίων. Οι καρτέλες τους διατηρήθηκαν για ανάκτηση:\n%@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron volver a abrir algunos repositorios guardados. Sus pestañas se conservaron para recuperarlas:\n%@"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron volver a abrir algunos repositorios guardados. Sus pestañas se conservaron para recuperarlas:\n%@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joitakin tallennettuja tietovarastoja ei voitu avata uudelleen. Niiden välilehdet säilytettiin palautusta varten:\n%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains dépôts enregistrés n’ont pas pu être rouverts. Leurs onglets ont été conservés pour la récupération :\n%@"
