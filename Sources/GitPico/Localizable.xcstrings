    "Review the exact destination and server object before pushing. With multiple push URLs, this action writes only to the selected URL." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع الوجهة وكائن الخادم بدقة قبل الدفع. عند تعدد عناوين URL للدفع، يكتب هذا الإجراء إلى عنوان URL المحدد فقط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa la destinació exacta i l'objecte del servidor abans de pujar. Amb diversos URL de pujada, aquesta acció només escriu a l'URL seleccionat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před odesláním zkontrolujte přesný cíl a objekt na serveru. Při více URL pro odesílání tato akce zapisuje pouze na vybranou URL."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollér den præcise destination og objektet på serveren, før du sender. Hvis der er flere URL'er til afsendelse, skriver denne handling kun til den valgte URL."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe vor dem Push das exakte Ziel und das Serverobjekt. Bei mehreren Push-URLs schreibt diese Aktion nur zur ausgewählten URL."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε τον ακριβή προορισμό και το αντικείμενο διακομιστή πριν από την ώθηση. Με πολλαπλά URL ώθησης, αυτή η ενέργεια γράφει μόνο στο επιλεγμένο URL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa el destino exacto y el objeto del servidor antes de hacer push. Con varias URL de push, esta acción solo escribe en la URL seleccionada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa el destino exacto y el objeto del servidor antes de hacer push. Con varias URL de push, esta acción solo escribe en la URL seleccionada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista tarkka kohde ja palvelimen objekti ennen lähettämistä. Jos lähetys-URL-osoitteita on useita, tämä toiminto kirjoittaa vain valittuun URL-osoitteeseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez la destination exacte et l’objet sur le serveur avant de pousser. Avec plusieurs URL de push, cette action n’écrit que vers l’URL sélectionnée."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez la destination exacte et l’objet sur le serveur avant de pousser. Avec plusieurs URL de push, cette action n’écrit que vers l’URL sélectionnée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבדוק את היעד המדויק ואת האובייקט בשרת לפני הדחיפה. כשיש כמה כתובות URL לדחיפה, פעולה זו כותבת רק ל־URL שנבחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुश करने से पहले सटीक गंतव्य और सर्वर ऑब्जेक्ट की समीक्षा करें। कई पुश URL होने पर यह क्रिया केवल चुने गए URL पर लिखती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregledajte točno odredište i objekt na poslužitelju prije slanja. Uz više URL-ova za slanje ova radnja piše samo na odabrani URL."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feltöltés előtt ellenőrizze a pontos célhelyet és a kiszolgáló objektumát. Több feltöltési URL esetén ez a művelet csak a kijelölt URL címére ír."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinjau tujuan yang tepat dan objek server sebelum mendorong. Jika ada beberapa URL dorong, tindakan ini hanya menulis ke URL terpilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la destinazione esatta e l'oggetto sul server prima del push. Con più URL di push, questa azione scrive solo sull'URL selezionato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プッシュする前に、正確な保存先とサーバのオブジェクトを確認してください。プッシュ URL が複数ある場合、このアクションは選択した URL にのみ書き込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
