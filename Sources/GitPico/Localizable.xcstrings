    "%@ · HTTPS profiles apply only to their exact host. SSH remotes continue to use system SSH." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · تنطبق ملفات تعريف HTTPS على مضيفها المحدد فقط. تواصل المستودعات البعيدة عبر SSH استخدام SSH الخاص بالنظام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Els perfils HTTPS només s'apliquen al seu amfitrió exacte. Els remots SSH continuen fent servir l'SSH del sistema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Profily HTTPS platí pouze pro přesně určeného hostitele. Vzdálené repozitáře SSH nadále používají systémové SSH."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · HTTPS-profiler gælder kun for den præcise vært, de er knyttet til. SSH-fjernlagre bruger fortsat systemets SSH."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · HTTPS-Profile gelten nur für ihren exakten Host. SSH-Remotes verwenden weiterhin das System-SSH."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Τα προφίλ HTTPS ισχύουν μόνο για τον ακριβή διακομιστή τους. Τα απομακρυσμένα SSH συνεχίζουν να χρησιμοποιούν το SSH του συστήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Los perfiles HTTPS solo se aplican a su host exacto. Los remotos SSH siguen usando el SSH del sistema."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Los perfiles HTTPS solo se aplican a su host exacto. Los remotos SSH siguen usando el SSH del sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · HTTPS-profiilit koskevat vain täsmälleen samaa palvelinta. SSH-etätietovarastot käyttävät edelleen järjestelmän SSH:ta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Les profils HTTPS s’appliquent uniquement à leur hôte exact. Les dépôts distants SSH continuent d’utiliser le SSH du système."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Les profils HTTPS s’appliquent uniquement à leur hôte exact. Les dépôts distants SSH continuent d’utiliser le SSH du système."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · פרופילי HTTPS חלים רק על המארח המדויק שלהם. מאגרים מרוחקים עם SSH ממשיכים להשתמש ב־SSH של המערכת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · HTTPS प्रोफ़ाइल केवल अपने सटीक होस्ट पर लागू होती हैं। SSH रिमोट सिस्टम SSH का उपयोग करते रहेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · HTTPS profili vrijede samo za točno navedeni poslužitelj. SSH udaljeni repozitoriji i dalje koriste sustavski SSH."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · A HTTPS-profilok csak a pontosan megadott kiszolgálóra érvényesek. Az SSH-távoli tárolók továbbra is a rendszer SSH-ját használják."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Profil HTTPS hanya berlaku untuk host yang sama persis. Repositori jarak jauh SSH tetap menggunakan SSH sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · I profili HTTPS si applicano solo al loro host esatto. I remoti SSH continuano a usare l'SSH di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · HTTPS プロファイルは完全に一致するホストにのみ適用されます。SSH リモートは引き続きシステムの SSH を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · HTTPS 프로필은 정확히 일치하는 호스트에만 적용됩니다. SSH 원격은 계속 시스템 SSH를 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Profil HTTPS hanya terpakai pada hos yang sepadan tepat. Repositori jauh SSH terus menggunakan SSH sistem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · HTTPS-profielen gelden alleen voor hun exacte host. SSH-remotes blijven de SSH-configuratie van het systeem gebruiken."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · HTTPS-profiler gjelder bare for nøyaktig den angitte verten. SSH-fjernlagre bruker fortsatt systemets SSH."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Profile HTTPS dotyczą tylko dokładnie tego hosta. Zdalne repozytoria SSH nadal używają systemowego SSH."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Perfis HTTPS valem apenas para o host exato. Remotos SSH continuam usando o SSH do sistema."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Perfis HTTPS valem apenas para o host exato. Remotos SSH continuam a usar o SSH do sistema."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Profilurile HTTPS se aplică doar gazdei exacte. Depozitele la distanță SSH folosesc în continuare SSH din sistem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Профили HTTPS применяются только к своему хосту. Удалённые репозитории SSH по-прежнему используют системный SSH."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Profily HTTPS sa vzťahujú len na presne zodpovedajúceho hostiteľa. Vzdialené repozitáre SSH naďalej používajú systémové SSH."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Profili HTTPS veljajo samo za točno določeni gostitelj. Oddaljeni repozitoriji SSH še naprej uporabljajo sistemski SSH."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · HTTPS-profiler gäller endast för den exakta värden. SSH-fjärrarkiv använder fortfarande systemets SSH."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · โปรไฟล์ HTTPS ใช้กับโฮสต์ที่ตรงกันเท่านั้น รีโมต SSH ยังคงใช้ SSH ของระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · HTTPS profilleri yalnızca tam olarak eşleşen sunucularda geçerlidir. SSH uzak depoları sistem SSH'sini kullanmaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Профілі HTTPS застосовуються лише до свого точного хоста. Віддалені репозиторії SSH і надалі використовують системний SSH."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Hồ sơ HTTPS chỉ áp dụng cho đúng máy chủ của hồ sơ. Kho từ xa SSH tiếp tục dùng SSH hệ thống."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · HTTPS 設定檔僅套用於完全相符的主機。SSH 遠端會繼續使用系統 SSH。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · HTTPS 配置仅适用于完全匹配的主机。SSH 远程仓库继续使用系统 SSH。"
          }
