    "Connect HTTPS accounts in Authentication, or use your existing system Git credentials and SSH agent. Signing continues to use your repository configuration." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اربط حسابات HTTPS في المصادقة، أو استخدم بيانات اعتماد Git الحالية في النظام ووكيل SSH. يواصل التوقيع استخدام إعدادات مستودعك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecta comptes HTTPS a Autenticació, o fes servir les credencials de Git del sistema i l'agent SSH existents. La signatura continua fent servir la configuració del repositori."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojte účty HTTPS v části Ověřování nebo použijte stávající systémové přihlašovací údaje pro Git a agenta SSH. Podepisování nadále používá konfiguraci repozitáře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilslut HTTPS-konti under Godkendelse, eller brug systemets eksisterende Git-loginoplysninger og SSH-agent. Signering bruger fortsat kodelagerets konfiguration."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde HTTPS-Accounts unter „Authentifizierung“ oder nutze deine vorhandenen System-Git-Anmeldedaten und den SSH-Agent. Das Signieren nutzt weiterhin deine Repository-Konfiguration."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέστε λογαριασμούς HTTPS στον Έλεγχο ταυτότητας ή χρησιμοποιήστε τα υπάρχοντα διαπιστευτήρια Git του συστήματος και τον πράκτορα SSH. Η υπογραφή συνεχίζει να χρησιμοποιεί τη διαμόρφωση του αποθετηρίου σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta cuentas HTTPS en Autenticación, o usa tus credenciales de Git del sistema y tu agente SSH. La firma sigue usando la configuración de tu repositorio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta cuentas HTTPS en Autenticación, o usa tus credenciales de Git del sistema y tu agente SSH. La firma sigue usando la configuración de tu repositorio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistä HTTPS-tilit Todennus-kohdassa tai käytä järjestelmän nykyisiä Git-tunnuksia ja SSH-agenttia. Allekirjoitus käyttää edelleen tietovaraston määrityksiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez des comptes HTTPS dans Authentification, ou utilisez vos identifiants Git système et votre agent SSH existants. La signature continue d’utiliser la configuration de votre dépôt."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez des comptes HTTPS dans Authentification, ou utilisez vos identifiants Git système et votre agent SSH existants. La signature continue d’utiliser la configuration de votre dépôt."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן לחבר חשבונות HTTPS בהגדרות אימות הזהות, או להשתמש באישורי ה־Git הקיימים במערכת ובסוכן SSH. החתימה ממשיכה להשתמש בהגדרות המאגר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रमाणीकरण में HTTPS खाते जोड़ें या अपने सिस्टम के मौजूदा Git क्रेडेंशियल और SSH एजेंट का उपयोग करें। हस्ताक्षर के लिए आपकी रिपॉज़िटरी का कॉन्फ़िगरेशन इस्तेमाल होता रहेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povežite HTTPS račune u Autentikaciji ili koristite postojeće vjerodajnice sustavskog Gita i SSH agent. Potpisivanje i dalje koristi konfiguraciju repozitorija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakoztassa HTTPS-fiókjait a Hitelesítés részben, vagy használja a rendszer meglévő Git-hitelesítő adatait és SSH-ügynökét. Az aláírás továbbra is a tároló beállításait használja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan akun HTTPS di Autentikasi, atau gunakan kredensial Git sistem dan agen SSH yang sudah ada. Penandatanganan tetap menggunakan konfigurasi repositori Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega account HTTPS in Autenticazione oppure usa le credenziali Git di sistema e l'agente SSH esistenti. La firma continua a usare la configurazione del repository."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「認証」で HTTPS アカウントを接続するか、既存のシステムの Git 資格情報と SSH エージェントを使用してください。署名には引き続きリポジトリの構成が使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인증에서 HTTPS 계정을 연결하거나 기존 시스템 Git 자격 증명과 SSH 에이전트를 사용하십시오. 서명은 계속 저장소 구성을 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungkan akaun HTTPS dalam Pengesahan, atau gunakan kelayakan Git sistem sedia ada dan ejen SSH anda. Penandatanganan terus menggunakan konfigurasi repositori anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel HTTPS-accounts bij 'Authenticatie' of gebruik je bestaande Git-inloggegevens en SSH-agent van het systeem. Ondertekenen blijft je repositoryconfiguratie gebruiken."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble til HTTPS-kontoer under Autentisering, eller bruk systemets eksisterende Git-påloggingsinformasjon og SSH-agent. Signering bruker fortsatt kodelagerets konfigurasjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz konta HTTPS w sekcji Uwierzytelnianie lub użyj istniejących systemowych danych uwierzytelniających Git i agenta SSH. Podpisywanie nadal używa konfiguracji repozytorium."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte contas HTTPS em Autenticação ou use as credenciais Git e o agente SSH do sistema. A assinatura continua usando a configuração do repositório."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associe contas HTTPS em Autenticação ou use as credenciais Git e o agente SSH do sistema. A assinatura continua a usar a configuração do repositório."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectați conturile HTTPS în Autentificare sau folosiți acreditările Git existente din sistem și agentul SSH. Semnarea folosește în continuare configurarea depozitului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите учётные записи HTTPS в разделе «Аутентификация» или используйте существующие системные учётные данные Git и SSH-агент. Подпись по-прежнему использует конфигурацию репозитория."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripojte účty HTTPS v časti Autentifikácia alebo použite existujúce systémové prihlasovacie údaje Git a agenta SSH. Podpisovanie naďalej používa konfiguráciu repozitára."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povežite račune HTTPS v Preverjanju pristnosti ali uporabite obstoječe sistemske poverilnice Git in posrednika SSH. Podpisovanje še naprej uporablja nastavitve repozitorija."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut HTTPS-konton under Autentisering eller använd systemets befintliga Git-inloggningsuppgifter och SSH-agent. Signering använder även fortsättningsvis arkivets konfiguration."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อบัญชี HTTPS ในการยืนยันตัวตน หรือใช้ข้อมูลรับรอง Git ของระบบและเอเจนต์ SSH ที่มีอยู่ การลงนามยังคงใช้การกำหนดค่าของคลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimlik Doğrulama'da HTTPS hesaplarını bağlayın veya mevcut sistem Git kimlik bilgilerinizi ve SSH aracısını kullanın. İmzalama, depo yapılandırmanızı kullanmaya devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підключіть облікові записи HTTPS у розділі «Автентифікація» або використовуйте наявні системні облікові дані Git і агент SSH. Підписування й надалі використовує конфігурацію репозиторію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối tài khoản HTTPS trong Xác thực hoặc dùng thông tin xác thực Git hệ thống và SSH Agent hiện có. Ký vẫn dùng cấu hình của kho."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「認證」中連接 HTTPS 帳户，或使用現有的系統 Git 憑證與 SSH 代理程式。簽名仍會使用你的儲存庫設定。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“认证”中连接 HTTPS 账户，或使用现有的系统 Git 凭证和 SSH 代理。签名继续使用你的仓库配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「認證」中連接 HTTPS 帳號，或使用現有的系統 Git 憑證與 SSH 代理程式。簽名仍會使用你的儲存庫設定。"
          }
        }
      }
