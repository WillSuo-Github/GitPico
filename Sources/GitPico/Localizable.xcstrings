    "Git will restore the pre-operation state. Edits made while resolving conflicts may be lost." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيستعيد Git الحالة السابقة للعملية. قد تُفقد التعديلات التي أجريتها أثناء حل التعارضات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git restaurarà l'estat anterior a l'operació. Es poden perdre els canvis fets en resoldre conflictes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git obnoví stav před operací. Úpravy provedené při řešení konfliktů se mohou ztratit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git gendanner tilstanden fra før handlingen. Ændringer foretaget under løsning af konflikter kan gå tabt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git stellt den Zustand vor dem Vorgang wieder her. Änderungen beim Lösen von Konflikten können verloren gehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Git θα επαναφέρει την κατάσταση πριν από τη λειτουργία. Οι αλλαγές κατά την επίλυση διενέξεων μπορεί να χαθούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git restaurará el estado previo a la operación. Pueden perderse las ediciones hechas al resolver conflictos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git restaurará el estado previo a la operación. Pueden perderse las ediciones hechas al resolver conflictos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git palauttaa toimintoa edeltäneen tilan. Ristiriitojen ratkaisemisen aikana tehdyt muokkaukset saatetaan menettää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git va restaurer l’état antérieur à l’opération. Les modifications effectuées pendant la résolution des conflits peuvent être perdues."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git va restaurer l’état antérieur à l’opération. Les modifications effectuées pendant la résolution des conflits peuvent être perdues."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git ישחזר את המצב שלפני הפעולה. עריכות שבוצעו במהלך פתרון התנגשויות עלולות ללכת לאיבוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git कार्रवाई से पहले की स्थिति बहाल करेगा। टकराव सुलझाते समय किए गए संपादन खो सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git će obnoviti stanje prije operacije. Izmjene nastale tijekom rješavanja sukoba mogu se izgubiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Git visszaállítja a művelet előtti állapotot. Az ütközések feloldása közben végzett módosítások elveszhetnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git akan memulihkan keadaan sebelum operasi. Edit yang dibuat saat menyelesaikan konflik mungkin hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git ripristinerà lo stato precedente all'operazione. Le modifiche apportate durante la risoluzione dei conflitti potrebbero andare perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git は操作前の状態を復元します。コンフリクトの解決中に行った編集は失われる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git이 작업 전 상태를 복원합니다. 충돌을 해결하면서 편집한 내용이 손실될 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git akan memulihkan keadaan sebelum operasi. Suntingan yang dibuat semasa menyelesaikan konflik mungkin hilang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git herstelt de toestand van vóór de bewerking. Wijzigingen die tijdens het oplossen van conflicten zijn gemaakt, kunnen verloren gaan."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git gjenoppretter tilstanden fra før operasjonen. Endringer gjort under konfliktløsning kan gå tapt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git przywróci stan sprzed operacji. Edycje wprowadzone podczas rozwiązywania konfliktów mogą zostać utracone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Git restaurará o estado anterior à operação. Edições feitas ao resolver conflitos podem ser perdidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Git restaurará o estado anterior à operação. Edições feitas ao resolver conflitos podem ser perdidas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git va restaura starea de dinaintea operațiunii. Modificările făcute la rezolvarea conflictelor se pot pierde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git восстановит состояние до операции. Правки, сделанные при разрешении конфликтов, могут быть потеряны."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git obnoví stav pred operáciou. Úpravy vykonané pri riešení konfliktov sa môžu stratiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git bo obnovil stanje pred opravilom. Spremembe, narejene med razreševanjem sporov, se lahko izgubijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git återställer tillståndet före åtgärden. Ändringar som gjorts under konfliktlösningen kan gå förlorade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git จะคืนสถานะก่อนดำเนินการ การแก้ไขที่ทำระหว่างแก้ข้อขัดแย้งอาจสูญหาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git işlem öncesi durumu geri yükleyecek. Çakışmaları çözerken yapılan düzenlemeler kaybolabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git відновить стан до операції. Зміни, зроблені під час розвʼязання конфліктів, можуть бути втрачені."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git sẽ khôi phục trạng thái trước thao tác. Chỉnh sửa trong khi giải quyết xung đột có thể bị mất."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git 會回復到操作前的狀態。解決衝突時所做的編輯可能會遺失。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git 将恢复到操作前的状态。解决冲突时所做的编辑可能会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
