    "External merge currently requires regular UTF-8 current/incoming files. Use the whole-file controls for binary or deletion conflicts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب الدمج الخارجي حاليًا ملفين عاديين بترميز UTF-8 للنسختين الحالية والواردة. استخدم أدوات الملف الكامل لتعارضات الملفات الثنائية أو الحذف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fusió externa requereix actualment fitxers actuals/entrants UTF-8 normals. Fes servir els controls de fitxer sencer per a conflictes binaris o de supressió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Externí sloučení nyní vyžaduje běžné aktuální a příchozí soubory v UTF-8. Pro konflikty binárních souborů nebo smazání použijte ovládání celého souboru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekstern fletning kræver i øjeblikket almindelige UTF-8-filer for både den aktuelle og den indgående version. Brug funktionerne for hele filer ved binære konflikter eller sletningskonflikter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der externe Merge erfordert derzeit reguläre UTF-8-Dateien für „Aktuell“ und „Eingehend“. Verwende bei Binär- oder Löschkonflikten die Steuerelemente für ganze Dateien."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εξωτερική συγχώνευση απαιτεί προς το παρόν κανονικά αρχεία UTF-8 για τις τρέχουσες/εισερχόμενες εκδόσεις. Χρησιμοποιήστε τα χειριστήρια ολόκληρου αρχείου για δυαδικές διενέξεις ή διενέξεις διαγραφής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fusión externa requiere por ahora archivos actual/entrante UTF-8 normales. Usa los controles de archivo completo para conflictos binarios o de eliminación."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fusión externa requiere por ahora archivos normales UTF-8 de las versiones actual y entrante. Usa los controles de archivo completo para conflictos binarios o de eliminación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulkoinen yhdistäminen vaatii tällä hetkellä nykyisen ja saapuvan version tavallisina UTF-8-tiedostoina. Käytä koko tiedoston toimintoja binääri- tai poistoristiriidoissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fusion externe nécessite actuellement des fichiers actuels/entrants UTF-8 standard. Utilisez les commandes de fichier entier pour les conflits binaires ou de suppression."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fusion externe nécessite actuellement des fichiers actuels/entrants UTF-8 standard. Utilisez les commandes de fichier entier pour les conflits binaires ou de suppression."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מיזוג חיצוני דורש כעת קבצים נוכחיים ונכנסים רגילים בקידוד UTF-8. להתנגשויות בינאריות או מחיקות יש להשתמש בפקדים לקובץ השלם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाहरी मर्ज के लिए फ़िलहाल वर्तमान/आने वाली सामान्य UTF-8 फ़ाइलें आवश्यक हैं। बाइनरी या मिटाने के टकरावों के लिए पूरी फ़ाइल वाले नियंत्रण इस्तेमाल करें।"
