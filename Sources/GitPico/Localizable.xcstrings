    "Choose Current or Incoming for binary files and symbolic links. Link targets are preserved without reading the target file." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر الحالي أو الوارد للملفات الثنائية والروابط الرمزية. يُحتفظ بأهداف الروابط دون قراءة الملف الهدف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria Actual o Entrant per als fitxers binaris i els enllaços simbòlics. Les destinacions dels enllaços es conserven sense llegir el fitxer de destinació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro binární soubory a symbolické odkazy zvolte aktuální nebo příchozí verzi. Cíle odkazů se zachovají bez čtení cílového souboru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg Nuværende eller Indgående for binære filer og symbolske links. Linkmål bevares uden at læse målfilen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle „Aktuell“ oder „Eingehend“ für Binärdateien und symbolische Links. Link-Ziele bleiben erhalten, ohne die Zieldatei zu lesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε Τρέχον ή Εισερχόμενο για δυαδικά αρχεία και συμβολικούς συνδέσμους. Οι στόχοι συνδέσμων διατηρούνται χωρίς ανάγνωση του αρχείου προορισμού."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Actual o Entrante para archivos binarios y enlaces simbólicos. Los destinos de enlace se conservan sin leer el archivo de destino."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Actual o Entrante para archivos binarios y enlaces simbólicos. Los destinos de enlace se conservan sin leer el archivo de destino."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse binaaritiedostoille ja symbolisille linkeille Nykyinen tai Saapuva. Linkkien kohteet säilytetään kohdetiedostoa lukematta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Actuel ou Entrant pour les fichiers binaires et les liens symboliques. Les cibles des liens sont conservées sans lire le fichier cible."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Actuel ou Entrant pour les fichiers binaires et les liens symboliques. Les cibles des liens sont conservées sans lire le fichier cible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עבור קבצים בינאריים וקישורים סמליים, יש לבחור בנוכחי או בנכנס. יעדי הקישורים נשמרים בלי לקרוא את קובץ היעד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाइनरी फ़ाइलों और सिम्बॉलिक लिंक के लिए मौजूदा या आने वाला संस्करण चुनें। लिंक की लक्ष्य फ़ाइल पढ़े बिना उसके लक्ष्य सुरक्षित रखे जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za binarne datoteke i simboličke poveznice odaberite Trenutačno ili Dolazno. Ciljevi poveznica čuvaju se bez čitanja ciljne datoteke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bináris fájlokhoz és szimbolikus linkekhez válassza a Jelenlegi vagy a Bejövő verziót. A linkek célja a célfájl beolvasása nélkül megmarad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih Saat Ini atau Masuk untuk file biner dan tautan simbolis. Target tautan dipertahankan tanpa membaca file target."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli Attuale o In entrata per file binari e link simbolici. Le destinazioni dei link vengono mantenute senza leggere il file di destinazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バイナリファイルとシンボリックリンクには「現在」または「受信側」を選択してください。リンクのターゲットはターゲットファイルを読み込まずに保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바이너리 파일과 심볼릭 링크는 현재 또는 수신을 선택하십시오. 링크 대상은 대상 파일을 읽지 않고 보존됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih Semasa atau Masuk untuk fail binari dan pautan simbolik. Sasaran pautan dikekalkan tanpa membaca fail sasaran."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies 'Huidig' of 'Inkomend' voor binaire bestanden en symbolische links. Linkdoelen blijven behouden zonder het doelbestand te lezen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg Gjeldende eller Innkommende for binærfiler og symbolske lenker. Lenkemål bevares uten at målfilen leses."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla plików binarnych i dowiązań symbolicznych wybierz Bieżący lub Przychodzący. Cele dowiązań są zachowywane bez odczytywania pliku docelowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha Atual ou Recebida para arquivos binários e links simbólicos. Os destinos dos links são preservados sem ler o arquivo de destino."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha Atual ou Recebida para ficheiros binários e ligações simbólicas. Os destinos das ligações são preservados sem ler o ficheiro de destino."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți Curent sau Primit pentru fișiere binare și legături simbolice. Destinațiile legăturilor sunt păstrate fără a citi fișierul țintă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для двоичных файлов и символических ссылок выберите текущую или входящую версию. Цели ссылок сохраняются без чтения целевого файла."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre binárne súbory a symbolické odkazy vyberte Aktuálna alebo Prichádzajúca. Ciele odkazov sa zachovajú bez čítania cieľového súboru."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za dvojiške datoteke in simbolne povezave izberite Trenutno ali Dohodno. Cilji povezav se ohranijo brez branja ciljne datoteke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj Aktuell eller Inkommande för binärfiler och symboliska länkar. Länkmålen bevaras utan att målfilerna läses."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกฉบับปัจจุบันหรือฉบับขาเข้าสำหรับไฟล์ไบนารีและลิงก์สัญลักษณ์ โดยคงปลายทางลิงก์ไว้โดยไม่อ่านไฟล์ปลายทาง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkili dosyalar ve sembolik bağlantılar için Geçerli veya Gelen'i seçin. Bağlantı hedefleri, hedef dosya okunmadan korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для двійкових файлів і символічних посилань виберіть «Поточна» або «Вхідна». Цілі посилань зберігаються без читання цільового файлу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn Hiện tại hoặc Đến cho tệp nhị phân và liên kết tượng trưng. Đích liên kết được giữ nguyên mà không đọc tệp đích."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二進位檔案與符號連結請選擇「目前」或「傳入」。連結目標會保留，不會讀取目標檔案。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于二进制文件和符号链接，请选择“当前”或“传入”。链接目标会被保留，不会读取目标文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二進位檔案與符號連結請選擇「目前」或「傳入」。連結目標會保留，不會讀取目標檔案。"
          }
        }
      }
