    "Device authorization failed. Check the OAuth Client ID and Device Flow settings, then sign in again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل تفويض الجهاز. تحقق من معرّف عميل OAuth وإعدادات تدفق الجهاز، ثم سجّل الدخول مجددًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha fallat l'autorització del dispositiu. Comprova l'identificador de client OAuth i la configuració de Device Flow i torna a iniciar sessió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizace zařízení selhala. Zkontrolujte ID klienta OAuth a nastavení toku autorizace zařízení a poté se znovu přihlaste."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhedsgodkendelse mislykkedes. Kontrollér OAuth-klient-id'et og indstillingerne for enhedsgodkendelse, og log ind igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geräteautorisierung fehlgeschlagen. Prüfe die OAuth-Client-ID und die Device-Flow-Einstellungen und melde dich erneut an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εξουσιοδότηση συσκευής απέτυχε. Ελέγξτε το αναγνωριστικό πελάτη OAuth και τις ρυθμίσεις Device Flow και συνδεθείτε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error en la autorización del dispositivo. Revisa el ID de cliente OAuth y los ajustes de Device Flow y vuelve a iniciar sesión."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error en la autorización del dispositivo. Revisa el ID de cliente OAuth y la configuración de Device Flow y vuelve a iniciar sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteen valtuutus epäonnistui. Tarkista OAuth-asiakastunnus ja laitevaltuutuksen asetukset ja kirjaudu sitten uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
