        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanjsko spajanje trenutačno zahtijeva obične UTF-8 trenutačne/dolazne datoteke. Za binarne sukobe ili sukobe brisanja koristite kontrole cijele datoteke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A külső egyesítéshez jelenleg szabályos UTF-8-fájlok szükségesek az aktuális és a bejövő oldalon. Bináris vagy törlési ütközéseknél használja a teljes fájlra vonatkozó vezérlőket."
          }
        },
        "id" : {
          "stringUnit" : {
