          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værktøjets programfil mangler eller kan ikke køres. Kontrollér indstillingerne for eksterne værktøjer."
          }
        },
        "de" : {
          "stringUnit" : {
