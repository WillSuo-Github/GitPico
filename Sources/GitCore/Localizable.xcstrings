        }
      }
    },
    "Authorization renewed, but Keychain could not save the new token. Unlock Keychain and sign in again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جُدد التفويض، لكن تعذر على سلسلة المفاتيح حفظ الرمز الجديد. افتح قفل سلسلة المفاتيح وسجّل الدخول مجددًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
