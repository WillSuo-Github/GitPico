    "After a successful Pull, push the current branch to its configured upstream." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد نجاح السحب، ادفع الفرع الحالي إلى فرعه المنبع المضبوط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Després d'una baixada correcta, puja la branca actual a la seva branca de seguiment configurada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po úspěšném stažení odešle aktuální větev do jejího nastaveného sledovaného protějšku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send den aktuelle gren til dens konfigurerede opstrømsgren, når hentning og integration er gennemført."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach erfolgreichem Pull den aktuellen Branch zu seinem konfigurierten Upstream pushen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά από επιτυχή άντληση, ωθήστε τον τρέχοντα κλάδο στον διαμορφωμένο ανάντη κλάδο του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras un Pull correcto, hacer push de la rama actual a su upstream configurado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de un Pull exitoso, hacer push de la rama actual a su upstream configurado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetä onnistuneen vedon jälkeen nykyinen haara sen määritettyyn ylävirtaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après un tirage réussi, pousser la branche actuelle vers son amont configuré."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après un tirage réussi, pousser la branche actuelle vers son amont configuré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לאחר משיכה מוצלחת, דחיפת הענף הנוכחי לענף המקור שהוגדר לו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सफल पुल के बाद वर्तमान ब्रांच को उसके कॉन्फ़िगर किए गए अपस्ट्रीम पर पुश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakon uspješnog povlačenja pošalji trenutačnu granu na njezinu konfiguriranu uzvodnu granu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikeres lehúzás után töltse fel az aktuális ágat a beállított követett ágára."
          }
        },
        "id" : {
          "stringUnit" : {
