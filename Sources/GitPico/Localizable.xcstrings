    "Absorbs an embedded Git directory, or restores a missing .git pointer after verifying retained metadata belongs to this path. Working files are preserved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضم مجلد Git مضمنًا، أو يستعيد مؤشر .git مفقودًا بعد التحقق من أن البيانات الوصفية المحتفظ بها تخص هذا المسار. يُحتفظ بملفات العمل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absorbeix un directori de Git integrat o restaura un punter .git que falta després de verificar que les metadades conservades pertanyen a aquest camí. Es conserven els fitxers de treball."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začlení vložený adresář Git nebo obnoví chybějící ukazatel .git po ověření, že zachovaná metadata patří k této cestě. Pracovní soubory zůstanou zachovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indlemmer en indlejret Git-mappe eller gendanner en manglende .git-henvisning efter at have verificeret, at de bevarede metadata tilhører denne sti. Arbejdsfilerne bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übernimmt ein eingebettetes Git-Verzeichnis oder stellt einen fehlenden .git-Zeiger wieder her, nachdem geprüft wurde, dass die behaltenen Metadaten zu diesem Pfad gehören. Arbeitsdateien bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απορροφά έναν ενσωματωμένο κατάλογο Git ή επαναφέρει έναν ελλείποντα δείκτη .git αφού επαληθεύσει ότι τα διατηρημένα μεταδεδομένα ανήκουν σε αυτή τη διαδρομή. Τα αρχεία εργασίας διατηρούνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absorbe un directorio Git incrustado, o restaura un puntero .git ausente tras verificar que los metadatos conservados pertenecen a esta ruta. Se conservan los archivos de trabajo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absorbe un directorio Git incorporado, o restaura un puntero .git ausente después de verificar que los metadatos conservados pertenecen a esta ruta. Se conservan los archivos de trabajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liittää upotetun Git-hakemiston tai palauttaa puuttuvan .git-osoittimen tarkistettuaan, että säilytetyt metatiedot kuuluvat tähän polkuun. Työtiedostot säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absorbe un dossier Git intégré, ou restaure un pointeur .git manquant après avoir vérifié que les métadonnées conservées appartiennent à ce chemin. Les fichiers de travail sont conservés."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absorbe un dossier Git intégré, ou restaure un pointeur .git manquant après avoir vérifié que les métadonnées conservées appartiennent à ce chemin. Les fichiers de travail sont conservés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קולט תיקיית Git מוטמעת, או משחזר מצביע .git חסר לאחר אימות שהמטא־נתונים שנשמרו שייכים לנתיב זה. קובצי העבודה נשמרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एम्बेड की गई Git डायरेक्टरी को समाहित करता है या सुरक्षित रखा गया मेटाडेटा इसी पथ का होने की पुष्टि करके गायब .git पॉइंटर बहाल करता है। वर्किंग फ़ाइलें सुरक्षित रहती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzima ugrađeni Git direktorij ili obnavlja nedostajući pokazivač .git nakon provjere da sačuvani metapodaci pripadaju ovoj putanji. Radne datoteke su sačuvane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beolvaszt egy beágyazott Git-könyvtárat, vagy visszaállít egy hiányzó .git-mutatót, miután ellenőrizte, hogy a megőrzött metaadatok ehhez az útvonalhoz tartoznak. A munkafájlok megmaradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyerap direktori Git tertanam, atau memulihkan penunjuk .git yang hilang setelah memastikan metadata yang dipertahankan milik jalur ini. File kerja dipertahankan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assorbe una directory Git incorporata o ripristina un puntatore .git mancante dopo aver verificato che i metadati mantenuti appartengono a questo percorso. I file di lavoro vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "埋め込まれた Git ディレクトリを取り込むか、保持されたメタデータがこのパスのものであることを確認したうえで、欠落した .git ポインタを復元します。作業ファイルは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내장된 Git 디렉토리를 흡수하거나, 보관된 메타데이터가 이 경로에 속하는지 확인한 후 누락된 .git 포인터를 복원합니다. 작업 파일은 보존됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
