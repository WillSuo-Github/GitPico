    "Updates remote-tracking references without changing your working files. Pruning removes references to branches no longer on the server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدّث مراجع التتبع البعيدة دون تغيير ملفات العمل. يزيل التشذيب مراجع الفروع التي لم تعد موجودة على الخادم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualitza les referències de seguiment remot sense canviar els fitxers de treball. La neteja elimina les referències a branques que ja no són al servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizuje reference sledující vzdálené větve beze změny pracovních souborů. Pročištění odstraní reference na větve, které již na serveru nejsou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdaterer referencer, der sporer fjernlagerets grene, uden at ændre dine arbejdsfiler. Oprydning fjerner referencer til grene, der ikke længere findes på serveren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiert Remote-Tracking-Referenzen, ohne deine Arbeitsdateien zu ändern. Bereinigen entfernt Referenzen auf Branches, die nicht mehr auf dem Server sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενημερώνει τις αναφορές απομακρυσμένης παρακολούθησης χωρίς αλλαγή των αρχείων εργασίας σας. Η εκκαθάριση αφαιρεί αναφορές σε κλάδους που δεν υπάρχουν πλέον στον διακομιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza las referencias de seguimiento remoto sin cambiar tus archivos de trabajo. La poda elimina referencias a ramas que ya no están en el servidor."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza las referencias de seguimiento remoto sin cambiar tus archivos de trabajo. La poda elimina referencias a ramas que ya no están en el servidor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
