          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעדכן הפניות מעקב מרוחקות בלי לשנות את קובצי העבודה שלך. ניקוי מסיר הפניות לענפים שכבר אינם בשרת."
