    "Reconnect an externally moved linked worktree. GitPico verifies that the selected .git file belongs to this registration." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد وصل شجرة عمل مرتبطة نُقلت خارجيًا. يتحقق GitPico من أن ملف .git المحدد ينتمي إلى هذا التسجيل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
