        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een externe merge vereist momenteel normale UTF-8-bestanden voor de huidige en inkomende versie. Gebruik de opties voor het volledige bestand bij binaire conflicten of verwijderingsconflicten."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekstern sammenslåing krever foreløpig at gjeldende og innkommende versjon er vanlige UTF-8-filer. Bruk valgene for hele filen ved binærkonflikter eller slettekonflikter."
          }
