          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo strumento modifica un file di risultato separato. Salva e chiudi lo strumento, controlla il risultato, poi applicalo qui. L'applicazione aggiunge anche questo file allo stage."
