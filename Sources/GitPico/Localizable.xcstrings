    "Preserves the stored content and staging state. The renamed entry moves to the top of the stash list." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحافظ على المحتوى المخزن وحالة التجهيز. ينتقل العنصر المعاد تسميته إلى أعلى قائمة المخابئ."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva el contingut emmagatzemat i l'estat de preparació. L'entrada amb el nom canviat es mou al capdamunt de la llista de reserves."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachová uložený obsah i stav přípravy. Přejmenovaná položka se přesune na začátek seznamu odložených změn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevarer det gemte indhold og klargøringstilstanden. Den omdøbte post flyttes øverst på listen over gemte ændringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält gespeicherten Inhalt und Staging-Zustand. Der umbenannte Eintrag wandert an den Anfang der Stash-Liste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διατηρεί το αποθηκευμένο περιεχόμενο και την κατάσταση προετοιμασίας. Η μετονομασμένη καταχώριση μετακινείται στην κορυφή της λίστας προσωρινών αποθηκεύσεων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva el contenido guardado y el estado de preparación. La entrada renombrada pasa al principio de la lista de stashes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva el contenido guardado y el estado de preparación. La entrada renombrada pasa al principio de la lista de stashes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilyttää tallennetun sisällön ja valmistelutilan. Uudelleen nimetty kohde siirtyy kätköluettelon alkuun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préserve le contenu enregistré et l’état de l’index. L’entrée renommée passe en haut de la liste des remises."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préserve le contenu enregistré et l’état de l’index. L’entrée renommée passe en haut de la liste des remises."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שומר על התוכן המאוחסן ועל מצב ההכנה לקומיט. הרשומה ששמה שונה עוברת לראש רשימת האחסונים הזמניים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजी गई सामग्री और स्टेज की स्थिति बनी रहती है। नाम बदली गई प्रविष्टि स्टैश सूची में सबसे ऊपर चली जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čuva spremljeni sadržaj i stanje pripreme. Preimenovana stavka premješta se na vrh popisa privremeno spremljenih promjena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megőrzi a tárolt tartalmat és az előkészítési állapotot. Az átnevezett bejegyzés a félretételek listájának tetejére kerül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mempertahankan konten tersimpan dan status persiapan. Entri yang diubah namanya dipindahkan ke bagian atas daftar simpanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene il contenuto memorizzato e lo stato dello stage. La voce rinominata passa in cima all'elenco degli stash."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された内容とステージの状態は保持されます。名前を変更した項目はスタッシュリストの先頭に移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 내용과 스테이징 상태를 보존합니다. 이름이 변경된 항목은 스태시 목록의 맨 위로 이동합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengekalkan kandungan tersimpan dan keadaan pementasan. Entri yang dinamakan semula dipindahkan ke bahagian atas senarai simpanan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behoudt de opgeslagen inhoud en stagingstatus. Het hernoemde onderdeel komt bovenaan de stashlijst te staan."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevarer det lagrede innholdet og klargjøringstilstanden. Oppføringen med nytt navn flyttes øverst i listen over midlertidige lagringer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowuje zapisaną zawartość i stan indeksu. Element o zmienionej nazwie przenosi się na górę listy schowków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preserva o conteúdo armazenado e o estado de preparação. O item renomeado vai para o topo da lista de stashes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preserva o conteúdo armazenado e o estado de preparação. O item renomeado vai para o topo da lista de stashes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstrează conținutul stocat și starea de pregătire. Intrarea redenumită se mută în partea de sus a listei de stocări temporare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет содержимое и состояние индекса. Переименованная запись перемещается в начало списка стешей."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachová uložený obsah aj stav prípravy. Premenovaná položka sa presunie na začiatok zoznamu odložených zmien."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohrani shranjeno vsebino in stanje pripravljenih sprememb. Preimenovani vnos se premakne na vrh seznama zalog."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevarar det lagrade innehållet och mellanlagringsstatusen. Posten med det nya namnet flyttas överst i listan över tillfälliga lagringar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รักษาเนื้อหาและสถานะการจัดเตรียมที่เก็บไว้ รายการที่เปลี่ยนชื่อจะย้ายไปบนสุดของรายการพัก"
          }
        },
        "tr" : {
          "stringUnit" : {
