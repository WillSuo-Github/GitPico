    "Clears the clean submodule working directory and its local registration. The parent gitlink and retained Git history remain available for later initialization." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمسح مجلد عمل الوحدة الفرعية النظيف وتسجيلها المحلي. يبقى gitlink في المستودع الأصل وسجل Git المحتفظ به متاحين للتهيئة لاحقًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neteja el directori de treball net del submòdul i el seu registre local. El gitlink del pare i l'historial de Git conservat continuen disponibles per inicialitzar-lo més endavant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vymaže čistý pracovní adresář podmodulu a jeho místní registraci. Gitlink nadřazeného repozitáře i uchovaná historie Gitu zůstanou dostupné pro pozdější inicializaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rydder undermodulets arbejdsmappe uden ændringer og fjerner dets lokale registrering. Det overordnede kodelagers gitlink og den bevarede Git-historik er stadig tilgængelige til senere initialisering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leert das saubere Submodul-Arbeitsverzeichnis und seine lokale Registrierung. Der Gitlink des Parents und der behaltene Git-Verlauf bleiben für eine spätere Initialisierung verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκκαθαρίζει τον καθαρό κατάλογο εργασίας της υπομονάδας και την τοπική καταχώρισή της. Το γονικό gitlink και το διατηρημένο ιστορικό Git παραμένουν διαθέσιμα για μελλοντική αρχικοποίηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacía el directorio de trabajo limpio del submódulo y su registro local. El gitlink del padre y el historial Git conservado siguen disponibles para inicializarlo más adelante."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacía el directorio de trabajo limpio del submódulo y su registro local. El gitlink del padre y el historial Git conservado siguen disponibles para inicializarlo más adelante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyhjentää puhtaan alimoduulin työhakemiston ja sen paikallisen rekisteröinnin. Ylätason gitlink ja säilytetty Git-historia jäävät käytettäviksi myöhempää alustusta varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vide le dossier de travail propre du sous-module et son enregistrement local. Le gitlink parent et l’historique Git conservé restent disponibles pour une initialisation ultérieure."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vide le dossier de travail propre du sous-module et son enregistrement local. Le gitlink parent et l’historique Git conservé restent disponibles pour une initialisation ultérieure."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מנקה את תיקיית העבודה הנקייה של תת־המודול ואת הרישום המקומי שלו. ה־gitlink של ההורה והיסטוריית ה־Git שנשמרה נותרים זמינים לאתחול בהמשך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना बदलाव वाली सबमॉड्यूल वर्किंग डायरेक्टरी और उसका स्थानीय पंजीकरण हटाता है। पैरेंट gitlink और सुरक्षित Git इतिहास बाद में आरंभ करने के लिए उपलब्ध रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanja čisti radni direktorij podmodula i njegovu lokalnu registraciju. Nadređeni gitlink i sačuvana Git povijest ostaju dostupni za kasniju inicijalizaciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
