    "Conflict draft storage could not be read. Export your edits before closing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذرت قراءة تخزين مسودات التعارض. صدّر تعديلاتك قبل الإغلاق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut llegir l'emmagatzematge d'esborranys de conflictes. Exporta els canvis abans de tancar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úložiště konceptů řešení konfliktů nelze přečíst. Před zavřením exportujte své úpravy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lageret til konfliktkladder kunne ikke læses. Eksportér dine ændringer, før du lukker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speicher für Konfliktentwürfe konnte nicht gelesen werden. Exportiere deine Änderungen vor dem Schließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάγνωση του χώρου αποθήκευσης προσχεδίων διενέξεων. Εξαγάγετε τις αλλαγές σας πριν κλείσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el almacenamiento de borradores de conflictos. Exporta tus ediciones antes de cerrar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el almacenamiento de borradores de conflictos. Exporta tus ediciones antes de cerrar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ristiriitaluonnoksia ei voitu lukea. Vie muokkauksesi ennen sulkemista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le stockage des brouillons de conflit. Exportez vos modifications avant de fermer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le stockage des brouillons de conflit. Exportez vos modifications avant de fermer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לקרוא את אחסון טיוטות ההתנגשויות. יש לייצא את העריכות לפני הסגירה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टकराव ड्राफ़्ट संग्रहण पढ़ा नहीं जा सका। बंद करने से पहले अपने संपादन निर्यात करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće pročitati pohranu skica sukoba. Izvezite izmjene prije zatvaranja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült olvasni az ütközési piszkozatok tárolóját. Bezárás előtt exportálja a szerkesztéseit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
