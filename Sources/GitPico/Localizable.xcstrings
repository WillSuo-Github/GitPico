          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なリポジトリに対して認可されたトークンを使用してください。アカウントの確認では ID を、「リモートをテスト」では読み取りアクセスを確認します。プッシュの権限はプッシュ時にサーバで検証されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
