    "Verify the SSH host fingerprint with your hosting service, then trust it using your system SSH setup. GitPico does not bypass host verification." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من بصمة مضيف SSH لدى خدمة الاستضافة، ثم وثقها باستخدام إعدادات SSH للنظام. لا يتجاوز GitPico التحقق من المضيف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica l'empremta de l'amfitrió SSH amb el servei d'allotjament i confia-hi amb la configuració SSH del sistema. GitPico no omet la verificació d'amfitrions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ověřte otisk klíče hostitele SSH u své hostingové služby a poté jej označte za důvěryhodný v systémovém nastavení SSH. GitPico neobchází ověřování hostitele."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollér SSH-værtens fingeraftryk hos din hostingudbyder, og markér derefter værten som betroet i systemets SSH-opsætning. GitPico omgår ikke værtskontrollen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifiziere den SSH-Host-Fingerabdruck bei deinem Hosting-Dienst und vertraue ihm dann über deine System-SSH-Konfiguration. GitPico umgeht die Hostprüfung nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαληθεύστε το αποτύπωμα διακομιστή SSH με την υπηρεσία φιλοξενίας σας και δηλώστε το έμπιστο μέσω των ρυθμίσεων SSH του συστήματός σας. Το GitPico δεν παρακάμπτει την επαλήθευση διακομιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica la huella del host SSH con tu servicio de alojamiento y luego confía en ella con la configuración SSH del sistema. GitPico no omite la verificación de hosts."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica la huella del host SSH con tu servicio de alojamiento y luego confía en ella con la configuración SSH del sistema. GitPico no omite la verificación de hosts."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmenna SSH-palvelimen sormenjälki palveluntarjoajaltasi ja määritä se sitten luotetuksi järjestelmäsi SSH-asetuksissa. GitPico ei ohita palvelimen varmennusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez l’empreinte de l’hôte SSH auprès de votre service d’hébergement, puis approuvez-la à l’aide de la configuration SSH de votre système. GitPico ne contourne pas la vérification des hôtes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez l’empreinte de l’hôte SSH auprès de votre service d’hébergement, puis approuvez-la à l’aide de la configuration SSH de votre système. GitPico ne contourne pas la vérification des hôtes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לאמת את טביעת האצבע של מארח SSH מול שירות האירוח שלך, ואז לתת בה אמון בהגדרות SSH של המערכת. GitPico אינו עוקף אימות מארחים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी होस्टिंग सेवा से SSH होस्ट फ़िंगरप्रिंट सत्यापित करें, फिर अपने सिस्टम के SSH सेटअप से उसे विश्वसनीय बनाएँ। GitPico होस्ट सत्यापन को बायपास नहीं करता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjerite otisak SSH ključa poslužitelja kod usluge koja udomljuje repozitorij, a zatim ga označite pouzdanim u postavkama SSH-a sustava. GitPico ne zaobilazi provjeru poslužitelja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellenőrizze az SSH-kiszolgáló ujjlenyomatát a tárhelyszolgáltatójánál, majd állítsa megbízhatóra a rendszer SSH-beállításaival. A GitPico nem kerüli meg a kiszolgáló ellenőrzését."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifikasi sidik jari host SSH dengan layanan hosting Anda, lalu percayai host tersebut menggunakan konfigurasi SSH sistem Anda. GitPico tidak melewati verifikasi host."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica l'impronta dell'host SSH con il servizio di hosting, poi rendila attendibile nella configurazione SSH di sistema. GitPico non aggira la verifica degli host."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスティングサービスで SSH ホストのフィンガープリントを確認してから、システムの SSH 設定で信頼してください。GitPico がホスト検証を省略することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스팅 서비스에서 SSH 호스트 지문을 확인한 다음 시스템 SSH 설정을 사용하여 신뢰하십시오. GitPico는 호스트 확인을 우회하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sahkan cap jari hos SSH dengan perkhidmatan pengehosan anda, kemudian percayainya melalui persediaan SSH sistem anda. GitPico tidak memintas pengesahan hos."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifieer de SSH-hostvingerafdruk bij je hostingdienst en vertrouw deze daarna via je SSH-systeemconfiguratie. GitPico omzeilt hostverificatie niet."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroller SSH-vertens fingeravtrykk hos vertstjenesten din, og angi deretter verten som klarert i systemets SSH-oppsett. GitPico omgår ikke vertsverifisering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zweryfikuj odcisk hosta SSH w usłudze hostingu, a następnie zaufaj mu przy użyciu systemowej konfiguracji SSH. GitPico nie omija weryfikacji hostów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique a impressão digital do host SSH com o serviço de hospedagem e confie nela usando a configuração SSH do sistema. O GitPico não ignora a verificação de hosts."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique a impressão digital do host SSH com o serviço de alojamento e marque-a como fidedigna na configuração SSH do sistema. O GitPico não ignora a verificação de hosts."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificați amprenta gazdei SSH cu serviciul de găzduire, apoi acordați-i încredere folosind configurarea SSH a sistemului. GitPico nu ocolește verificarea gazdei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сверьте отпечаток хоста SSH со службой хостинга, затем добавьте его в доверенные в системной конфигурации SSH. GitPico не обходит проверку хостов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overte odtlačok hostiteľa SSH u svojej hostingovej služby a potom mu nastavte dôveru v systémovej konfigurácii SSH. GitPico neobchádza overovanie hostiteľa."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri storitvi gostovanja preverite prstni odtis gostitelja SSH, nato mu zaupajte v sistemskih nastavitvah SSH. GitPico ne obide preverjanja gostitelja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollera SSH-värdens fingeravtryck hos din värdtjänst och ange sedan att du litar på värden i systemets SSH-konfiguration. GitPico kringgår inte värdverifieringen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบลายนิ้วมือโฮสต์ SSH กับผู้ให้บริการโฮสต์ แล้วกำหนดให้เชื่อถือผ่านการตั้งค่า SSH ของระบบ GitPico จะไม่ข้ามการตรวจสอบโฮสต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH sunucu parmak izini barındırma hizmetinizle doğrulayın, ardından sistem SSH ayarlarınızla güvenilir olarak işaretleyin. GitPico sunucu doğrulamasını atlamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте відбиток хоста SSH у своєму сервісі хостингу, а потім додайте його до довірених у системних параметрах SSH. GitPico не обходить перевірку хостів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xác minh dấu vân tay máy chủ SSH với dịch vụ lưu trữ, rồi tin cậy qua cấu hình SSH hệ thống. GitPico không bỏ qua xác minh máy chủ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請向你的代管服務驗證 SSH 主機指紋，然後使用系統 SSH 設定信任它。GitPico 不會略過主機驗證。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请向托管服务核实 SSH 主机指纹，然后通过系统 SSH 设置信任它。GitPico 不会绕过主机验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請向你的代管服務驗證 SSH 主機指紋，然後使用系統 SSH 設定信任它。GitPico 不會略過主機驗證。"
          }
        }
      }
    },
