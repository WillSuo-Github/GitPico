    "%@ This may remove another person's lock." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ قد يزيل هذا قفل شخص آخر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Això pot eliminar el bloqueig d'una altra persona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Tím můžete odstranit zámek jiné osoby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Dette kan fjerne en anden persons lås."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Dadurch wird möglicherweise die Sperre einer anderen Person entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Αυτό μπορεί να καταργήσει το κλείδωμα άλλου χρήστη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Esto puede eliminar el bloqueo de otra persona."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Esto puede eliminar el bloqueo de otra persona."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Tämä voi poistaa jonkun toisen lukituksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cela peut supprimer le verrou d’une autre personne."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cela peut supprimer le verrou d’une autre personne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ פעולה זו עלולה להסיר נעילה של מישהו אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ इससे किसी अन्य व्यक्ति का लॉक हट सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Time se može ukloniti tuđe zaključavanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ez más felhasználó zárolását is eltávolíthatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ini dapat menghapus kunci milik orang lain."
