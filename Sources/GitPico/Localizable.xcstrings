    "Run an operation to see its progress and latest result here." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führen Sie einen Vorgang aus, um hier den Fortschritt und das letzte Ergebnis zu sehen."
