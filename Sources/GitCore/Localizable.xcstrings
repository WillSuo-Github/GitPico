    "HEAD, staging or branches changed outside this flow. Existing changes were kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغير HEAD أو التجهيز أو الفروع خارج سير العمل هذا. حُفظت التغييرات الموجودة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD, l'àrea de preparació o les branques han canviat fora d'aquest flux. S'han conservat els canvis existents."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD, přípravná oblast nebo větve se změnily mimo tento postup. Stávající změny byly zachovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD, klargøring eller grene blev ændret uden for dette forløb. Eksisterende ændringer blev bevaret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD, Staging oder Branches wurden außerhalb dieses Ablaufs geändert. Vorhandene Änderungen wurden behalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το HEAD, η προετοιμασία ή οι κλάδοι άλλαξαν εκτός αυτής της ροής. Οι υπάρχουσες αλλαγές διατηρήθηκαν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD, la preparación o las ramas cambiaron fuera de este flujo. Se conservaron los cambios existentes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD, la preparación o las ramas cambiaron fuera de este flujo. Se conservaron los cambios existentes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD, valmistelu tai haarat muuttuivat tämän työnkulun ulkopuolella. Nykyiset muutokset säilytettiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD, l’index ou les branches ont changé en dehors de ce flux. Les modifications existantes ont été conservées."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD, l’index ou les branches ont changé en dehors de ce flux. Les modifications existantes ont été conservées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD, ההכנה לקומיט או הענפים השתנו מחוץ לתהליך זה. השינויים הקיימים נשמרו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस फ़्लो के बाहर HEAD, स्टेजिंग या ब्रांच बदल गईं। मौजूदा बदलाव सुरक्षित रखे गए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD, pripremljene promjene ili grane promijenjeni su izvan ovog tijeka. Postojeće promjene su sačuvane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A HEAD, az előkészítés állapota vagy az ágak a folyamaton kívül megváltoztak. A meglévő módosítások megmaradtak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
