          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้แผงรีเบสแบบโต้ตอบที่คงการผสานไว้สำหรับช่วงนี้ การลากเพื่อจัดลำดับใหม่ต้องใช้ช่วงแบบเส้นตรง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aralık için birleştirmeleri koruyan Etkileşimli Yeniden Temellendirme sayfasını kullanın; sürükleyerek sıralama doğrusal aralık gerektirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для цього діапазону скористайтеся аркушем інтерактивного перебазування зі збереженням злиттів; зміна порядку перетягуванням потребує лінійного діапазону."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng bảng Rebase tương tác giữ hợp nhất cho phạm vi này; sắp xếp lại bằng kéo yêu cầu phạm vi tuyến tính."
          }
        },
        "zh-HK" : {
