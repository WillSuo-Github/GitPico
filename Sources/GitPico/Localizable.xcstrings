        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigurnosne kopije ostaju nakon ponovnog pokretanja aplikacije. Obnova je blokirana ako su zahvaćene datoteke, pripremljene promjene ili HEAD naknadno promijenjeni."
