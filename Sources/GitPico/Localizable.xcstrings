    "You edited the commit message while AI was writing, so it was kept. Click AI again to replace it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدّلت رسالة الإيداع أثناء كتابة الذكاء الاصطناعي، لذا حُفظت. انقر على الذكاء الاصطناعي مجددًا لاستبدالها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has editat el missatge de commit mentre la IA escrivia, de manera que s'ha conservat. Torna a fer clic a IA per substituir-lo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během psaní pomocí AI jste upravili zprávu commitu, proto byla zachována. Kliknutím na AI ji nahradíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du redigerede commitbeskeden, mens AI skrev, så din besked blev bevaret. Klik på AI igen for at erstatte den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast die Commit-Nachricht bearbeitet, während die KI geschrieben hat, daher wurde sie behalten. Klicke erneut auf „KI“, um sie zu ersetzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επεξεργαστήκατε το μήνυμα υποβολής ενώ έγραφε η ΤΝ, οπότε διατηρήθηκε. Κάντε ξανά κλικ στην ΤΝ για να το αντικαταστήσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editaste el mensaje de commit mientras la IA lo escribía, así que se conservó. Vuelve a hacer clic en IA para sustituirlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editaste el mensaje de commit mientras la IA lo escribía, así que se conservó. Vuelve a hacer clic en IA para reemplazarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muokkasit tallennusviestiä tekoälyn kirjoittaessa, joten viestisi säilytettiin. Korvaa se klikkaamalla tekoälypainiketta uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez modifié le message de commit pendant que l’IA le rédigeait ; il a donc été conservé. Cliquez à nouveau sur IA pour le remplacer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez modifié le message de commit pendant que l’IA le rédigeait; il a donc été conservé. Cliquez à nouveau sur IA pour le remplacer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ערכת את הודעת הקומיט בזמן שהבינה המלאכותית כתבה, ולכן היא נשמרה. יש ללחוץ שוב על בינה מלאכותית כדי להחליף אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI के लिखते समय आपने कमिट संदेश बदला था, इसलिए आपका संदेश रखा गया है। इसे बदलने के लिए फिर AI पर क्लिक करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
