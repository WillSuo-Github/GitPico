    "Raw export requires a regular file. Choose Archive to preserve this entry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب التصدير الخام ملفًا عاديًا. اختر الأرشفة للحفاظ على هذا العنصر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'exportació en brut requereix un fitxer normal. Tria Arxiva per conservar aquesta entrada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export bez úprav vyžaduje běžný soubor. Pro zachování této položky vyberte Archiv."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rå eksport kræver en almindelig fil. Vælg Arkiv for at bevare dette element."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Rohexport erfordert eine reguläre Datei. Wähle „Archivieren“, um diesen Eintrag zu erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ακατέργαστη εξαγωγή απαιτεί κανονικό αρχείο. Επιλέξτε Αρχειοθέτηση για να διατηρήσετε αυτή την καταχώριση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La exportación sin procesar requiere un archivo normal. Elige Archivar para conservar esta entrada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
