          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raakavienti edellyttää tavallista tiedostoa. Säilytä tämä kohde valitsemalla Arkisto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’exportation brute nécessite un fichier standard. Choisissez Archiver pour conserver cette entrée."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’exportation brute nécessite un fichier standard. Choisissez Archiver pour conserver cette entrée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייצוא גולמי דורש קובץ רגיל. יש לבחור בארכיון כדי לשמור פריט זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मूल रूप में निर्यात के लिए सामान्य फ़ाइल चाहिए। इस आइटम को सुरक्षित रखने के लिए संग्रह चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirovi izvoz zahtijeva običnu datoteku. Odaberite Arhiviraj za očuvanje ove stavke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nyers exportáláshoz normál fájl szükséges. Az elem megőrzéséhez válassza az Archiválás lehetőséget."
