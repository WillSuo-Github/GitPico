    "The CLI did not return a commit message. Check its login and model configuration, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُرجع أداة سطر الأوامر رسالة إيداع. تحقق من تسجيل الدخول وإعداد النموذج، ثم أعد المحاولة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La CLI no ha retornat cap missatge de commit. Comprova'n l'inici de sessió i la configuració del model i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CLI nevrátilo zprávu commitu. Zkontrolujte přihlášení a nastavení modelu a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CLI returnerede ingen commitbesked. Kontrollér login og modelopsætning, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
