    "Check the repository's GPG/SSH verifier and trusted keys. A missing verifier or key does not establish an invalid signature." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من أداة التحقق GPG/SSH والمفاتيح الموثوقة للمستودع. غياب الأداة أو المفتاح لا يثبت بطلان التوقيع."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprova el verificador GPG/SSH del repositori i les claus de confiança. Que falti un verificador o una clau no demostra que la signatura no sigui vàlida."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte ověřovač GPG/SSH a důvěryhodné klíče repozitáře. Chybějící ověřovač nebo klíč neprokazuje neplatnost podpisu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollér kodelagerets GPG/SSH-verifikationsværktøj og betroede nøgler. En manglende nøgle eller et manglende verifikationsværktøj betyder ikke, at signaturen er ugyldig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe den GPG/SSH-Verifizierer und die vertrauenswürdigen Schlüssel des Repositorys. Ein fehlender Verifizierer oder Schlüssel bedeutet keine ungültige Signatur."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
