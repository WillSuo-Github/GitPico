    "Submodules are exported as empty directories; their separate repositories are not included." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُصدّر الوحدات الفرعية كمجلدات فارغة؛ ولا تُضمّن مستودعاتها المنفصلة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els submòduls s'exporten com a directoris buits; no s'inclouen els seus repositoris separats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podmoduly se exportují jako prázdné adresáře; jejich samostatné repozitáře nejsou zahrnuty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undermoduler eksporteres som tomme mapper. Deres separate kodelagre medtages ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Submodule werden als leere Verzeichnisse exportiert; ihre separaten Repositorys sind nicht enthalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι υπομονάδες εξάγονται ως κενοί κατάλογοι· τα ξεχωριστά αποθετήριά τους δεν περιλαμβάνονται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los submódulos se exportan como directorios vacíos; sus repositorios independientes no se incluyen."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los submódulos se exportan como directorios vacíos; sus repositorios independientes no se incluyen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alimoduulit viedään tyhjinä hakemistoina; niiden erillisiä tietovarastoja ei sisällytetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-modules sont exportés sous forme de répertoires vides ; leurs dépôts distincts ne sont pas inclus."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-modules sont exportés sous forme de répertoires vides; leurs dépôts distincts ne sont pas inclus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תת־מודולים מיוצאים כתיקיות ריקות; המאגרים הנפרדים שלהם אינם נכללים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबमॉड्यूल खाली डायरेक्टरी के रूप में निर्यात होते हैं; उनकी अलग रिपॉज़िटरी शामिल नहीं होतीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podmoduli se izvoze kao prazni direktoriji; njihovi zasebni repozitoriji nisu uključeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az almodulok üres könyvtárként lesznek exportálva; külön tárolóik nem kerülnek bele."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Submodul diekspor sebagai direktori kosong; repositori terpisahnya tidak disertakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I sottomoduli vengono esportati come cartelle vuote; i loro repository separati non sono inclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブモジュールは空のディレクトリとして書き出されます。サブモジュールの個別のリポジトリは含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서브모듈은 빈 디렉터리로 내보내며, 각 서브모듈의 별도 저장소는 포함되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Submodul dieksport sebagai direktori kosong; repositori berasingannya tidak disertakan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Submodules worden als lege mappen geëxporteerd; hun afzonderlijke repositories worden niet meegenomen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undermoduler eksporteres som tomme mapper. De separate kodelagrene deres tas ikke med."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podmoduły są eksportowane jako puste katalogi; ich odrębne repozytoria nie są uwzględniane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os submódulos são exportados como diretórios vazios; seus repositórios separados não são incluídos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
