        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH_AUTH_SOCK nije postavljen za ovu aplikaciju. SSH možda i dalje koristi ključeve iz sustavskih SSH postavki."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az SSH_AUTH_SOCK nincs beállítva ehhez az alkalmazáshoz. Az SSH ettől még használhatja a rendszer SSH-beállításaiban megadott kulcsokat."
          }
