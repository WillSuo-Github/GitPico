          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met à jour les références de suivi distantes sans modifier vos fichiers de travail. L’élagage supprime les références aux branches qui n’existent plus sur le serveur."
          }
