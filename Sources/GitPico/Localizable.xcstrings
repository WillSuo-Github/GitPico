          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git sau serverul poate fi deja modificat. Examinați starea reîmprospătată înainte de a reîncerca. Trimiterea și preluarea cu integrare nu sunt reîncercate niciodată automat."
          }
        },
        "ru" : {
          "stringUnit" : {
