    "Rebase is not stopped at an editable commit, or the message is empty." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعادة التأسيس ليست متوقفة عند إيداع قابل للتعديل، أو أن الرسالة فارغة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rebase no està aturat en un commit editable, o el missatge és buit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přeskládání není zastaveno na upravitelném commitu nebo je zpráva prázdná."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombaseringen er ikke stoppet ved et commit, der kan redigeres, eller beskeden er tom."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Rebase ist nicht an einem bearbeitbaren Commit angehalten oder die Nachricht ist leer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναθεμελίωση δεν έχει σταματήσει σε επεξεργάσιμη υποβολή ή το μήνυμα είναι κενό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rebase no está detenido en un commit editable, o el mensaje está vacío."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rebase no está detenido en un commit editable, o el mensaje está vacío."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudelleenpohjustus ei ole pysähtynyt muokattavaan tallennukseen tai viesti on tyhjä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rebasage n’est pas arrêté sur un commit modifiable, ou le message est vide."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rebasage n’est pas arrêté sur un commit modifiable, ou le message est vide."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שינוי הבסיס אינו מושהה בקומיט הניתן לעריכה, או שההודעה ריקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रीबेस संपादन योग्य कमिट पर रुका नहीं है, या संदेश खाली है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preslagivanje nije zaustavljeno na predaji koja se može urediti ili je poruka prazna."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az újraalapozás nem szerkeszthető véglegesítésnél állt meg, vagy az üzenet üres."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebase tidak berhenti pada komit yang dapat diedit, atau pesannya kosong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rebase non è fermo su un commit modificabile oppure il messaggio è vuoto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リベースが編集可能なコミットで停止していないか、メッセージが空です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
