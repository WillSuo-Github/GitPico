    "Saved before %@. Finish or abort the Git operation to restore the saved changes and index." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُفظت قبل %@. أنهِ عملية Git أو أجهضها لاستعادة التغييرات والفهرس المحفوظين."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desat abans de %@. Finalitza o avorta l'operació de Git per restaurar els canvis i l'índex desats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloženo před operací %@. Dokončete nebo přerušte operaci Git, aby se obnovily uložené změny a index."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemt før %@. Fuldfør eller afbryd Git-handlingen for at gendanne de gemte ændringer og indekset."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesichert vor %@. Schließe den Git-Vorgang ab oder brich ihn ab, um die gesicherten Änderungen und den Index wiederherzustellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύτηκε πριν από %@. Ολοκληρώστε ή ματαιώστε τη λειτουργία Git για επαναφορά των αποθηκευμένων αλλαγών και του ευρετηρίου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado antes de %@. Termina o aborta la operación Git para restaurar los cambios guardados y el índice."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado antes de %@. Termina o aborta la operación Git para restaurar los cambios guardados y el índice."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
