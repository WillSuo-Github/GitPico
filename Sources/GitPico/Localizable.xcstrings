    "Append keeps your current draft. Replace uses the first line as the summary and the remaining text as the description." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقي الإلحاق مسودتك الحالية. يستخدم الاستبدال السطر الأول ملخصًا وبقية النص وصفًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegir conserva l'esborrany actual. Substituir fa servir la primera línia com a resum i la resta del text com a descripció."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojením zachováte aktuální koncept. Nahrazení použije první řádek jako shrnutí a zbývající text jako popis."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj bevarer din nuværende kladde. Erstat bruger første linje som overskrift og resten af teksten som beskrivelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Anhängen“ behält deinen aktuellen Entwurf. „Ersetzen“ verwendet die erste Zeile als Zusammenfassung und den restlichen Text als Beschreibung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η προσάρτηση διατηρεί το τρέχον προσχέδιο. Η αντικατάσταση χρησιμοποιεί την πρώτη γραμμή ως σύνοψη και το υπόλοιπο κείμενο ως περιγραφή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir conserva tu borrador actual. Sustituir usa la primera línea como resumen y el resto del texto como descripción."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anexar conserva tu borrador actual. Reemplazar usa la primera línea como resumen y el resto del texto como descripción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisääminen säilyttää nykyisen luonnoksen. Korvaaminen käyttää ensimmäistä riviä yhteenvetona ja loppua kuvauksena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter conserve votre brouillon actuel. Remplacer utilise la première ligne comme résumé et le reste du texte comme description."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter conserve votre brouillon actuel. Remplacer utilise la première ligne comme résumé et le reste du texte comme description."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוספה שומרת על הטיוטה הנוכחית. החלפה משתמשת בשורה הראשונה כתקציר וביתר הטקסט כתיאור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अंत में जोड़ने पर आपका वर्तमान ड्राफ़्ट बना रहता है। बदलने पर पहली पंक्ति सारांश और बाकी पाठ विवरण बनता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodavanje čuva trenutačnu skicu. Zamjena koristi prvi redak kao sažetak, a preostali tekst kao opis."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Hozzáfűzés a leíráshoz megőrzi az aktuális piszkozatot. A Csere az első sort összefoglalóként, a többi szöveget leírásként használja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan mempertahankan draf Anda saat ini. Ganti menggunakan baris pertama sebagai ringkasan dan teks yang tersisa sebagai deskripsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accoda mantiene la bozza attuale. Sostituisci usa la prima riga come riepilogo e il testo rimanente come descrizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「追加」は現在の下書きを保持します。「置き換え」は 1 行目を概要、残りのテキストを説明として使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가하면 현재 초안이 유지됩니다. 대치하면 첫 번째 줄은 요약으로, 나머지 텍스트는 설명으로 사용됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah pada Perihalan mengekalkan draf semasa anda. Ganti menggunakan baris pertama sebagai ringkasan dan teks selebihnya sebagai perihalan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij toevoegen blijft je huidige concept behouden. Bij vervangen wordt de eerste regel de samenvatting en de resterende tekst de beschrijving."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til beholder det gjeldende utkastet. Erstatt bruker første linje som sammendrag og resten av teksten som beskrivelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołącz zachowuje bieżącą wersję roboczą. Zastąp używa pierwszego wiersza jako podsumowania, a pozostałego tekstu jako opisu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anexar mantém o rascunho atual. Substituir usa a primeira linha como resumo e o restante como descrição."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anexar mantém o rascunho atual. Substituir usa a primeira linha como resumo e o restante como descrição."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adăugarea păstrează ciorna curentă. Înlocuirea folosește prima linie ca rezumat, iar restul textului ca descriere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Дописать» сохраняет текущий черновик. «Заменить» использует первую строку как заголовок, а остальной текст — как описание."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripojenie zachová aktuálny koncept. Nahradenie použije prvý riadok ako súhrn a zvyšný text ako popis."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajanje ohrani trenutni osnutek. Zamenjava uporabi prvo vrstico kot povzetek, preostalo besedilo pa kot opis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till behåller ditt nuvarande utkast. Ersätt använder den första raden som sammanfattning och resten av texten som beskrivning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การต่อท้ายจะเก็บฉบับร่างปัจจุบันไว้ การแทนที่จะใช้บรรทัดแรกเป็นสรุปและข้อความที่เหลือเป็นคำอธิบาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekle, geçerli taslağınızı korur. Değiştir, ilk satırı özet, kalan metni açıklama olarak kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Додати» зберігає вашу поточну чернетку. «Замінити» використовує перший рядок як підсумок, а решту тексту — як опис."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nối thêm giữ lại bản nháp hiện tại. Thay thế dùng dòng đầu làm tóm tắt và phần còn lại làm mô tả."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「附加」會保留目前的草稿。「取代」會將第一行作為摘要，其餘文字作為描述。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“追加”会保留当前草稿。“替换”会将第一行用作摘要，其余文本用作描述。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「附加」會保留目前的草稿。「取代」會將第一行作為摘要，其餘文字作為描述。"
          }
        }
      }
    },
