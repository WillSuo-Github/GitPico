    "Export app/build and repository state with sanitized recent network diagnostics. File contents, commit messages, account credentials and private keys are excluded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صدّر حالة التطبيق/البناء والمستودع مع بيانات تشخيص الشبكة الحديثة المنقحة. تُستبعد محتويات الملفات ورسائل الإيداع وبيانات اعتماد الحسابات والمفاتيح الخاصة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta l'estat de l'app/compilació i del repositori amb diagnòstics de xarxa recents depurats. S'exclouen el contingut dels fitxers, els missatges de commit, les credencials dels comptes i les claus privades."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportuje stav aplikace, sestavení a repozitáře s očištěnou nedávnou diagnostikou sítě. Obsah souborů, zprávy commitů, přihlašovací údaje účtů a soukromé klíče jsou vyloučeny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporter oplysninger om appen, dens build og kodelagerets tilstand samt rensede diagnosticeringsdata fra den seneste netværksaktivitet. Filindhold, commitbeskeder, loginoplysninger og private nøgler udelades."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-/Build- und Repository-Status mit bereinigten aktuellen Netzwerkdiagnosen exportieren. Dateiinhalte, Commit-Nachrichten, Account-Anmeldedaten und private Schlüssel sind ausgeschlossen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εξαγωγή κατάστασης εφαρμογής/δομής και αποθετηρίου με ανωνυμοποιημένα πρόσφατα διαγνωστικά δικτύου. Εξαιρούνται περιεχόμενα αρχείων, μηνύματα υποβολής, διαπιστευτήρια λογαριασμών και ιδιωτικά κλειδιά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta el estado de la app, la compilación y el repositorio con diagnósticos de red recientes saneados. Se excluyen el contenido de los archivos, los mensajes de commit, las credenciales de cuenta y las claves privadas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta el estado de la app, la compilación y el repositorio con diagnósticos de red recientes sin datos sensibles. Se excluyen el contenido de los archivos, los mensajes de commit, las credenciales de la cuenta y las claves privadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vie sovelluksen, koontiversion ja tietovaraston tila sekä arkaluonteisista tiedoista puhdistettu viimeaikainen verkkodiagnostiikka. Tiedostojen sisältöä, tallennusviestejä, tilien kirjautumistietoja ja yksityisiä avaimia ei sisällytetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporter l’état de l’app, de la build et du dépôt avec des diagnostics réseau récents anonymisés. Le contenu des fichiers, les messages de commit, les identifiants de compte et les clés privées sont exclus."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporter l’état de l’app, de la build et du dépôt avec des diagnostics réseau récents anonymisés. Le contenu des fichiers, les messages de commit, les identifiants de compte et les clés privées sont exclus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייצוא מצב היישום, הבנייה והמאגר עם נתוני אבחון רשת אחרונים שמהם הוסרו פרטים רגישים. תוכן קבצים, הודעות קומיט, אישורי חשבון ומפתחות פרטיים אינם נכללים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संवेदनशील जानकारी हटाए गए हाल के नेटवर्क निदान के साथ ऐप/बिल्ड और रिपॉज़िटरी की स्थिति निर्यात करें। फ़ाइलों की सामग्री, कमिट संदेश, खाते के क्रेडेंशियल और निजी कुंजियाँ शामिल नहीं होतीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvezi stanje aplikacije/međuverzije i repozitorija s pročišćenom nedavnom mrežnom dijagnostikom. Sadržaj datoteka, poruke predaja, vjerodajnice računa i privatni ključevi su isključeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazás és a build adatait, valamint a tároló állapotát exportálja a közelmúlt bizalmas adatoktól megtisztított hálózati diagnosztikájával. A fájltartalmak, véglegesítési üzenetek, fiókhitelesítő adatok és privát kulcsok kimaradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspor status aplikasi/build dan repositori beserta diagnostik jaringan terbaru yang telah dibersihkan dari informasi sensitif. Isi file, pesan komit, kredensial akun, dan kunci pribadi dikecualikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta lo stato dell'app/build e del repository con la diagnostica di rete recente ripulita. Contenuti dei file, messaggi di commit, credenziali degli account e chiavi private sono esclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App/ビルドとリポジトリの状態を、サニタイズされた最近のネットワーク診断情報とともに書き出します。ファイルの内容、コミットメッセージ、アカウントの資格情報、秘密鍵は除外されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱/빌드 및 저장소 상태를 정리된 최근 네트워크 진단 정보와 함께 내보냅니다. 파일 내용, 커밋 메시지, 계정 자격 증명 및 개인 키는 제외됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksport keadaan aplikasi/binaan dan repositori berserta diagnostik rangkaian terkini yang telah dibersihkan daripada maklumat sensitif. Kandungan fail, mesej komit, bukti kelayakan akaun dan kunci peribadi dikecualikan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporteer de app-/build- en repositorystatus met geanonimiseerde recente netwerkdiagnostiek. Bestandsinhoud, commitberichten, accountgegevens en privésleutels worden niet meegenomen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporter tilstanden til appen, programbygget og kodelageret sammen med nylig nettverksdiagnostikk der sensitive opplysninger er fjernet. Filinnhold, innsjekkingsmeldinger, påloggingsopplysninger og private nøkler utelates."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportuj stan aplikacji/kompilacji i repozytorium wraz z oczyszczoną najnowszą diagnostyką sieci. Zawartość plików, komunikaty commitów, dane uwierzytelniające kont i klucze prywatne są wykluczone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta o estado do app/build e do repositório com diagnósticos de rede recentes sanitizados. Conteúdo de arquivos, mensagens de commit, credenciais de conta e chaves privadas são excluídos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta o estado da aplicação/compilação e do repositório com diagnósticos de rede recentes expurgados de dados sensíveis. O conteúdo dos ficheiros, as mensagens de commit, as credenciais da conta e as chaves privadas são omitidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportă starea aplicației/compilării și a depozitului, cu date recente de diagnosticare a rețelei din care s-au eliminat informațiile sensibile. Conținutul fișierelor, mesajele de commit, acreditările conturilor și cheile private sunt excluse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспорт состояния приложения, сборки и репозитория вместе с очищенной недавней сетевой диагностикой. Содержимое файлов, сообщения коммитов, учётные данные и закрытые ключи исключаются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportuje stav aplikácie, zostavy a repozitára s nedávnou sieťovou diagnostikou zbavenou citlivých údajov. Obsah súborov, správy commitov, prihlasovacie údaje účtov a súkromné kľúče sa nezahrnú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvozi stanje aplikacije/gradnje in repozitorija z očiščeno nedavno omrežno diagnostiko. Vsebina datotek, sporočila potrditev, poverilnice računov in zasebni ključi so izključeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportera app- och bygginformation samt arkivets tillstånd med rensad diagnostik från den senaste nätverksaktiviteten. Filinnehåll, incheckningsmeddelanden, inloggningsuppgifter och privata nycklar tas inte med."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งออกสถานะแอป/บิลด์และคลัง พร้อมข้อมูลวินิจฉัยเครือข่ายล่าสุดที่ลบข้อมูลอ่อนไหวแล้ว โดยไม่รวมเนื้อหาไฟล์ ข้อความคอมมิต ข้อมูลรับรองบัญชี และกุญแจส่วนตัว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama/derleme ve depo durumunu, hassas bilgileri temizlenmiş son ağ tanılamasıyla dışa aktarın. Dosya içerikleri, işleme mesajları, hesap kimlik bilgileri ve özel anahtarlar dahil edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Експортуйте стан програми/збірки й репозиторію разом з очищеною свіжою мережевою діагностикою. Вміст файлів, повідомлення комітів, облікові дані та приватні ключі виключено."
          }
        },
        "vi" : {
          "stringUnit" : {
