        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".gitignore में संस्करण नियंत्रण के तहत रखा जाता है और रिपॉज़िटरी क्लोन करने वाले सभी लोगों से साझा होता है।"
