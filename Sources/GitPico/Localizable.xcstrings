    "Creates development from production only if missing. Saves repository-local branch/prefix configuration, without changing global settings or checking out a different branch." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ فرع التطوير من الإنتاج فقط إذا كان مفقودًا. يحفظ إعدادات الفروع/البادئات المحلية للمستودع دون تغيير الإعدادات العامة أو استخراج فرع مختلف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea la branca de desenvolupament a partir de la de producció només si falta. Desa la configuració de branques/prefixos local del repositori, sense canviar la configuració global ni extreure una altra branca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvoří vývojovou větev z produkční, pouze pokud chybí. Uloží konfiguraci větví a předpon pro tento repozitář, aniž by změnil globální nastavení nebo vyzvedl jinou větev."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opretter kun udviklingsgrenen ud fra produktionsgrenen, hvis den mangler. Gemmer kodelagerets lokale konfiguration af grene og præfikser uden at ændre globale indstillinger eller tjekke en anden gren ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt Development aus Production nur, falls es fehlt. Sichert die Repository-lokale Branch-/Präfix-Konfiguration, ohne globale Einstellungen zu ändern oder einen anderen Branch auszuchecken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργεί τον κλάδο ανάπτυξης από τον κλάδο παραγωγής μόνο αν λείπει. Αποθηκεύει τη διαμόρφωση κλάδων/προθεμάτων μόνο στο αποθετήριο, χωρίς αλλαγή καθολικών ρυθμίσεων ή εξαγωγή διαφορετικού κλάδου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea development desde producción solo si falta. Guarda la configuración de ramas/prefijos local del repositorio, sin cambiar los ajustes globales ni hacer checkout de otra rama."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
