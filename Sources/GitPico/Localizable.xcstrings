    "Do not rebase commits others already depend on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُعد تأسيس إيداعات يعتمد عليها آخرون بالفعل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No rebasis commits dels quals ja depenguin altres persones."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepřeskládávejte commity, na kterých již závisejí ostatní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombaser ikke commits, som andre allerede er afhængige af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe keinen Rebase von Commits aus, auf denen andere bereits aufbauen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μην αναθεμελιώνετε υποβολές στις οποίες βασίζονται ήδη άλλοι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hagas rebase de commits de los que otros ya dependen."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hagas rebase de commits de los que otros ya dependen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älä uudelleenpohjusta tallennuksia, joista muut jo ovat riippuvaisia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne rebasez pas les commits dont d’autres personnes dépendent déjà."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne rebasez pas les commits dont d’autres personnes dépendent déjà."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין לשנות בסיס לקומיטים שאחרים כבר מסתמכים עליהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उन कमिट को रीबेस न करें जिन पर दूसरे पहले से निर्भर हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemojte preslagivati predaje o kojima drugi već ovise."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne alapozzon újra olyan véglegesítéseket, amelyekre mások már építenek."
          }
        },
