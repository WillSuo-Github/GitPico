    "SSH_AUTH_SOCK is not set for this app. SSH may still use keys configured in your system SSH setup." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُضبط SSH_AUTH_SOCK لهذا التطبيق. قد يظل SSH يستخدم المفاتيح المضبوطة في إعدادات SSH للنظام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH_AUTH_SOCK no està definit per a aquesta app. SSH encara pot fer servir claus de la configuració SSH del sistema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH_AUTH_SOCK není pro tuto aplikaci nastavena. SSH může přesto používat klíče z konfigurace SSH v systému."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH_AUTH_SOCK er ikke angivet for denne app. SSH kan stadig bruge nøgler, der er konfigureret i systemets SSH-opsætning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH_AUTH_SOCK ist für diese App nicht gesetzt. SSH kann dennoch Schlüssel aus deiner System-SSH-Konfiguration verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το SSH_AUTH_SOCK δεν έχει οριστεί για αυτή την εφαρμογή. Το SSH μπορεί ακόμη να χρησιμοποιεί κλειδιά διαμορφωμένα στις ρυθμίσεις SSH του συστήματός σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH_AUTH_SOCK no está definido para esta app. SSH puede seguir usando las claves configuradas en el SSH del sistema."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH_AUTH_SOCK no está definido para esta app. SSH puede seguir usando las claves configuradas en el SSH del sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH_AUTH_SOCK ei ole asetettu tälle apille. SSH voi silti käyttää järjestelmän SSH-asetuksissa määritettyjä avaimia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH_AUTH_SOCK n’est pas défini pour cette app. SSH peut néanmoins utiliser les clés configurées dans la configuration SSH de votre système."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH_AUTH_SOCK n’est pas défini pour cette app. SSH peut néanmoins utiliser les clés configurées dans la configuration SSH de votre système."
          }
