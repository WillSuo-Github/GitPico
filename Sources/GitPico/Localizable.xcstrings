    "Worktrees let you check out several branches side by side." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتيح أشجار العمل استخراج عدة فروع جنبًا إلى جنب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els arbres de treball permeten extreure diverses branques en paral·lel."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracovní stromy umožňují mít aktivních několik větví vedle sebe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med arbejdstræer kan du have flere grene tjekket ud side om side."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Worktrees kannst du mehrere Branches nebeneinander auschecken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δέντρα εργασίας σάς επιτρέπουν να κάνετε εξαγωγή πολλών κλάδων σε παράθεση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los worktrees te permiten hacer checkout de varias ramas en paralelo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los worktrees te permiten hacer checkout de varias ramas en paralelo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työpuiden avulla voit ottaa käyttöön useita haaroja rinnakkain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les arbres de travail vous permettent d’extraire plusieurs branches côte à côte."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les arbres de travail vous permettent d’extraire plusieurs branches côte à côte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עצי עבודה מאפשרים לשלוף כמה ענפים לעבודה זה לצד זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्कट्री से आप कई ब्रांच एक साथ चेकआउट कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radna stabla omogućuju istodobno preuzimanje nekoliko grana u zasebne radne kopije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A munkafákkal egyszerre több ágat is kivehet egymás mellé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohon kerja memungkinkan Anda melakukan checkout beberapa cabang secara berdampingan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I worktree consentono di estrarre più rami affiancati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークツリーを使うと、複数のブランチを並行してチェックアウトできます。"
