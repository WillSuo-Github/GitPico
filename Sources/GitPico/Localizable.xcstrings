    "If application fails or conflicts occur, the stash is retained. Resolve and stage conflicts before committing the restored work." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحتفظ بالمخبأ إذا فشل التطبيق أو حدثت تعارضات. حل التعارضات وجهّزها قبل إيداع العمل المستعاد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l'aplicació falla o hi ha conflictes, es conserva la reserva. Resol i prepara els conflictes abans de fer commit del treball restaurat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud použití selže nebo nastanou konflikty, odložené změny zůstanou zachovány. Před vytvořením commitu obnovené práce konflikty vyřešte a připravte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis anvendelsen mislykkes, eller der opstår konflikter, bevares de gemte ændringer. Løs og klargør konflikterne, før du opretter et commit med det gendannede arbejde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlägt das Anwenden fehl oder treten Konflikte auf, bleibt der Stash erhalten. Löse und stage Konflikte, bevor du die wiederhergestellte Arbeit committest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν η εφαρμογή αποτύχει ή προκύψουν διενέξεις, η προσωρινή αποθήκευση διατηρείται. Επιλύστε και προετοιμάστε τις διενέξεις πριν υποβάλετε την επαναφερμένη εργασία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la aplicación falla o hay conflictos, se conserva el stash. Resuelve y prepara los conflictos antes de hacer commit del trabajo restaurado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la aplicación falla o hay conflictos, se conserva el stash. Resuelve y prepara los conflictos antes de hacer commit del trabajo restaurado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos käyttöönotto epäonnistuu tai syntyy ristiriitoja, kätkö säilytetään. Ratkaise ja valmistele ristiriidat ennen palautetun työn tallentamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’application échoue ou si des conflits surviennent, la remise est conservée. Résolvez et indexez les conflits avant de valider le travail restauré."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’application échoue ou si des conflits surviennent, la remise est conservée. Résolvez et indexez les conflits avant de valider le travail restauré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם ההחלה נכשלת או מתרחשות התנגשויות, האחסון הזמני נשמר. יש לפתור התנגשויות ולהכין אותן לקומיט לפני יצירת קומיט מהעבודה ששוחזרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लागू करना विफल होने या टकराव होने पर स्टैश सुरक्षित रहता है। बहाल किए गए काम को कमिट करने से पहले टकराव सुलझाएँ और स्टेज करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako primjena ne uspije ili dođe do sukoba, privremeno spremljene promjene se čuvaju. Riješite i pripremite sukobe prije predaje obnovljenog rada."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha az alkalmazás sikertelen vagy ütközések lépnek fel, a félretétel megmarad. A visszaállított munka véglegesítése előtt oldja fel és készítse elő az ütközéseket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika penerapan gagal atau terjadi konflik, simpanan dipertahankan. Selesaikan dan siapkan konflik sebelum membuat komit dari pekerjaan yang dipulihkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l'applicazione non riesce o si verificano conflitti, lo stash viene mantenuto. Risolvi e aggiungi allo stage i conflitti prima di eseguire il commit del lavoro ripristinato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適用に失敗したりコンフリクトが発生したりした場合、スタッシュは保持されます。復元した作業をコミットする前に、コンフリクトを解決してステージしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적용이 실패하거나 충돌이 발생하면 스태시는 유지됩니다. 복원된 작업을 커밋하기 전에 충돌을 해결하고 스테이징하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika penerapan gagal atau konflik berlaku, simpanan dikekalkan. Selesaikan dan pentaskan konflik sebelum mengkomit kerja yang dipulihkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het toepassen mislukt of er conflicten ontstaan, blijft de stash behouden. Los conflicten op en stage ze voordat je het herstelde werk commit."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis endringene ikke kan brukes eller det oppstår konflikter, beholdes den midlertidige lagringen. Løs og klargjør konfliktene før du sjekker inn det gjenopprettede arbeidet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli zastosowanie się nie powiedzie lub wystąpią konflikty, schowek zostanie zachowany. Przed zatwierdzeniem przywróconej pracy rozwiąż konflikty i dodaj je do indeksu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a aplicação falhar ou ocorrerem conflitos, o stash é mantido. Resolva e prepare os conflitos antes de fazer commit do trabalho restaurado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a aplicação falhar ou ocorrerem conflitos, o stash é mantido. Resolva e prepare os conflitos antes de fazer commit do trabalho restaurado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă aplicarea eșuează sau apar conflicte, stocarea temporară este păstrată. Rezolvați și pregătiți conflictele înainte de a crea un commit cu lucrul restaurat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если применение не удалось или возникли конфликты, стеш сохраняется. Разрешите конфликты и добавьте их в индекс перед коммитом восстановленной работы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak použitie zlyhá alebo nastanú konflikty, odložené zmeny sa zachovajú. Pred vytvorením commitu z obnovenej práce vyriešte konflikty a pripravte ich."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če uporaba ne uspe ali pride do sporov, je zaloga ohranjena. Pred potrditvijo obnovljenega dela razrešite in pripravite spore."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om ändringarna inte kan tillämpas eller om konflikter uppstår behålls den tillfälliga lagringen. Lös och mellanlagra konflikterna innan du checkar in det återställda arbetet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากนำไปใช้ไม่สำเร็จหรือเกิดข้อขัดแย้ง รายการพักจะยังคงอยู่ แก้ไขและจัดเตรียมข้อขัดแย้งก่อนคอมมิตงานที่กู้คืน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama başarısız olursa veya çakışma oluşursa zula korunur. Geri yüklenen çalışmayı işlemeden önce çakışmaları çözümleyip hazırlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо застосування не вдасться або виникнуть конфлікти, сховок збережеться. Розвʼяжіть і проіндексуйте конфлікти, перш ніж робити коміт відновленої роботи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu áp dụng thất bại hoặc có xung đột, bản cất tạm được giữ lại. Giải quyết và đưa xung đột vào vùng chờ trước khi commit công việc đã khôi phục."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若套用失敗或發生衝突，儲藏會保留。提交回復的工作前，請先解決並暫存衝突。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果应用失败或出现冲突，储藏会被保留。提交恢复的工作前，请解决并暂存冲突。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若套用失敗或發生衝突，儲藏會保留。提交回復的工作前，請先解決並暫存衝突。"
          }
        }
      }
    },
