    "Up to 1000 server locks are shown. Reload after an interrupted request before retrying; the server may already have applied it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعرض حتى 1000 قفل خادم. أعد التحميل بعد طلب منقطع قبل إعادة المحاولة؛ ربما طبّقه الخادم بالفعل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es mostren fins a 1.000 bloquejos del servidor. Torna a carregar després d'una sol·licitud interrompuda abans de reintentar-la; el servidor ja la pot haver aplicat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje se nejvýše 1000 zámků serveru. Po přerušeném požadavku před dalším pokusem znovu načtěte seznam; server jej již mohl provést."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der vises op til 1000 serverlåse. Genindlæs efter en afbrudt anmodning, før du prøver igen. Serveren kan allerede have udført den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden bis zu 1000 Serversperren angezeigt. Lade nach einer unterbrochenen Anfrage neu, bevor du es erneut versuchst; der Server hat sie möglicherweise bereits angewendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζονται έως 1000 κλειδώματα διακομιστή. Επαναφορτώστε μετά από διακοπέν αίτημα πριν δοκιμάσετε ξανά· ο διακομιστής μπορεί να το έχει ήδη εφαρμόσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestran hasta 1000 bloqueos del servidor. Tras una solicitud interrumpida, vuelve a cargar antes de reintentar; puede que el servidor ya la haya aplicado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestran hasta 1000 bloqueos del servidor. Tras una solicitud interrumpida, vuelve a cargar antes de reintentar; puede que el servidor ya la haya aplicado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytetään enintään 1000 palvelinlukitusta. Lataa tiedot uudelleen keskeytyneen pyynnön jälkeen ennen uutta yritystä; palvelin on saattanut jo toteuttaa pyynnön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’à 1 000 verrous du serveur sont affichés. Rechargez après une requête interrompue avant de réessayer ; le serveur l’a peut-être déjà appliquée."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’à 1 000 verrous du serveur sont affichés. Rechargez après une requête interrompue avant de réessayer; le serveur l’a peut-être déjà appliquée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוצגות עד 1000 נעילות שרת. לאחר בקשה שנקטעה יש לטעון מחדש לפני ניסיון חוזר; ייתכן שהשרת כבר ביצע אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अधिकतम 1000 सर्वर लॉक दिखाए जाते हैं। अनुरोध बीच में रुकने पर दोबारा कोशिश करने से पहले फिर लोड करें; सर्वर शायद उसे पहले ही लागू कर चुका हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje se do 1000 zaključavanja poslužitelja. Nakon prekinutog zahtjeva ponovno učitajte prije ponovnog pokušaja; poslužitelj ga je možda već primijenio."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legfeljebb 1000 kiszolgálói zárolás jelenik meg. Megszakadt kérés után az újrapróbálkozás előtt töltse újra a listát; a kiszolgáló már végrehajthatta a kérést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hingga 1000 kunci server ditampilkan. Muat ulang setelah permintaan terputus sebelum mencoba lagi; server mungkin sudah menerapkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono mostrati fino a 1000 blocchi del server. Dopo una richiesta interrotta, ricarica prima di riprovare; il server potrebbe averla già applicata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大 1,000 件のサーバのロックが表示されます。中断されたリクエストの後は、再試行する前に再読み込みしてください。サーバですでに適用されている可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 1000개의 서버 잠금이 표시됩니다. 요청이 중단된 경우 다시 시도하기 전에 다시 불러오십시오. 서버에서 이미 적용했을 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehingga 1000 kunci pelayan dipaparkan. Muat semula selepas permintaan terganggu sebelum mencuba lagi; pelayan mungkin sudah melaksanakannya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er worden maximaal 1000 serververgrendelingen weergegeven. Laad na een onderbroken verzoek opnieuw voordat je het nogmaals probeert; de server heeft het mogelijk al toegepast."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opptil 1000 serverlåser vises. Last inn på nytt etter en avbrutt forespørsel før du prøver igjen. Serveren kan allerede ha utført den."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlanych jest do 1000 blokad serwera. Po przerwanym żądaniu wczytaj ponownie przed ponowieniem; serwer mógł je już zastosować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São exibidos até 1000 bloqueios do servidor. Recarregue após uma solicitação interrompida antes de tentar novamente; o servidor pode já tê-la aplicado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São apresentados até 1000 bloqueios do servidor. Recarregue após um pedido interrompido antes de tentar novamente; o servidor pode já o ter aplicado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunt afișate până la 1000 de blocări pe server. După o solicitare întreruptă, reîncărcați înainte de a reîncerca; serverul poate să o fi aplicat deja."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показано до 1000 блокировок на сервере. После прерванного запроса перезагрузите список перед повтором; сервер мог уже выполнить запрос."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje sa najviac 1000 zámkov servera. Po prerušenej požiadavke pred ďalším pokusom znova načítajte zobrazenie; server ju už mohol vykonať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazanih je do 1000 strežniških zaklepov. Po prekinjeni zahtevi pred ponovnim poskusom znova naložite; strežnik jo je morda že izvedel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upp till 1000 serverlås visas. Läs in dem igen efter en avbruten begäran innan du försöker på nytt. Servern kan redan ha utfört åtgärden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงการล็อกบนเซิร์ฟเวอร์สูงสุด 1000 รายการ หากคำขอถูกขัดจังหวะ ให้โหลดใหม่ก่อนลองอีกครั้ง เพราะเซิร์ฟเวอร์อาจดำเนินการแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fazla 1000 sunucu kilidi gösterilir. Kesintiye uğrayan istekten sonra yeniden denemeden önce yeniden yükleyin; sunucu isteği zaten uygulamış olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показано до 1000 блокувань на сервері. Після перерваного запиту перезавантажте перед повторною спробою; сервер уже міг його застосувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị tối đa 1000 khóa máy chủ. Tải lại sau yêu cầu bị gián đoạn trước khi thử lại; máy chủ có thể đã áp dụng yêu cầu."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多顯示 1000 個伺服器鎖定。請求中斷後，重試前請先重新載入；伺服器可能已經套用。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多显示 1000 个服务器锁。请求中断后请先重新载入再重试；服务器可能已应用该请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多顯示 1000 個伺服器鎖定。請求中斷後，重試前請先重新載入；伺服器可能已經套用。"
          }
        }
      }
    },
