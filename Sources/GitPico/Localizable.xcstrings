        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsi tästä näkymästä, tiedostoista, haaroista, tallennuksista ja toiminnoista. Kirjoita > etsiäksesi toimintoja. ⌘F avaa haun; ⌘⇧A avaa toiminnot."
          }
        },
        "fr" : {
          "stringUnit" : {
