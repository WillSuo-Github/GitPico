    "Pull checks out the current HEAD. Use Fetch to cache objects from another revision." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخرج السحب HEAD الحالي. استخدم الجلب لتخزين كائنات مراجعة أخرى مؤقتًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La baixada extreu el HEAD actual. Fes servir Recupera per desar a la memòria cau objectes d'una altra revisió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stažení načte do pracovní kopie aktuální HEAD. Pro uložení objektů jiné revize do mezipaměti použijte Načíst."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hentning tjekker det aktuelle HEAD ud. Brug Hent til at gemme objekter fra en anden revision i cachen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull checkt den aktuellen HEAD aus. Verwende Fetch, um Objekte einer anderen Revision zwischenzuspeichern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η άντληση κάνει εξαγωγή του τρέχοντος HEAD. Χρησιμοποιήστε τη Λήψη για αποθήκευση αντικειμένων άλλης αναθεώρησης στην cache."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull hace checkout del HEAD actual. Usa Fetch para guardar en caché objetos de otra revisión."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull hace checkout del HEAD actual. Usa Fetch para guardar en caché objetos de otra revisión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vetäminen ottaa nykyisen HEAD-version käyttöön. Nouda tallentaa toisen version objektit välimuistiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirer extrait le HEAD actuel. Utilisez Récupérer pour mettre en cache les objets d’une autre révision."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirer extrait le HEAD actuel. Utilisez Récupérer pour mettre en cache les objets d’une autre révision."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משיכה שולפת לעבודה את HEAD הנוכחי. יש להשתמש באחזור כדי לשמור במטמון אובייקטים מגרסה אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुल मौजूदा HEAD को चेकआउट करता है। किसी दूसरे रिविज़न के ऑब्जेक्ट कैश करने के लिए फ़ेच करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povlačenje preuzima trenutačni HEAD u radnu kopiju. Upotrijebite Dohvati za spremanje objekata druge revizije u predmemoriju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Lehúzás az aktuális HEAD állapotát veszi ki. Másik változat objektumainak gyorsítótárazásához használja a Lekérés műveletet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarik melakukan checkout pada HEAD saat ini. Gunakan Ambil untuk menyimpan objek dari revisi lain ke cache."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pull estrae l'HEAD attuale. Usa Fetch per memorizzare in cache gli oggetti di un'altra revisione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プルは現在の HEAD をチェックアウトします。別のリビジョンのオブジェクトをキャッシュするにはフェッチを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "풀은 현재 HEAD를 체크아웃합니다. 다른 리비전의 객체를 캐시하려면 페치를 사용하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarik mengeluarkan HEAD semasa. Gunakan Ambil untuk menyimpan objek daripada semakan lain dalam cache."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull checkt de huidige HEAD uit. Gebruik 'Fetch' om objecten uit een andere revisie in de cache op te slaan."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hent og integrer sjekker ut gjeldende HEAD. Bruk Hent for å mellomlagre objekter fra en annen revisjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ściąganie wypakowuje bieżący HEAD. Użyj Pobierz, aby zapisać w pamięci podręcznej obiekty z innej rewizji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pull faz checkout do HEAD atual. Use Fetch para armazenar em cache objetos de outra revisão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pull faz checkout do HEAD atual. Use Fetch para armazenar em cache objetos de outra revisão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preluarea cu extragere extrage HEAD curent. Folosiți Preia pentru a pune în cache obiecte din altă revizie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтягивание извлекает текущий HEAD. Используйте получение, чтобы кэшировать объекты из другой ревизии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiahnuť prevezme súbory aktuálneho HEAD. Pomocou Načítať môžete uložiť objekty z inej revízie do vyrovnávacej pamäte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevzem prevzame trenutni HEAD. Za predpomnjenje objektov iz druge revizije uporabite Pridobi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hämta och integrera checkar ut aktuellt HEAD. Använd Hämta för att cachelagra objekt från en annan revision."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดึงและรวมจะเช็กเอาต์ HEAD ปัจจุบัน ใช้ดึงข้อมูลเพื่อแคชออบเจ็กต์จากรีวิชันอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çek, geçerli HEAD'i kullanıma alır. Başka bir revizyondaki nesneleri önbelleğe almak için Getir'i kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підтягування витягує поточний HEAD. Щоб кешувати обʼєкти з іншої ревізії, скористайтеся отриманням."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo checkout HEAD hiện tại. Dùng Tìm nạp để lưu đệm đối tượng từ phiên bản khác."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉取會取出目前的 HEAD。使用「抓取」來快取其他修訂版本的物件。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉取会检出当前 HEAD。使用“获取”以缓存其他修订版本的对象。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉取會取出目前的 HEAD。使用「抓取」來快取其他修訂版本的物件。"
          }
        }
      }
    },
    "Pull completed, but its Undo record could not be saved. Inspect History or Reflog before another operation. %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتمل السحب، لكن تعذر حفظ سجل التراجع عنه. افحص السجل أو سجل المراجع قبل أي عملية أخرى. %@"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La baixada ha acabat, però no se n'ha pogut desar el registre per desfer-la. Inspecciona l'historial o el registre de referències abans d'una altra operació. %@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stahování bylo dokončeno, ale nepodařilo se uložit záznam pro vrácení zpět. Před další operací zkontrolujte Historii nebo Reflog. %@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ændringerne blev hentet og integreret, men fortrydelsesposten kunne ikke gemmes. Gennemgå historikken eller refloggen før næste handling. %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull abgeschlossen, aber der Eintrag zum Rückgängigmachen konnte nicht gesichert werden. Prüfe Verlauf oder Reflog vor einem weiteren Vorgang. %@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η άντληση ολοκληρώθηκε, αλλά η εγγραφή Αναίρεσής της δεν αποθηκεύτηκε. Ελέγξτε το Ιστορικό ή το Αρχείο αναφορών πριν από άλλη λειτουργία. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull completado, pero no se pudo guardar su registro de Deshacer. Revisa Historial o Reflog antes de otra operación. %@"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull completado, pero no se pudo guardar su registro de Deshacer. Revisa Historial o Reflog antes de otra operación. %@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vetäminen valmistui, mutta sen kumoamistietuetta ei voitu tallentaa. Tarkista historia tai viiteloki ennen seuraavaa toimintoa. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
