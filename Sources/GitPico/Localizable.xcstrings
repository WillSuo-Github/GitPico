    "Too many commit drafts to save. Keep this tab open and review draft storage." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسودات الإيداع كثيرة جدًا للحفظ. أبقِ علامة التبويب هذه مفتوحة وراجع تخزين المسودات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi ha massa esborranys de commits per desar. Mantén aquesta pestanya oberta i revisa l'emmagatzematge d'esborranys."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příliš mnoho konceptů commitů k uložení. Nechte tento panel otevřený a zkontrolujte úložiště konceptů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er for mange commitkladder til, at de kan gemmes. Hold denne fane åben, og gennemgå lagringen af kladder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Commit-Entwürfe zum Sichern. Lass diesen Tab geöffnet und prüfe den Entwurfsspeicher."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάρα πολλά προσχέδια υποβολών για αποθήκευση. Κρατήστε ανοιχτή αυτή την καρτέλα και ελέγξτε τον χώρο αποθήκευσης προσχεδίων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados borradores de commit para guardar. Mantén abierta esta pestaña y revisa el almacenamiento de borradores."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados borradores de commit para guardar. Mantén abierta esta pestaña y revisa el almacenamiento de borradores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennusluonnoksia on liikaa tallennettavaksi. Pidä tämä välilehti auki ja tarkista luonnosten tallennustila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de brouillons de commit à enregistrer. Gardez cet onglet ouvert et vérifiez le stockage des brouillons."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de brouillons de commit à enregistrer. Gardez cet onglet ouvert et vérifiez le stockage des brouillons."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש יותר מדי טיוטות קומיט לשמירה. יש להשאיר כרטיסייה זו פתוחה ולבדוק את אחסון הטיוטות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजने के लिए बहुत अधिक कमिट ड्राफ़्ट हैं। यह टैब खुला रखें और ड्राफ़्ट संग्रहण की समीक्षा करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previše skica predaja za spremanje. Ostavite ovu karticu otvorenu i provjerite pohranu skica."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túl sok véglegesítési piszkozatot kell menteni. Tartsa nyitva ezt a lapot, és ellenőrizze a piszkozatok tárhelyét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak draf komit untuk disimpan. Biarkan tab ini terbuka dan tinjau penyimpanan draf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppe bozze di commit da salvare. Tieni aperto questo pannello e controlla l'archivio delle bozze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存するコミットの下書きが多すぎます。このタブを開いたまま、下書きの保存場所を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장할 커밋 초안이 너무 많습니다. 이 탭을 열어 두고 초안 저장 공간을 검토하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak draf komit untuk disimpan. Biarkan tab ini terbuka dan semak storan draf."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te veel commitconcepten om op te slaan. Houd dit tabblad open en controleer de conceptopslag."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er for mange innsjekkingsutkast å lagre. Hold denne fanen åpen og se gjennom utkastlagringen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za dużo wersji roboczych commitów do zapisania. Pozostaw tę kartę otwartą i przejrzyj magazyn wersji roboczych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rascunhos de commit demais para salvar. Mantenha esta aba aberta e revise o armazenamento de rascunhos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados rascunhos de commit para guardar. Mantenha este separador aberto e reveja o armazenamento de rascunhos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prea multe ciorne de commit de salvat. Păstrați această filă deschisă și examinați spațiul de stocare a ciornelor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком много черновиков коммитов для сохранения. Оставьте эту вкладку открытой и проверьте хранилище черновиков."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Príliš veľa konceptov správ commitov na uloženie. Nechajte tento tab otvorený a skontrolujte úložisko konceptov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preveč osnutkov potrditev za shranjevanje. Pustite ta zavihek odprt in preglejte shrambo osnutkov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns för många incheckningsutkast att spara. Låt den här fliken vara öppen och se över lagringen av utkast."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีฉบับร่างคอมมิตมากเกินกว่าจะบันทึกได้ เปิดแท็บนี้ไว้และตรวจสอบพื้นที่จัดเก็บฉบับร่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedilecek çok fazla işleme taslağı var. Bu sekmeyi açık tutup taslak depolama alanını inceleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забагато чернеток комітів для збереження. Не закривайте цю вкладку й перевірте сховище чернеток."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá nhiều bản nháp commit để lưu. Giữ tab này mở và xem xét vùng lưu trữ bản nháp."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
