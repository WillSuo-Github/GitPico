        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nПрогрес Git Flow збережено. Розвʼяжіть поточну операцію, а потім скористайтеся «Продовжити Git Flow»; тематичну гілку й завершену історію збережено."
          }
