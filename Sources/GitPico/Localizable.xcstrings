    "GitPico uses system SSH host verification and your SSH agent. Only public keys and fingerprints are displayed here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم GitPico التحقق من مضيف SSH الخاص بالنظام ووكيل SSH لديك. تُعرض هنا المفاتيح العامة والبصمات فقط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitPico fa servir la verificació d'amfitrions SSH del sistema i el teu agent SSH. Aquí només es mostren les claus públiques i les empremtes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitPico používá systémové ověřování hostitelů SSH a vašeho agenta SSH. Zde se zobrazují pouze veřejné klíče a otisky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitPico bruger systemets SSH-værtsverifikation og din SSH-agent. Kun offentlige nøgler og fingeraftryk vises her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitPico verwendet die SSH-Hostprüfung des Systems und deinen SSH-Agent. Hier werden nur öffentliche Schlüssel und Fingerabdrücke angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το GitPico χρησιμοποιεί την επαλήθευση διακομιστών SSH του συστήματος και τον πράκτορα SSH σας. Εδώ εμφανίζονται μόνο δημόσια κλειδιά και αποτυπώματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitPico usa la verificación de hosts SSH del sistema y tu agente SSH. Aquí solo se muestran claves públicas y huellas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
