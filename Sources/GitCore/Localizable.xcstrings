          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der blev fundet flere tidligere hovedstier. Angiv udtrykkeligt den oprindelige sti til hovedkodelageret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
