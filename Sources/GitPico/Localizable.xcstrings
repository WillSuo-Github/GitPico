    "Restores and stages the selected version. Existing local changes are backed up first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستعيد النسخة المحددة ويجهزها. تُنسخ التغييرات المحلية الموجودة احتياطيًا أولًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura i prepara la versió seleccionada. Abans es fa una còpia de seguretat dels canvis locals existents."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnoví a připraví vybranou verzi. Stávající místní změny se nejprve zazálohují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gendanner og klargør den valgte version. Eksisterende lokale ændringer sikkerhedskopieres først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt die ausgewählte Version wieder her und stagt sie. Vorhandene lokale Änderungen werden zuerst gesichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαναφέρει και προετοιμάζει την επιλεγμένη έκδοση. Δημιουργείται πρώτα αντίγραφο ασφαλείας των υπαρχουσών τοπικών αλλαγών."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura y prepara la versión seleccionada. Primero se hace copia de seguridad de los cambios locales existentes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura y prepara la versión seleccionada. Primero se hace respaldo de los cambios locales existentes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palauttaa ja valmistelee valitun version. Nykyisistä paikallisista muutoksista tehdään ensin varmuuskopio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaure et indexe la version sélectionnée. Les modifications locales existantes sont d’abord sauvegardées."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaure et indexe la version sélectionnée. Les modifications locales existantes sont d’abord sauvegardées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משחזר את הגרסה שנבחרה ומכין אותה לקומיט. שינויים מקומיים קיימים מגובים תחילה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुना गया संस्करण बहाल करके स्टेज करता है। मौजूदा स्थानीय बदलावों का पहले बैकअप लिया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnavlja i priprema odabranu verziju. Postojeće lokalne promjene najprije se sigurnosno kopiraju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visszaállítja és előkészíti a kijelölt verziót. A meglévő helyi módosításokról előbb biztonsági mentés készül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memulihkan dan menyiapkan versi terpilih. Perubahan lokal yang ada dicadangkan terlebih dahulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina e aggiunge allo stage la versione selezionata. Le modifiche locali esistenti vengono prima salvate in backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したバージョンを復元してステージします。既存のローカルの変更は先にバックアップされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 버전을 복원하고 스테이징합니다. 기존 로컬 변경 사항은 먼저 백업됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memulihkan dan mementaskan versi terpilih. Perubahan setempat sedia ada disandarkan dahulu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet de geselecteerde versie terug en staget deze. Er wordt eerst een reservekopie van bestaande lokale wijzigingen gemaakt."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenoppretter og klargjør den valgte versjonen. Eksisterende lokale endringer sikkerhetskopieres først."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywraca zaznaczoną wersję i dodaje ją do indeksu. Najpierw tworzona jest kopia zapasowa istniejących lokalnych zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura e prepara a versão selecionada. É feito backup das alterações locais existentes primeiro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura e prepara a versão selecionada. É feita cópia de segurança das alterações locais existentes primeiro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurează și pregătește versiunea selectată. Se creează mai întâi o copie de siguranță a modificărilor locale existente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстанавливает выбранную версию и добавляет её в индекс. Существующие локальные изменения сначала копируются в резервную копию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnoví a pripraví vybranú verziu. Existujúce lokálne zmeny sa najprv zálohujú."
